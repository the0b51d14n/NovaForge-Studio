# Copier ce fichier en .env pour travailler en local.
# En ligne : Vercel → Settings → Environment Variables (mêmes noms).

# Mot de passe de l'administration (/administration). Sans lui, personne ne peut s'y connecter.
SITE_PASSWORD=

# Base Upstash Redis : verrou du site, adresse du siège, offres d'emploi.
# Sur Vercel, Storage → Upstash for Redis les ajoute toutes seules. Vides en local : données en mémoire.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Envoi des formulaires par e-mail avec Resend (https://resend.com). Tant que ces deux variables
# sont vides, les formulaires invitent les visiteurs à écrire directement à l'adresse de contact.
# MAIL_FROM doit utiliser un domaine vérifié dans Resend, ex. : NovaForge Studio <site@novaforge-studio.fr>
RESEND_API_KEY=
MAIL_FROM=
