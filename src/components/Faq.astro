---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq" data-reveal>
  {
    items.map((item, i) => (
      <details class="faq-item" open={i === 0}>
        <summary>
          {item.q}
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <div class="faq-answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
