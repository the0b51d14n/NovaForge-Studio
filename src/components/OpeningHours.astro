---
// Horaires de la semaine en cours : calculés sur les vraies dates, affichés par nom du jour. Un créneau par jour
// sur un axe commun, aujourd'hui mis en avant avec l'état du studio (ouvert / fermé), jours fériés et fermetures
// exceptionnelles signalés. Calculé à l'heure de Paris au moment de la requête.
import { site } from '../data/site';
import { addDays, buildCalendar, dayOn, formatRanges, getStatus, weekday } from '../lib/hours';

const cal = buildCalendar(site.schedule, Astro.locals.settings);
const status = getStatus(cal);

// Axe commun à toutes les journées, avec une heure de marge de part et d'autre
const openSlots = cal.slots.filter((s) => s !== null);
const start = openSlots.length ? Math.floor(Math.min(...openSlots.map((s) => s[0])) / 60) * 60 - 60 : 480;
const end = openSlots.length ? Math.ceil(Math.max(...openSlots.map((s) => s[1])) / 60) * 60 + 60 : 1140;
const pct = (minutes: number) => `${(((minutes - start) / (end - start)) * 100).toFixed(2)}%`;
const nowOnAxis = status.minutes > start && status.minutes < end;

const monday = addDays(status.date, -weekday(status.date));
const days = site.schedule.map((d, i) => {
  const iso = addDays(monday, i);
  const { ranges, reason, partial } = dayOn(iso, cal);
  return {
    name: d.day,
    ranges,
    // Journée entière fermée : le motif remplace la frise (seulement si le studio aurait dû ouvrir ce jour-là)
    closure: cal.slots[i] && !partial ? reason : null,
    // Demi-journée : les plages restantes s'affichent, le motif reste en info-bulle
    partialReason: partial ? reason : null,
    today: iso === status.date,
  };
});
---

<div class="hours">
  <p class:list={['hours-status', { 'is-open': status.open }]}>{status.label}</p>
  <ul class="hours-list">
    {
      days.map(({ name, ranges, closure, partialReason, today }) => (
        <li
          class:list={[
            'hours-day',
            { 'is-closed': ranges.length === 0, 'is-exception': closure, 'is-partial': partialReason, 'is-today': today },
          ]}
          aria-current={today ? 'date' : undefined}
          title={partialReason ?? undefined}
        >
          <span class="hours-name">{name}</span>
          {closure ? (
            <span class="hours-note">{closure}</span>
          ) : (
            <span
              class:list={['hours-track', { 'has-now': today && nowOnAxis }]}
              style={today && nowOnAxis ? `--now: ${pct(status.minutes)}` : undefined}
              aria-hidden="true"
            >
              {ranges.map(([a, b]) => (
                <span class="hours-bar" style={`--from: ${pct(a)}; --to: ${pct(b)}`} />
              ))}
            </span>
          )}
          <span class="hours-time">{ranges.length ? formatRanges(ranges) : 'Fermé'}</span>
        </li>
      ))
    }
  </ul>
</div>
