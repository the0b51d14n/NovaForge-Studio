---
// Horaires de la semaine : un créneau par jour sur un axe commun, aujourd'hui mis en avant
// avec l'état du studio (ouvert / fermé). Calculé à l'heure de Paris au moment de la requête.
import { site } from '../data/site';
import { formatTime, getStatus, toMinutes, type Slot } from '../lib/hours';

const slots: Slot[] = site.schedule.map((d) => (d.hours ? [toMinutes(d.hours[0]), toMinutes(d.hours[1])] : null));
const status = getStatus(slots, site.schedule.map((d) => d.day));

// Axe commun à toutes les journées, avec une heure de marge de part et d'autre
const openSlots = slots.filter((s) => s !== null);
const start = openSlots.length ? Math.floor(Math.min(...openSlots.map((s) => s[0])) / 60) * 60 - 60 : 480;
const end = openSlots.length ? Math.ceil(Math.max(...openSlots.map((s) => s[1])) / 60) * 60 + 60 : 1140;
const pct = (minutes: number) => `${(((minutes - start) / (end - start)) * 100).toFixed(2)}%`;
const nowOnAxis = status.minutes > start && status.minutes < end;

const days = site.schedule.map((d, i) => ({
  name: d.day,
  slot: slots[i],
  today: i === status.day,
}));
---

<div class="hours">
  <p class:list={['hours-status', { 'is-open': status.open }]}>{status.label}</p>
  <ul class="hours-list">
    {
      days.map(({ name, slot, today }) => (
        <li class:list={['hours-day', { 'is-closed': !slot, 'is-today': today }]} aria-current={today ? 'date' : undefined}>
          <span class="hours-name">{name}</span>
          <span
            class:list={['hours-track', { 'has-now': today && nowOnAxis }]}
            style={today && nowOnAxis ? `--now: ${pct(status.minutes)}` : undefined}
            aria-hidden="true"
          >
            {slot && <span class="hours-bar" style={`--from: ${pct(slot[0])}; --to: ${pct(slot[1])}`} />}
          </span>
          <span class="hours-time">{slot ? `${formatTime(slot[0])} – ${formatTime(slot[1])}` : 'Fermé'}</span>
        </li>
      ))
    }
  </ul>
</div>
