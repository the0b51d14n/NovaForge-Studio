---
// Résultats NovaForge SmartQuote d'une estimation (page /devis/<id>) : projet demandé (minimum, recommandé,
// maximum), détail de la complexité, frais externes.
// Aucun calcul ici : tout vient du résultat du moteur (src/lib/smartquote.ts), recalculé côté serveur.
// editable : le client peut retirer des options et recalculer.
import Icon from './Icon.astro';
import { UNIT_LABELS } from '../data/quote-catalog';
import { CRITERIA, CRITERION_LABELS, formatEuros, type Bucket, type SmartLine, type SmartResult } from '../lib/smartquote';

interface Props {
  smart: SmartResult;
  vatRate: number;
  editable: boolean;
  error?: string;
}

const { smart, vatRate, editable, error } = Astro.props;
const ttc = vatRate > 0 ? ' TTC' : '';
const qty = (l: SmartLine) => (l.unit === 'forfait' || l.unit === 'mois' ? '' : `${l.qty} ${UNIT_LABELS[l.unit][l.qty > 1 ? 1 : 0]}`);
// Montants d'un ensemble : ponctuel puis mensuel, jamais additionnés
const amounts = (bucket: Bucket, kind: 'min' | 'recommended' | 'max' = 'recommended') =>
  [
    bucket.oneOff[kind].ttc > 0 && formatEuros(bucket.oneOff[kind].ttc),
    bucket.monthly[kind].ttc > 0 && `${formatEuros(bucket.monthly[kind].ttc)} / mois`,
  ]
    .filter(Boolean)
    .join(' + ') || formatEuros(0);
const priceCell = (l: SmartLine, kind: 'min' | 'recommended' | 'max') =>
  l.status === 'inclus' ? 'Inclus' : l.status === 'a-estimer' ? 'À estimer' : `${formatEuros(l.total![kind])}${l.monthly ? ' / mois' : ''}`;
const criteria = CRITERIA.filter((c) => smart.complexity.levels[c] !== undefined);
const removable = smart.lines.filter((l) => l.id !== smart.base.id);
---

<div class="sq">
  <section class="sq-budget sq-budget--neutre" aria-labelledby="sq-budget-title">
    <h2 class="sq-title" id="sq-budget-title">Votre estimation</h2>
    <p>{smart.explanation}</p>
  </section>

  <section class="sq-block" aria-labelledby="sq-initial">
    <h2 class="sq-title" id="sq-initial">Votre projet</h2>
    <p class="sq-note">
      {smart.family.title} · {smart.base.label}. Prix{ttc} selon la complexité estimée (score {Math.round(smart.complexity.score)} / 100),
      toujours compris entre le minimum et le maximum de nos tarifs.
    </p>
    <div class="quote-table-wrap">
      <table class="quote-table sq-table">
        <thead>
          <tr>
            <th scope="col">Prestation</th>
            <th scope="col">Minimum</th>
            <th scope="col">Recommandé</th>
            <th scope="col">Maximum</th>
          </tr>
        </thead>
        <tbody>
          {smart.lines.map((l) => (
            <tr>
              <td>
                {l.label}
                {qty(l) && ` (${qty(l)})`}
                {l.note && <span class="quote-item-detail">{l.note}</span>}
              </td>
              <td>{priceCell(l, 'min')}</td>
              <td><strong>{priceCell(l, 'recommended')}</strong></td>
              <td>{priceCell(l, 'max')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <dl class="sq-figures">
      <div><dt>Création (une fois)</dt><dd>{formatEuros(smart.initial.oneOff.recommended.ttc)}{ttc}</dd></div>
      {smart.initial.monthly.recommended.ttc > 0 && (
        <div><dt>Abonnement</dt><dd>{formatEuros(smart.initial.monthly.recommended.ttc)} / mois</dd></div>
      )}
      <div><dt>Fourchette</dt><dd>{amounts(smart.initial, 'min')} – {amounts(smart.initial, 'max')}</dd></div>
    </dl>
    {smart.discounts && (
      <p class="sq-note"><Icon name="star" /> {smart.discounts.labels.join(', ')} : {formatEuros(smart.discounts.amount)} HT déduits.</p>
    )}
  </section>

  <details class="sq-block sq-details">
    <summary class="sq-title">Comment ce prix est calculé</summary>
    <p class="sq-note">
      Score de complexité : {smart.complexity.score} / 100. Chaque prix recommandé = minimum + (maximum − minimum) × score
      / 100, arrondi à l'euro.
    </p>
    <table class="quote-table sq-table">
      <thead>
        <tr><th scope="col">Critère</th><th scope="col">Niveau (0 à 4)</th><th scope="col">Poids</th><th scope="col">Points</th></tr>
      </thead>
      <tbody>
        {criteria.map((c) => (
          <tr>
            <td>{CRITERION_LABELS[c]}{smart.complexity.unknown.includes(c) && ' (sans réponse)'}</td>
            <td>{smart.complexity.levels[c]}</td>
            <td>{smart.complexity.weights[c]} %</td>
            <td>{smart.complexity.contributions[c]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>

  <section class="sq-block" aria-labelledby="sq-extra">
    <h2 class="sq-title" id="sq-extra">À savoir</h2>
    <ul class="quote-doc-notes">
      {smart.external.map((e) => <li>Non compris dans nos prix : {e.charAt(0).toLowerCase()}{e.slice(1)}.</li>)}
      {smart.warnings.map((w) => <li>{w}</li>)}
      {vatRate === 0 && <li>TVA non applicable, art. 293 B du CGI.</li>}
      <li>Estimation indicative : le prix ferme est fixé avec vous par un conseiller.</li>
    </ul>
  </section>

  {editable && removable.length > 0 && (
    <form class="sq-block sq-adjust" method="post" aria-labelledby="sq-adjust">
      <input type="hidden" name="action" value="adjust" />
      <h2 class="sq-title" id="sq-adjust">Ajuster et recalculer</h2>
      {error && <p class="field-error" role="alert">{error}</p>}
      <ul class="admin-prices">
        {removable.map((l) => (
          <li class="admin-price">
            <span class="admin-price-text">
              <span class="admin-job-title">{l.label}</span>
            </span>
            <span class="admin-price-input">
              <label class="check">
                <input type="checkbox" name="remove" value={l.id} /> Retirer
              </label>
            </span>
          </li>
        ))}
      </ul>
      <button class="btn btn-primary" type="submit">
        Recalculer <Icon name="arrow" class="btn-arrow" />
      </button>
    </form>
  )}
</div>
