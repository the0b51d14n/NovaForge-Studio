---
import Logo from './Logo.astro';
import { projects } from '../data/content';
import { getSite } from '../lib/store';

const site = getSite(Astro.locals);
const { openings } = Astro.locals;
---

<footer class="site-footer surface-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="NovaForge Studio, retour à l'accueil">
        <Logo variant="stacked" tone="dark" />
      </a>
      <p class="footer-tagline">Forger votre présence <em>numérique</em>.</p>
    </div>

    <nav class="footer-col" aria-label="L'agence">
      <p class="footer-title">L'agence</p>
      <ul>
        <li><a href="/agence">Qui sommes-nous</a></li>
        <li><a href="/services">Services</a></li>
        {projects.length > 0 && <li><a href="/realisations">Réalisations</a></li>}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Nous rejoindre">
      <p class="footer-title">Nous rejoindre</p>
      <ul>
        <li><a href="/carrieres">Carrières {openings.length > 0 && <span class="pill">On recrute</span>}</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-col--contact">
      <p class="footer-title">Nous trouver</p>
      <address>
        <a class="footer-address" href={site.directions} target="_blank" rel="noopener" data-directions-link>{site.address[0]}<br />{site.address[1]}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.phone && <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>}
        <span class="footer-hours">{site.hours}</span>
      </address>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© <span data-year>2026</span> {site.name} · {site.city}</p>
    <p class="footer-legal">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
    </p>
    <div class="footer-aside">
      {
        site.socials.length > 0 && (
          <ul class="footer-socials" aria-label="NovaForge Studio sur les réseaux">
            {site.socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer">
                  {social.label}
                  <span class="sr-only"> (nouvel onglet)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="container footer-signature" aria-hidden="true">
    <p class="footer-giant">NovaForge</p>
  </div>
</footer>
