---
import type { IconName, BenefitIcon } from '../data/content';

interface Props {
  name: IconName | BenefitIcon | 'star' | 'arrow' | 'check' | 'share' | 'pin' | 'clock' | 'briefcase';
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === 'star' ? (
    <svg class:list={['icon', 'icon--star', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M12 0c.6 6.3 2.3 9.5 12 12-9.7 2.5-11.4 5.7-12 12-.6-6.3-2.3-9.5-12-12 9.7-2.5 11.4-5.7 12-12z"
      />
    </svg>
  ) : (
    <svg
      class:list={['icon', className]}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {name === 'window' && (
        <>
          <rect x="2.5" y="4" width="19" height="16" rx="2.5" />
          <path d="M2.5 8.5h19M6 6.25h.01M8.5 6.25h.01M6 12.5h7M6 15.5h4" />
          <rect x="15" y="12" width="3.5" height="4.5" rx="1" />
        </>
      )}
      {name === 'bag' && (
        <>
          <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z" />
          <path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" />
        </>
      )}
      {name === 'pen' && (
        <>
          <path d="M12 19.5l7-7 2.5 2.5-7 7-2.5-2.5z" />
          <path d="M18 13.5l-1.5-7.5L4 3l3 12.5 7.5 1.5" />
          <path d="M4 3l6.5 6.5" />
          <circle cx="11.5" cy="10.5" r="1.8" />
        </>
      )}
      {name === 'code' && (
        <>
          <path d="M8 8l-4.5 4L8 16M16 8l4.5 4L16 16M13.5 5l-3 14" />
        </>
      )}
      {name === 'shield' && (
        <>
          <path d="M12 2.8l7.5 3v5.6c0 4.6-3.1 8.4-7.5 9.8-4.4-1.4-7.5-5.2-7.5-9.8V5.8l7.5-3z" />
          <path d="M8.8 12.2l2.2 2.2 4.4-4.6" />
        </>
      )}
      {name === 'home' && <path d="M3.5 11L12 4l8.5 7M6 9.5V20h12V9.5M10 20v-5.5h4V20" />}
      {name === 'laptop' && (
        <>
          <rect x="4.5" y="5" width="15" height="10.5" rx="1.5" />
          <path d="M2.5 19h19M10 17.2h4" />
        </>
      )}
      {name === 'book' && <path d="M4 5.5A2 2 0 0 1 6 3.5h14v15H6a2 2 0 0 0-2 2v-15zM4 20.5a2 2 0 0 1 2-2h14M9 8h7" />}
      {name === 'food' && <path d="M7 3v8M4.5 3v5a2.5 2.5 0 0 0 5 0V3M7 11v10M17 21V3c-2.2 1.2-3.5 3.7-3.5 7v3H17" />}
      {name === 'train' && (
        <>
          <rect x="6" y="3" width="12" height="13" rx="3" />
          <path d="M6 10h12M9 13h.01M15 13h.01M8.5 16L6.5 20M15.5 16l2 4" />
        </>
      )}
      {name === 'building' && <path d="M4 21V5.5L12 3v18M12 8.5l8 2.5v10M2.5 21h19M7.5 8h1.5M7.5 12h1.5M7.5 16h1.5M15 13h1.5M15 17h1.5" />}
      {name === 'gift' && (
        <>
          <rect x="3.5" y="8" width="17" height="4" rx="1" />
          <path d="M5 12v8.5h14V12M12 8v12.5M12 8C10 4 6.5 4.5 7.5 7c.4 1 2.5 1 4.5 1zM12 8c2-4 5.5-3.5 4.5-1-.4 1-2.5 1-4.5 1z" />
        </>
      )}
      {name === 'growth' && <path d="M3.5 17.5l5.5-5.5 4 4 7.5-8M15 8h5.5v5.5" />}
      {name === 'share' && (
        <>
          <circle cx="18" cy="5.5" r="2.5" />
          <circle cx="6" cy="12" r="2.5" />
          <circle cx="18" cy="18.5" r="2.5" />
          <path d="M8.2 10.8l7.6-4.1M8.2 13.2l7.6 4.1" />
        </>
      )}
      {name === 'pin' && (
        <>
          <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
          <circle cx="12" cy="10" r="2.3" />
        </>
      )}
      {name === 'clock' && (
        <>
          <circle cx="12" cy="12" r="8.5" />
          <path d="M12 7.5V12l3 2" />
        </>
      )}
      {name === 'briefcase' && (
        <>
          <rect x="3" y="7" width="18" height="13" rx="2" />
          <path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3 12.5h18" />
        </>
      )}
      {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
      {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
    </svg>
  )
}
