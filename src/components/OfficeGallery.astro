---
// Galerie des bureaux (n'affiche rien tant que le dossier src/assets/bureaux est vide)
import { Image } from 'astro:assets';
import { galleryPhotos } from '../data/office';

interface Props {
  limit?: number;
  /** Affiche la description de chaque espace sous son titre */
  detailed?: boolean;
}

const { limit, detailed = false } = Astro.props;
const photos = galleryPhotos.slice(0, limit);
---

{
  photos.length > 0 && (
    <div class:list={['gallery', { 'gallery--detailed': detailed }]} data-count={Math.min(photos.length, 5)}>
      {photos.map((photo, i) => (
        <figure class="gallery-item" data-reveal style={`--d:${(i % 4) * 0.06}s`}>
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[480, 800, 1200, 1448]}
            sizes={i === 0 ? '(max-width: 640px) 100vw, 50vw' : '(max-width: 640px) 100vw, 30vw'}
            format="webp"
            quality={78}
            loading={i < 2 ? 'eager' : 'lazy'}
          />
          {photo.title && (
            <figcaption>
              <strong>{photo.title}</strong>
              {detailed && photo.text && <span>{photo.text}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}
