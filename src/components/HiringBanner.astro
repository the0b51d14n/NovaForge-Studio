---
// Bandeau « On recrute » (accueil, agence) : présente l'offre la plus récente, masqué s'il n'y en a aucune
import Icon from './Icon.astro';
import { getSite } from '../lib/store';

const site = getSite(Astro.locals);
const { openings } = Astro.locals;
const offer = openings[0];
---

{
  offer && (
    <section class="section hiring surface-dark" aria-labelledby="hiring-title">
      <div class="container hiring-inner">
        <div data-reveal>
          <p class="kicker">
            <span class="kicker-num">★</span>On recrute
          </p>
          <h2 class="section-title" id="hiring-title">
            Le studio se construit.
            <br />
            <em>L'équipe aussi.</em>
          </h2>
          <p class="hiring-lead">
            Jusqu'ici, le fondateur faisait tout lui-même, comme en freelance. Pour passer d'une activité solo à une
            vraie équipe, le studio recrute : <strong>{offer.title}</strong>, en {offer.contracts.join(' ou ')}.{' '}
            {offer.summary}
          </p>
          <ul class="tag-list">
            <li>{offer.contracts.join(' ou ')}</li>
            <li>{site.city}</li>
            {offer.remote && <li>Télétravail : {offer.remote}</li>}
          </ul>
          <div class="hero-actions hero-actions--flush">
            <a class="btn btn-primary" href={`/carrieres/${offer.slug}`}>
              Découvrir l'offre <Icon name="arrow" class="btn-arrow" />
            </a>
            <a class="btn btn-ghost" href={openings.length > 1 ? '/carrieres#offres' : '/carrieres#vie-au-studio'}>
              {openings.length > 1 ? `Voir les ${openings.length} offres` : 'La vie au studio'}
            </a>
          </div>
        </div>

        <figure class="quote-card" data-reveal style="--d:.12s">
          <Icon name="star" class="quote-star" />
          <blockquote>
            <p>
              « Chez NovaForge Studio, vous ne serez pas simplement exécutant. Vous participerez réellement aux
              décisions et pourrez suivre les projets de A à Z. »
            </p>
          </blockquote>
          <figcaption>Le fondateur</figcaption>
        </figure>
      </div>
    </section>
  )
}
