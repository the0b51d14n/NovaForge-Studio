---
import Icon from './Icon.astro';
import { launch, site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
  email?: string;
}

const {
  title = 'Un projet en tête ?',
  // Avant l'ouverture commerciale : pas de devis présenté comme disponible
  text = launch.commercial
    ? 'Parlez-nous de votre activité : premier rendez-vous et devis gratuits, sans engagement.'
    : 'NovaForge Studio est en préparation : les prestations ouvriront bientôt. Une question sur le projet ? Contactez-nous.',
  href = '/contact',
  label = launch.commercial ? 'Parlons-en' : 'Nous contacter',
  // Adresse affichée seulement quand la messagerie est en service
  email = launch.mailbox ? site.email : undefined,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="container cta-inner" data-reveal>
    <div>
      <h2 class="cta-title" id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-warm" href={href}>{label} <Icon name="arrow" class="btn-arrow" /></a>
      {email && <a class="cta-mail" href={`mailto:${email}`}>{email}</a>}
    </div>
  </div>
</section>
