---
// Polices auto-hébergées : le site fonctionne même sans connexion internet
import '@fontsource-variable/sora';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/800.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DirectionsPicker from '../components/DirectionsPicker.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { LOCK_PATH } from '../lib/access';

interface Props {
  title?: string;
  description?: string;
  /** Page sans en-tête ni pied de page (ex. verrouillage) */
  bare?: boolean;
  noindex?: boolean;
}

const { title, description = site.description, bare = false, noindex = false } = Astro.props;
// Aperçu du site verrouillé (choisi par l'administrateur sur /verrouillage) : un rappel évite de croire le site ouvert
const adminPreview = !bare && Astro.locals.isAdmin && Astro.locals.settings.locked;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — Agence digitale · ${site.area}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#10141c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" href="/favicon-pack/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-pack/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-pack/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-pack/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon-pack/site.webmanifest" />
    <meta property="og:image" content="/favicon-pack/icon-512.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="nf-version" content={Astro.locals.version} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <DirectionsPicker />}
    {
      adminPreview && (
        <form class="admin-preview surface-dark" method="post" action={LOCK_PATH}>
          <Icon name="lock" />
          <span>
            <strong>Aperçu</strong> · site fermé au public
          </span>
          <input type="hidden" name="action" value="preview-off" />
          <button type="submit">Quitter</button>
        </form>
      )
    }
    <script>
      import '../scripts/main.ts';
      import '../scripts/live.ts';
    </script>
  </body>
</html>
