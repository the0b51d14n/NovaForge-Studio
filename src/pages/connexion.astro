---
// Connexion (icône de compte de l'en-tête) : une carte à deux onglets, Client (clients et visiteurs) et Employé.
// Les onglets sont des liens (?espace=client|equipe) : ils marchent sans JavaScript. Chaque formulaire n'accepte
// que les comptes de son espace (vérifié côté serveur).
// Après connexion : retour à la page demandée (?suite=…), sinon le portail de l'équipe pour un employé,
// l'espace client pour un client. Un client dont l'adresse n'est pas confirmée (envoi d'e-mails configuré) n'est
// pas connecté : un nouveau lien de confirmation lui est envoyé.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { ADMIN_PATH, logIn, safeNext } from '../lib/access';
import { authenticate, isStaff, needsConfirmation, resendConfirmation } from '../lib/accounts';

type Space = 'client' | 'equipe';
const next = safeNext(Astro.url.searchParams.get('suite'));
const home = (staff: boolean) => next ?? (staff ? ADMIN_PATH : '/espace');
const { user } = Astro.locals;
if (user && Astro.request.method !== 'POST') return Astro.redirect(home(isStaff(user)));

const errors: Record<Space, string> = { client: '', equipe: '' };
const emails: Record<Space, string> = { client: '', equipe: '' };
// Onglet affiché : celui demandé (?espace=…), sinon Employé si la page demandée est le portail, sinon Client
const asked = Astro.url.searchParams.get('espace');
let active: Space = asked === 'equipe' || asked === 'client' ? asked : next?.startsWith(ADMIN_PATH) ? 'equipe' : 'client';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const space: Space = data.get('space') === 'equipe' ? 'equipe' : 'client';
  active = space;
  emails[space] = String(data.get('email') ?? '').trim().slice(0, 200);
  try {
    const result = await authenticate(emails[space], String(data.get('password') ?? '').slice(0, 200));
    if (result === 'bloque') {
      errors[space] = 'Trop de tentatives sur ce compte : réessayez dans 15 minutes.';
      Astro.response.status = 429;
    } else if (!result) {
      // Petite pause après un échec : ralentit les essais de mots de passe à la chaîne
      await new Promise((resolve) => setTimeout(resolve, 800));
      errors[space] = 'Adresse e-mail ou mot de passe incorrect.';
      Astro.response.status = 401;
    } else if (space === 'equipe' && !isStaff(result)) {
      errors.equipe = 'Ce compte est un compte client : utilisez le formulaire « Client ».';
      Astro.response.status = 403;
    } else if (space === 'client' && isStaff(result)) {
      errors.client = 'Ce compte appartient à l’équipe : utilisez le formulaire « Employé ».';
      Astro.response.status = 403;
    } else if (needsConfirmation(result)) {
      const sent = await resendConfirmation(result, Astro.url.origin);
      errors.client =
        sent === 'recent'
          ? `Votre adresse n'est pas encore confirmée : ouvrez le lien envoyé à ${result.email} il y a quelques minutes (pensez aux indésirables).`
          : sent
            ? `Votre adresse n'est pas encore confirmée : un nouveau lien vient d'être envoyé à ${result.email}.`
            : "Votre adresse n'est pas encore confirmée, et l'e-mail de confirmation n'a pas pu partir. Réessayez dans un instant.";
      Astro.response.status = 403;
    } else {
      await logIn(Astro.cookies, result);
      return Astro.redirect(home(isStaff(result)), 303);
    }
  } catch (e) {
    console.error(e);
    errors[space] = 'Connexion momentanément impossible (base de données injoignable). Réessayez dans un instant.';
    Astro.response.status = 503;
  }
}

const spaces: { id: Space; title: string; lead: string; note: string }[] = [
  {
    id: 'client',
    title: 'Client',
    lead: 'Retrouvez vos devis et vos candidatures.',
    note: 'Pas encore de compte ?',
  },
  {
    id: 'equipe',
    title: 'Employé',
    lead: 'Accédez au portail de l’équipe.',
    note: 'Mot de passe oublié ? Demandez à un dirigeant de le réinitialiser.',
  },
];
const current = spaces.find((s) => s.id === active)!;
// Lien d'un onglet, en gardant la page de retour éventuelle
const tabHref = (id: Space) => `?${new URLSearchParams({ espace: id, ...(next ? { suite: next } : {}) })}`;
---

<BaseLayout title="Connexion" description="Connexion à votre compte NovaForge Studio." bare noindex>
  <section class="hero lock surface-dark" aria-labelledby="login-title" data-stardust-host>
    <canvas class="stardust" data-stardust aria-hidden="true"></canvas>
    <div class="lock-panel login-panel">
      <a href="/" aria-label="Retour à l'accueil"><Logo variant="stacked" tone="dark" /></a>
      <p class="lock-badge"><Icon name="lock" class="lock-badge-icon" /> Connexion</p>
      <h1 id="login-title">Votre compte.</h1>

      <div class="login-card card">
        <nav class="login-tabs" aria-label="Type de compte">
          {spaces.map(({ id, title }) => (
            <a class="login-tab" href={tabHref(id)} aria-current={active === id ? 'page' : undefined}>
              {title}
            </a>
          ))}
        </nav>
        <form class="login-form" method="post" aria-label={`Connexion ${current.title.toLowerCase()}`}>
          <input type="hidden" name="space" value={current.id} />
          <p class="lock-lead">{current.lead}</p>
          <div class="field">
            <label for="login-email">E-mail</label>
            <input class="input" id="login-email" name="email" type="email" value={emails[current.id]} autocomplete="username" required />
          </div>
          <div class="field">
            <label for="login-password">Mot de passe</label>
            <input
              class="input"
              id="login-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              aria-invalid={errors[current.id] ? 'true' : undefined}
              aria-describedby={errors[current.id] ? 'login-error' : undefined}
            />
            {errors[current.id] && (
              <p class="field-error" id="login-error" role="alert">
                {errors[current.id]}
              </p>
            )}
          </div>
          <button class:list={['btn', current.id === 'equipe' ? 'btn-primary' : 'btn-warm']} type="submit">
            Se connecter <Icon name="arrow" class="btn-arrow" />
          </button>
          <p class="lock-note">
            {current.note}
            {current.id === 'client' && (
              <Fragment>
                {' '}<a href="/inscription">Créer un compte</a>
              </Fragment>
            )}
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
