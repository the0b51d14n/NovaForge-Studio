---
// Connexion (icône de compte de l'en-tête) : deux formulaires, l'un pour les clients et visiteurs, l'autre pour
// les employés. Chaque formulaire n'accepte que les comptes de son espace (vérifié côté serveur).
// Après connexion : retour à la page demandée (?suite=…), sinon le portail de l'équipe pour un employé,
// l'accueil pour un client.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { ADMIN_PATH, logIn, safeNext } from '../lib/access';
import { authenticate, isStaff } from '../lib/accounts';

type Space = 'client' | 'equipe';
const next = safeNext(Astro.url.searchParams.get('suite'));
const home = (staff: boolean) => next ?? (staff ? ADMIN_PATH : '/');
const { user } = Astro.locals;
if (user && Astro.request.method !== 'POST') return Astro.redirect(home(isStaff(user)));

const errors: Record<Space, string> = { client: '', equipe: '' };
const emails: Record<Space, string> = { client: '', equipe: '' };
// Formulaire mis en avant sur mobile : celui de l'équipe si la page demandée est le portail
let active: Space = next?.startsWith(ADMIN_PATH) ? 'equipe' : 'client';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const space: Space = data.get('space') === 'equipe' ? 'equipe' : 'client';
  active = space;
  emails[space] = String(data.get('email') ?? '').trim().slice(0, 200);
  try {
    const result = await authenticate(emails[space], String(data.get('password') ?? '').slice(0, 200));
    if (result === 'bloque') {
      errors[space] = 'Trop de tentatives sur ce compte : réessayez dans 15 minutes.';
      Astro.response.status = 429;
    } else if (!result) {
      // Petite pause après un échec : ralentit les essais de mots de passe à la chaîne
      await new Promise((resolve) => setTimeout(resolve, 800));
      errors[space] = 'Adresse e-mail ou mot de passe incorrect.';
      Astro.response.status = 401;
    } else if (space === 'equipe' && !isStaff(result)) {
      errors.equipe = 'Ce compte est un compte client : utilisez le formulaire « Client ».';
      Astro.response.status = 403;
    } else if (space === 'client' && isStaff(result)) {
      errors.client = 'Ce compte appartient à l’équipe : utilisez le formulaire « Employé ».';
      Astro.response.status = 403;
    } else {
      await logIn(Astro.cookies, result);
      return Astro.redirect(home(isStaff(result)), 303);
    }
  } catch (e) {
    console.error(e);
    errors[space] = 'Connexion momentanément impossible (base de données injoignable). Réessayez dans un instant.';
    Astro.response.status = 503;
  }
}

const spaces: { id: Space; title: string; lead: string; note: string }[] = [
  {
    id: 'client',
    title: 'Client',
    lead: 'Retrouvez vos devis et vos candidatures.',
    note: 'Pas encore de compte ? La création de compte client ouvrira avec le lancement du studio.',
  },
  {
    id: 'equipe',
    title: 'Employé',
    lead: 'Accédez au portail de l’équipe.',
    note: 'Mot de passe oublié ? Demandez à un dirigeant de le réinitialiser.',
  },
];
---

<BaseLayout title="Connexion" description="Connexion à votre compte NovaForge Studio." bare noindex>
  <section class="hero lock surface-dark" aria-labelledby="login-title" data-stardust-host>
    <canvas class="stardust" data-stardust aria-hidden="true"></canvas>
    <div class="lock-panel login-panel">
      <a href="/" aria-label="Retour à l'accueil"><Logo variant="stacked" tone="dark" /></a>
      <p class="lock-badge"><Icon name="lock" class="lock-badge-icon" /> Connexion</p>
      <h1 id="login-title">Votre compte.</h1>

      <div class="login-grid">
        {spaces.map(({ id, title, lead, note }) => (
          <form class:list={['login-card', 'card', { 'is-active': active === id }]} method="post" aria-labelledby={`login-${id}`}>
            <input type="hidden" name="space" value={id} />
            <h2 class="login-card-title" id={`login-${id}`}>{title}</h2>
            <p class="lock-lead">{lead}</p>
            <div class="field">
              <label for={`${id}-email`}>E-mail</label>
              <input class="input" id={`${id}-email`} name="email" type="email" value={emails[id]} autocomplete="username" required />
            </div>
            <div class="field">
              <label for={`${id}-password`}>Mot de passe</label>
              <input
                class="input"
                id={`${id}-password`}
                name="password"
                type="password"
                autocomplete="current-password"
                required
                aria-invalid={errors[id] ? 'true' : undefined}
                aria-describedby={errors[id] ? `${id}-error` : undefined}
              />
              {errors[id] && (
                <p class="field-error" id={`${id}-error`} role="alert">
                  {errors[id]}
                </p>
              )}
            </div>
            <button class:list={['btn', id === 'equipe' ? 'btn-primary' : 'btn-warm']} type="submit">
              Se connecter <Icon name="arrow" class="btn-arrow" />
            </button>
            <p class="lock-note">{note}</p>
          </form>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
