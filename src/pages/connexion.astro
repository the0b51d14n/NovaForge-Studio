---
// Connexion des clients (icône de compte de l'en-tête). Le site est réservé aux clients : un compte de l'équipe
// est refusé ici et renvoyé vers le portail de l'équipe (application séparée, sa propre connexion).
// Après connexion : retour à la page demandée (?suite=…), sinon l'espace client. Un client dont l'adresse n'est
// pas confirmée (envoi d'e-mails configuré) n'est pas connecté : un nouveau lien de confirmation lui est envoyé.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { logIn, safeNext } from '../lib/access';
import { adminHref } from '../lib/portal';
import { authenticate, isStaff, needsConfirmation, resendConfirmation } from '../lib/accounts';

const next = safeNext(Astro.url.searchParams.get('suite')) ?? '/espace';
const { user } = Astro.locals;
if (user && Astro.request.method !== 'POST') return Astro.redirect(next);

let email = '';
let error = '';
// Compte de l'équipe : message avec le lien du portail
let staff = false;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  email = String(data.get('email') ?? '').trim().slice(0, 200);
  try {
    const result = await authenticate(email, String(data.get('password') ?? '').slice(0, 200));
    if (result === 'bloque') {
      error = 'Trop de tentatives sur ce compte : réessayez dans 15 minutes.';
      Astro.response.status = 429;
    } else if (!result) {
      // Petite pause après un échec : ralentit les essais de mots de passe à la chaîne
      await new Promise((resolve) => setTimeout(resolve, 800));
      error = 'Adresse e-mail ou mot de passe incorrect.';
      Astro.response.status = 401;
    } else if (isStaff(result)) {
      staff = true;
      error = 'Ce compte appartient à l’équipe : il se connecte sur le portail de l’équipe, pas sur le site.';
      Astro.response.status = 403;
    } else if (needsConfirmation(result)) {
      const sent = await resendConfirmation(result, Astro.url.origin);
      error =
        sent === 'recent'
          ? `Votre adresse n'est pas encore confirmée : ouvrez le lien envoyé à ${result.email} il y a quelques minutes (pensez aux indésirables).`
          : sent
            ? `Votre adresse n'est pas encore confirmée : un nouveau lien vient d'être envoyé à ${result.email}.`
            : "Votre adresse n'est pas encore confirmée, et l'e-mail de confirmation n'a pas pu partir. Réessayez dans un instant.";
      Astro.response.status = 403;
    } else {
      await logIn(Astro.cookies, result);
      return Astro.redirect(next, 303);
    }
  } catch (e) {
    console.error(e);
    error = 'Connexion momentanément impossible (base de données injoignable). Réessayez dans un instant.';
    Astro.response.status = 503;
  }
}
---

<BaseLayout title="Connexion" description="Connexion à votre compte NovaForge Studio." bare noindex>
  <section class="hero lock surface-dark" aria-labelledby="login-title" data-stardust-host>
    <canvas class="stardust" data-stardust aria-hidden="true"></canvas>
    <div class="lock-panel login-panel">
      <a href="/" aria-label="Retour à l'accueil"><Logo variant="stacked" tone="dark" /></a>
      <p class="lock-badge"><Icon name="lock" class="lock-badge-icon" /> Connexion</p>
      <h1 id="login-title">Votre compte.</h1>

      <div class="login-card card">
        <form class="login-form" method="post" aria-label="Connexion client">
          <p class="lock-lead">Retrouvez vos devis et vos candidatures.</p>
          <div class="field">
            <label for="login-email">E-mail</label>
            <input class="input" id="login-email" name="email" type="email" value={email} autocomplete="username" required />
          </div>
          <div class="field">
            <label for="login-password">Mot de passe</label>
            <input
              class="input"
              id="login-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              aria-invalid={error ? 'true' : undefined}
              aria-describedby={error ? 'login-error' : undefined}
            />
            {error && (
              <p class="field-error" id="login-error" role="alert">
                {error}
                {staff && (
                  <Fragment>
                    {' '}<a href={adminHref('/connexion')}>Aller au portail</a>
                  </Fragment>
                )}
              </p>
            )}
          </div>
          <button class="btn btn-warm" type="submit">
            Se connecter <Icon name="arrow" class="btn-arrow" />
          </button>
          <p class="lock-note">
            Pas encore de compte ? <a href="/inscription">Créer un compte</a>
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
