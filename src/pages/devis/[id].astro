---
// Estimation puis devis ferme, à la même adresse secrète (/devis/<id>), non référencée : seul celui qui a le lien
// y accède. Voir src/lib/quotes.ts pour les étapes (estimation → demande de rappel → devis ferme → signature).
// L'estimation ne montre qu'un total approximatif (fourchette), comparé au budget envisagé ; le détail ligne par ligne
// n'apparaît que dans le devis ferme établi par le conseiller.
// Demande de rappel et signature en ligne seulement après l'ouverture commerciale (canRequestCallback, canSign).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { QUOTE_VALIDITY_DAYS, UNIT_LABELS, type Unit } from '../../data/quote-catalog';
import { legal, isRegistered } from '../../data/site';
import { formatEuros, formatRange, type Estimate, type FinalLine } from '../../lib/pricing';
import { getSite } from '../../lib/store';
import { isEmail, oneLine } from '../../lib/forms';
import {
  RETENTION_DAYS,
  canRequestCallback,
  canSign,
  loadQuote,
  quoteStatus,
  requestCallback,
  signQuote,
  type Quote,
} from '../../lib/quotes';

const site = getSite(Astro.locals);
let quote: Quote | null = null;
let unavailable = false;
try {
  quote = await loadQuote(Astro.params.id ?? '');
} catch (e) {
  console.error(e);
  unavailable = true;
}
if (!quote) Astro.response.status = unavailable ? 503 : 404;

const errors: Record<string, string> = {};
// Client connecté : nom et e-mail préremplis dans la demande de rappel et la signature
const me = Astro.locals.user?.role === 'client' ? Astro.locals.user : null;
const form = { name: me?.name ?? '', email: me?.email ?? '', phone: '', message: '' };

if (quote && Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');
  form.name = oneLine(String(data.get('name') ?? '')).trim().slice(0, 120);
  form.email = String(data.get('email') ?? '').trim().slice(0, 200);
  form.phone = oneLine(String(data.get('phone') ?? '')).trim().slice(0, 30);
  form.message = String(data.get('message') ?? '').trim().slice(0, 2000);
  const allowed = action === 'callback' ? canRequestCallback(quote) : action === 'sign' ? canSign(quote) : false;
  if (!allowed) {
    errors.form = 'Cette action n’est pas (ou plus) possible pour ce devis.';
  } else {
    if (form.name.length < 2) errors.name = 'Indiquez vos prénom et nom.';
    if (action === 'callback') {
      if (form.phone.replace(/\D/g, '').length < 9) errors.phone = 'Indiquez un numéro de téléphone pour être rappelé.';
      if (form.email && !isEmail(form.email)) errors.email = 'Cette adresse e-mail ne semble pas valide.';
    } else {
      if (!isEmail(form.email)) errors.email = 'Indiquez une adresse e-mail valide.';
      if (data.get('accept') !== 'oui') errors.accept = 'Cochez la case pour accepter le devis.';
    }
    if (Object.keys(errors).length === 0) {
      try {
        if (action === 'callback') {
          await requestCallback(quote, form);
          return Astro.redirect(`/devis/${quote.id}?ok=rappel`, 303);
        }
        await signQuote(quote, { name: form.name, email: form.email });
        return Astro.redirect(`/devis/${quote.id}?ok=signe`, 303);
      } catch (e) {
        console.error(e);
        errors.form = "L'enregistrement a échoué. Réessayez dans un instant.";
      }
    }
  }
  Astro.response.status = 422;
}

const status = quote ? quoteStatus(quote) : null;
const final = quote?.final;
const dateFormat = { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' } as const;
const formatDate = (iso: string) => new Date(iso).toLocaleDateString('fr-FR', dateFormat);
const formatDateTime = (iso: string) =>
  new Date(iso).toLocaleString('fr-FR', { ...dateFormat, hour: '2-digit', minute: '2-digit' });
const validUntil = final?.expiresAt ?? quote?.expiresAt ?? '';
const daysLeft = Math.max(0, Math.ceil((Date.parse(validUntil) - Date.now()) / 86_400_000));
const vatRate = quote?.vatRate ?? 0;
const ttcLabel = vatRate > 0 ? 'TTC' : '';

const qtyLabel = (qty: number, unit: Unit) => `${qty} ${UNIT_LABELS[unit][qty > 1 ? 1 : 0]}`;
// Choix du visiteur, sans prix : « Site vitrine · Site essentiel », puis les options
const choices = (lines: { label: string; qty: number; unit: Unit }[]) =>
  lines.map((l) => (l.qty > 1 || (l.unit !== 'forfait' && l.unit !== 'mois') ? `${l.label} (${qtyLabel(l.qty, l.unit)})` : l.label));
const options = quote?.lines.filter((l) => l.label !== quote!.base) ?? [];
const totalOf = (estimate: Pick<Estimate, 'totals'>, monthly: boolean) => {
  const part = monthly ? estimate.totals.monthly : estimate.totals.oneOff;
  return formatRange([part.min.ttc, part.max.ttc]);
};

// Devis ferme : lignes regroupées par service, avec leurs prix
const finalGroups = (monthly: boolean) => {
  const groups = new Map<string, FinalLine[]>();
  for (const line of final?.lines.filter((l) => l.monthly === monthly) ?? []) {
    groups.set(line.group, [...(groups.get(line.group) ?? []), line]);
  }
  return [...groups];
};
const finalRows = (monthly: boolean): [string, string, boolean][] => {
  if (!final) return [];
  const totals = monthly ? final.totals.monthly : final.totals.oneOff;
  const per = monthly ? ' par mois' : '';
  const discount = !monthly && final.discount;
  return [
    ...(discount
      ? ([
          ['Sous-total HT', formatEuros(totals.ht + discount.amount), false],
          [discount.label || 'Remise', `− ${formatEuros(discount.amount)}`, false],
        ] as [string, string, boolean][])
      : []),
    [`Total HT${per}`, formatEuros(totals.ht), false],
    ...(vatRate > 0 ? ([[`TVA ${vatRate} %`, formatEuros(totals.vat), false]] as [string, string, boolean][]) : []),
    [`Total ${vatRate > 0 ? 'TTC' : 'à payer'}${per}`, formatEuros(totals.ttc), true],
  ];
};
const amount = final
  ? `${formatEuros(final.totals.oneOff.ttc)}${final.totals.monthly.ttc > 0 ? `, puis ${formatEuros(final.totals.monthly.ttc)} par mois` : ''}`
  : '';

const FIT_TEXT = {
  couvert: 'Votre budget couvre cette estimation.',
  dans: 'Votre budget se situe dans la fourchette estimée : le conseiller ajustera le contenu avec vous pour le respecter.',
  sous: 'Votre budget est en dessous de cette estimation.',
};
const issuer = legal.legalName ?? legal.publisher ?? site.name;
const phoneHref = site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : null;
const ok = Astro.url.searchParams.get('ok');
const invalid = (name: string) => (errors[name] ? 'true' : undefined);
const describedBy = (name: string) => (errors[name] ? `${name}-err` : undefined);
const titles = { estimation: 'Votre estimation.', rappel: 'Votre estimation.', ferme: 'Votre devis.', expire: 'Devis expiré.', signe: 'Devis signé.' };
const kind = final ? 'Devis' : 'Estimation';
---

<BaseLayout title={quote ? `${kind} ${quote.number}` : 'Devis introuvable'} description="Votre devis NovaForge Studio." noindex>
  <PageHero eyebrow={quote ? `${kind} ${quote.number}` : 'Devis'} compact>
    <Fragment slot="title">
      {status ? <em>{titles[status]}</em> : <Fragment>Devis <em>introuvable.</em></Fragment>}
    </Fragment>
  </PageHero>

  <section class="section section--tight surface-light-2" aria-label="Détail du devis">
    <div class="container quote-page">
      {
        !quote ? (
          <div class="quote-empty card">
            <p>
              {unavailable
                ? 'Le devis est momentanément indisponible. Réessayez dans un instant.'
                : `Ce lien ne correspond à aucun devis. Une estimation non suivie est supprimée ${RETENTION_DAYS} jours après sa création.`}
            </p>
            <a class="btn btn-primary" href="/devis">
              Faire une simulation <Icon name="arrow" class="btn-arrow" />
            </a>
          </div>
        ) : (
          <Fragment>
            {ok === 'rappel' && status === 'rappel' && (
              <p class="admin-flash" role="status">
                <Icon name="check" /> C'est noté : un conseiller vous rappelle pour établir votre devis.
              </p>
            )}
            {ok === 'signe' && status === 'signe' && (
              <p class="admin-flash" role="status">
                <Icon name="check" /> Merci ! Votre devis est signé : nous revenons vers vous pour lancer le projet.
              </p>
            )}
            {!quote.binding && (
              <p class="quote-banner">
                <strong>Simulation non contractuelle.</strong> Établie avant l'ouverture commerciale du studio, elle donne
                un ordre de prix : elle ne peut être ni finalisée en ligne ni signée.
              </p>
            )}
            {status === 'expire' && (
              <p class="quote-banner">
                <strong>Ce {final ? 'devis' : 'cette estimation'} a expiré le {formatDate(validUntil)}.</strong> Ses prix ne
                sont plus garantis : refaites une simulation pour obtenir une estimation à jour.
              </p>
            )}

            {!final ? (
              <article class="quote-doc card">
                <header class="quote-doc-head">
                  <div>
                    <p class="quote-doc-label">Votre projet</p>
                    <p class="quote-doc-strong">
                      {quote.family.title} · {quote.base}
                    </p>
                  </div>
                  <dl class="quote-doc-meta">
                    <div><dt>Numéro</dt><dd>{quote.number}</dd></div>
                    <div><dt>Estimation du</dt><dd>{formatDate(quote.createdAt)}</dd></div>
                    <div><dt>Valable jusqu'au</dt><dd>{formatDate(quote.expiresAt)}</dd></div>
                  </dl>
                </header>

                {options.length > 0 && (
                  <div>
                    <p class="quote-doc-label">Options choisies</p>
                    <ul class="quote-choices">
                      {choices(options).map((choice) => (
                        <li>
                          <Icon name="check" /> {choice}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <div class="quote-estimate">
                  <p class="quote-doc-label">Estimation approximative {ttcLabel}</p>
                  {quote.totals.oneOff.max.ttc > 0 && <p class="quote-estimate-value">{totalOf(quote, false)}</p>}
                  {quote.totals.monthly.max.ttc > 0 && (
                    <p class:list={['quote-estimate-value', { 'quote-estimate-value--sub': quote.totals.oneOff.max.ttc > 0 }]}>
                      {quote.totals.oneOff.max.ttc > 0 && 'puis '}
                      {totalOf(quote, true)} / mois
                    </p>
                  )}
                  {quote.discounts.map((d) => (
                    <p class="quote-estimate-discount">
                      <Icon name="star" /> {d.label} : déjà déduite ({formatRange(d.amount)} HT)
                    </p>
                  ))}
                  <p class="form-note">
                    Le prix exact dépend de la complexité réelle de votre projet : il est fixé avec vous par un conseiller
                    dans votre devis.
                  </p>
                </div>

                {quote.budget && (
                  <div class:list={['quote-budget', `quote-budget--${quote.budget.fit}`]}>
                    <p class="quote-doc-label">Votre budget : {quote.budget.label}</p>
                    <p>{FIT_TEXT[quote.budget.fit]}</p>
                    {quote.budget.fit === 'sous' &&
                      (quote.suggestion ? (
                        <div class="quote-suggestion">
                          <p class="quote-doc-strong">Une version ajustée à votre budget</p>
                          <p>
                            {quote.suggestion.base !== quote.base && <Fragment>Formule « {quote.suggestion.base} »</Fragment>}
                            {quote.suggestion.base !== quote.base && quote.suggestion.removed.length > 0 && ', '}
                            {quote.suggestion.removed.length > 0 && <Fragment>sans : {quote.suggestion.removed.join(', ')}</Fragment>}.
                          </p>
                          <p class="quote-estimate-value quote-estimate-value--sub">
                            {quote.budget.monthly
                              ? `${totalOf(quote.suggestion, true)} / mois`
                              : totalOf(quote.suggestion, false)}
                          </p>
                          <p class="form-note">Le conseiller vous présentera les deux possibilités.</p>
                        </div>
                      ) : (
                        <p>
                          Aucune formule de ce type ne rentre dans ce budget : le conseiller vous proposera une solution
                          par étapes ou une alternative.
                        </p>
                      ))}
                  </div>
                )}

                <ul class="quote-doc-notes">
                  {vatRate === 0 && <li>TVA non applicable, art. 293 B du CGI.</li>}
                  <li>Estimation garantie {QUOTE_VALIDITY_DAYS} jours, jusqu'au {formatDate(quote.expiresAt)}.</li>
                </ul>
              </article>
            ) : (
              <article class="quote-doc card">
                <header class="quote-doc-head">
                  <div>
                    <p class="quote-doc-label">Émis par</p>
                    <p class="quote-doc-strong">{issuer}</p>
                    <p>{site.address.join(', ')}</p>
                    {legal.siret && <p>SIRET {legal.siret}</p>}
                    {legal.vat && <p>TVA intracommunautaire {legal.vat}</p>}
                    {!isRegistered && <p class="quote-doc-muted">Projet en préparation, non immatriculé</p>}
                  </div>
                  <dl class="quote-doc-meta">
                    <div><dt>Numéro</dt><dd>{quote.number}</dd></div>
                    <div><dt>Devis du</dt><dd>{formatDate(final.issuedAt)}</dd></div>
                    <div>
                      <dt>Valable jusqu'au</dt>
                      <dd>
                        {formatDate(final.expiresAt)}
                        {status === 'ferme' && ` (encore ${daysLeft} jour${daysLeft > 1 ? 's' : ''})`}
                      </dd>
                    </div>
                  </dl>
                </header>

                {[false, true].map((monthly) => {
                  const groups = finalGroups(monthly);
                  return (
                    groups.length > 0 && (
                      <div class="quote-table-wrap">
                        <table class="quote-table">
                          <caption>{monthly ? 'Abonnement mensuel' : 'Prestations'}</caption>
                          <thead>
                            <tr>
                              <th scope="col">Désignation</th>
                              <th scope="col">Quantité</th>
                              <th scope="col">Prix unitaire HT</th>
                              <th scope="col">Total HT</th>
                            </tr>
                          </thead>
                          {groups.map(([group, lines]) => (
                            <tbody>
                              <tr class="quote-table-group">
                                <th scope="rowgroup" colspan="4">{group}</th>
                              </tr>
                              {lines.map((line) => (
                                <tr>
                                  <td>
                                    {line.label}
                                    {line.detail && <span class="quote-item-detail">{line.detail}</span>}
                                  </td>
                                  <td>{qtyLabel(line.qty, line.unit)}</td>
                                  <td>{formatEuros(line.unitPrice)}</td>
                                  <td>{formatEuros(line.total)}</td>
                                </tr>
                              ))}
                            </tbody>
                          ))}
                        </table>
                        <dl class="quote-totals">
                          {finalRows(monthly).map(([label, value, main]) => (
                            <div class:list={{ 'quote-totals-main': main }}>
                              <dt>{label}</dt>
                              <dd>{value}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    )
                  );
                })}

                {final.note && <p class="quote-doc-note">{final.note}</p>}

                <ul class="quote-doc-notes">
                  {vatRate === 0 && <li>TVA non applicable, art. 293 B du CGI.</li>}
                  <li>Prix fermes jusqu'au {formatDate(final.expiresAt)}, date limite de signature.</li>
                  {final.totals.monthly.ht > 0 && <li>L'abonnement mensuel démarre à la mise en ligne.</li>}
                </ul>

                {quote.signature && (
                  <p class="quote-signed">
                    <Icon name="check" /> Bon pour accord : signé par <strong>{quote.signature.name}</strong> le
                    {' '}{formatDateTime(quote.signature.signedAt)}.
                  </p>
                )}
              </article>
            )}

            {errors.form && (
              <p class="admin-alert" role="alert">
                {errors.form}
              </p>
            )}

            {status === 'rappel' && quote.contact && (
              <p class="quote-banner">
                <strong>Demande de rappel reçue le {formatDate(quote.contact.requestedAt)}.</strong> Un conseiller étudie
                votre projet et vous rappelle ; votre devis apparaîtra sur cette page.
              </p>
            )}

            {canRequestCallback(quote) && (
              <form class="form form--card card quote-sign" method="post" novalidate>
                <input type="hidden" name="action" value="callback" />
                <h2 class="quote-sign-title field--full">Être rappelé par un conseiller</h2>
                <p class="form-note field--full">
                  Il fait le point avec vous sur votre projet et votre budget, puis vous envoie votre devis aux prix
                  fermes, sur cette page.
                </p>
                <div class="field">
                  <label for="cb-name">Prénom et nom <span class="req">*</span></label>
                  <input class="input" id="cb-name" name="name" value={form.name} required maxlength="120" autocomplete="name" aria-invalid={invalid('name')} aria-describedby={describedBy('name')} />
                  {errors.name && <p class="field-error" id="name-err">{errors.name}</p>}
                </div>
                <div class="field">
                  <label for="cb-phone">Téléphone <span class="req">*</span></label>
                  <input class="input" id="cb-phone" name="phone" type="tel" value={form.phone} required maxlength="30" autocomplete="tel" aria-invalid={invalid('phone')} aria-describedby={describedBy('phone')} />
                  {errors.phone && <p class="field-error" id="phone-err">{errors.phone}</p>}
                </div>
                <div class="field">
                  <label for="cb-email">E-mail</label>
                  <input class="input" id="cb-email" name="email" type="email" value={form.email} maxlength="200" autocomplete="email" aria-invalid={invalid('email')} aria-describedby={describedBy('email')} />
                  {errors.email && <p class="field-error" id="email-err">{errors.email}</p>}
                </div>
                <div class="field field--full">
                  <label for="cb-message">Précisions sur votre projet</label>
                  <textarea class="input" id="cb-message" name="message" rows="4" maxlength="2000" placeholder="Votre activité, vos délais, le meilleur moment pour vous appeler…">{form.message}</textarea>
                </div>
                <p class="form-privacy field--full">
                  Vos coordonnées servent uniquement à vous rappeler au sujet de ce devis. Elles sont supprimées avec lui
                  s'il n'est pas signé : <a href="/confidentialite">politique de confidentialité</a>.
                </p>
                <div class="form-footer">
                  <p class="form-note"><span aria-hidden="true">*</span> Champs obligatoires</p>
                  <button class="btn btn-primary" type="submit">
                    Être rappelé <Icon name="arrow" class="btn-arrow" />
                  </button>
                </div>
              </form>
            )}

            {!quote.binding && phoneHref && !final && (
              <p class="form-note">
                Une question sur ce projet ? Appelez-nous au <a href={phoneHref}>{site.phone}</a>.
              </p>
            )}

            {canSign(quote) && (
              <form class="form form--card card quote-sign" method="post" novalidate>
                <input type="hidden" name="action" value="sign" />
                <h2 class="quote-sign-title field--full">Signer ce devis</h2>
                <div class="field">
                  <label for="sign-name">Prénom et nom <span class="req">*</span></label>
                  <input class="input" id="sign-name" name="name" value={form.name || quote.contact?.name} required maxlength="120" autocomplete="name" aria-invalid={invalid('name')} aria-describedby={describedBy('name')} />
                  {errors.name && <p class="field-error" id="name-err">{errors.name}</p>}
                </div>
                <div class="field">
                  <label for="sign-email">E-mail <span class="req">*</span></label>
                  <input class="input" id="sign-email" name="email" type="email" value={form.email || quote.contact?.email} required maxlength="200" autocomplete="email" aria-invalid={invalid('email')} aria-describedby={describedBy('email')} />
                  {errors.email && <p class="field-error" id="email-err">{errors.email}</p>}
                </div>
                <div class="field field--full">
                  <label class="check">
                    <input type="checkbox" name="accept" value="oui" required aria-invalid={invalid('accept')} aria-describedby={describedBy('accept')} />
                    <span>
                      J'ai lu le détail de ce devis et les conditions générales de vente, et je les accepte : bon pour
                      accord pour un montant de {amount}.
                    </span>
                  </label>
                  {errors.accept && <p class="field-error" id="accept-err">{errors.accept}</p>}
                </div>
                <p class="form-privacy field--full">
                  Vous disposez d'un délai de 14 jours à compter de la signature pour vous rétracter, sans avoir à vous
                  justifier (code de la consommation, art. L221-18). Vos nom et e-mail servent à établir le contrat :
                  {' '}<a href="/confidentialite">politique de confidentialité</a>.
                </p>
                <div class="form-footer">
                  <p class="form-note">À signer avant le {formatDate(validUntil)}</p>
                  <button class="btn btn-primary" type="submit">
                    Signer le devis <Icon name="arrow" class="btn-arrow" />
                  </button>
                </div>
              </form>
            )}

            <div class="quote-actions">
              <button class="btn btn-ghost" type="button" data-print>Imprimer ou enregistrer en PDF</button>
              <a class="btn btn-ghost" href="/devis">Nouvelle simulation</a>
              {status !== 'signe' && (
                <p class="form-note">Gardez le lien de cette page : c'est la seule façon de retrouver votre devis.</p>
              )}
            </div>
          </Fragment>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
