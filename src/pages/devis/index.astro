---
// Simulateur de devis : le visiteur compose son projet (formule par service, options, quantités) et voit une
// estimation en fourchette en direct, puis crée son estimation. Les fourchettes sont recalculées ici, côté serveur,
// à partir de src/data/quote-catalog.ts, et figées dans l'estimation enregistrée : le navigateur n'envoie que les choix.
// Fonctionne sans JavaScript (le total s'affiche alors sur l'estimation créée).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { QUOTE_VALIDITY_DAYS, UNIT_LABELS, type CatalogItem } from '../../data/quote-catalog';
import { launch } from '../../data/site';
import {
  VAT_RATE,
  availableCatalog,
  computeTotals,
  estimateLines,
  formatEuros,
  formatRange,
  priceRange,
  readSelection,
  type Range,
  type Selection,
} from '../../lib/pricing';
import { clientKey, createQuote } from '../../lib/quotes';

const groups = availableCatalog();
let selection: Selection = { bases: {}, options: [], quantities: {} };
let error = '';

if (Astro.request.method === 'POST' && groups.length > 0) {
  const data = await Astro.request.formData();
  // Champ piège rempli : un robot, on fait comme si de rien n'était
  if (data.get('site_web')) return Astro.redirect('/devis', 303);
  selection = readSelection(data);
  const lines = estimateLines(selection);
  if (lines.length === 0) {
    error = 'Choisissez au moins une prestation pour créer votre estimation.';
    Astro.response.status = 422;
  } else {
    try {
      const quote = await createQuote(lines, await clientKey(Astro.request, () => Astro.clientAddress));
      if (quote !== 'limite') return Astro.redirect(`/devis/${quote.id}`, 303);
      error = 'Vous avez créé beaucoup d’estimations en peu de temps : réessayez dans une heure.';
      Astro.response.status = 429;
    } catch (e) {
      console.error(e);
      error = "L'estimation n'a pas pu être enregistrée. Réessayez dans un instant.";
      Astro.response.status = 500;
    }
  }
}

// Prix affichés au visiteur : TTC (HT et TTC sont égaux en franchise de TVA)
const ttc = ([min, max]: Range): Range => [computeTotals(min, VAT_RATE).ttc, computeTotals(max, VAT_RATE).ttc];
const range = (item: CatalogItem) => priceRange(item.price)!;
function priceTag(item: CatalogItem) {
  const price = formatRange(ttc(range(item)));
  if (item.kind === 'quantity') return `${price} / ${UNIT_LABELS[item.unit][0]}${item.monthly ? ', par mois' : ''}`;
  return item.monthly ? `${price} / mois` : price;
}
const taxNote = VAT_RATE ? `Prix TTC (TVA ${VAT_RATE} % comprise).` : 'TVA non applicable, art. 293 B du CGI.';
---

<BaseLayout
  title="Simulateur de devis"
  description="Composez votre projet (site vitrine, boutique en ligne, identité visuelle, application, maintenance) et obtenez immédiatement une estimation détaillée."
>
  <PageHero
    eyebrow="Simulateur de devis"
    lead={
      launch.commercial
        ? "Choisissez vos prestations : vous obtenez une estimation détaillée, en fourchette. Un développeur vous recontacte ensuite pour établir votre devis aux prix fermes, selon la complexité réelle de votre projet."
        : "Choisissez vos prestations pour obtenir une estimation détaillée, en fourchette. Le studio est en préparation : cette estimation est une simulation, non contractuelle."
    }
  >
    <Fragment slot="title">Composez votre projet, <em>estimez le prix.</em></Fragment>
  </PageHero>

  <section class="section section--tight surface-light-2" aria-label="Simulateur">
    <div class="container">
      {
        groups.length === 0 ? (
          <div class="quote-empty card">
            <h2 class="quote-empty-title">Le simulateur arrive bientôt.</h2>
            <p>Nos tarifs sont en cours de finalisation : le simulateur ouvrira dès qu’ils seront prêts.</p>
            <a class="btn btn-primary" href="/contact">
              Nous contacter <Icon name="arrow" class="btn-arrow" />
            </a>
          </div>
        ) : (
          <form class="quote-layout" method="post" data-quote-form data-vat-rate={VAT_RATE}>
            <div class="hp" aria-hidden="true">
              <label>
                Ne pas remplir <input type="text" name="site_web" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="quote-groups">
              {groups.map((group) => {
                const bases = group.items.filter((item) => item.kind === 'base');
                const extras = group.items.filter((item) => item.kind !== 'base');
                const chosen = selection.bases[group.id] ?? '';
                return (
                  <fieldset class="quote-group card" data-group data-needs-base={bases.length > 0 ? 'true' : undefined}>
                    <legend class="quote-group-title">{group.title}</legend>
                    <p class="quote-group-intro">{group.intro}</p>

                    {bases.length > 0 && (
                      <div class="quote-items" role="radiogroup" aria-label={`Formule : ${group.title}`}>
                        <label class="quote-item">
                          <input type="radio" name={`base:${group.id}`} value="" checked={!chosen} />
                          <span class="quote-item-text">
                            <span class="quote-item-label">Pas pour l'instant</span>
                          </span>
                        </label>
                        {bases.map((item) => (
                          <label class="quote-item">
                            <input
                              type="radio"
                              name={`base:${group.id}`}
                              value={item.id}
                              checked={chosen === item.id}
                              data-min={range(item)[0]}
                              data-max={range(item)[1]}
                              data-monthly={item.monthly ? 'true' : undefined}
                              data-label={item.label}
                            />
                            <span class="quote-item-text">
                              <span class="quote-item-label">{item.label}</span>
                              {item.detail && <span class="quote-item-detail">{item.detail}</span>}
                            </span>
                            <span class="quote-item-price">{priceTag(item)}</span>
                          </label>
                        ))}
                      </div>
                    )}

                    {extras.length > 0 && (
                      <div class="quote-extras" data-extras>
                        {bases.length > 0 && <p class="quote-extras-title">Options</p>}
                        <div class="quote-items">
                          {extras.map((item) =>
                            item.kind === 'quantity' ? (
                              <div class="quote-item quote-item--qty">
                                <span class="quote-item-text">
                                  <label class="quote-item-label" for={`qty-${item.id}`}>
                                    {item.label}
                                  </label>
                                  {item.detail && <span class="quote-item-detail">{item.detail}</span>}
                                  <span class="quote-item-price">{priceTag(item)}</span>
                                </span>
                                <input
                                  class="input quote-qty"
                                  id={`qty-${item.id}`}
                                  name={`qty:${item.id}`}
                                  type="number"
                                  min="0"
                                  max={item.max ?? 99}
                                  step="1"
                                  inputmode="numeric"
                                  value={selection.quantities[item.id] || 0}
                                  data-min={range(item)[0]}
                                  data-max={range(item)[1]}
                                  data-monthly={item.monthly ? 'true' : undefined}
                                  data-label={item.label}
                                  data-unit={UNIT_LABELS[item.unit].join('|')}
                                />
                              </div>
                            ) : (
                              <label class="quote-item">
                                <input
                                  type="checkbox"
                                  name="option"
                                  value={item.id}
                                  checked={selection.options.includes(item.id)}
                                  data-min={range(item)[0]}
                                  data-max={range(item)[1]}
                                  data-monthly={item.monthly ? 'true' : undefined}
                                  data-label={item.label}
                                />
                                <span class="quote-item-text">
                                  <span class="quote-item-label">{item.label}</span>
                                  {item.detail && <span class="quote-item-detail">{item.detail}</span>}
                                </span>
                                <span class="quote-item-price">{priceTag(item)}</span>
                              </label>
                            ),
                          )}
                        </div>
                        {bases.length > 0 && (
                          <p class="quote-extras-hint">Choisissez d'abord une formule pour ajouter des options.</p>
                        )}
                      </div>
                    )}
                  </fieldset>
                );
              })}
            </div>

            <aside class="quote-summary card surface-dark" aria-labelledby="quote-summary-title">
              <h2 class="quote-summary-title" id="quote-summary-title">Votre estimation</h2>
              <ul class="quote-summary-lines" data-summary-lines>
                <li class="quote-summary-empty">Aucune prestation choisie pour l'instant.</li>
              </ul>
              <dl class="quote-summary-totals" aria-live="polite">
                <div>
                  <dt>Total estimé{VAT_RATE ? ' TTC' : ''}</dt>
                  <dd data-total-once>{formatEuros(0)}</dd>
                </div>
                <div data-monthly-row hidden>
                  <dt>Puis chaque mois</dt>
                  <dd data-total-monthly>{formatEuros(0)}</dd>
                </div>
              </dl>
              <p class="quote-summary-note">{taxNote}</p>
              {error && (
                <p class="field-error" role="alert">
                  {error}
                </p>
              )}
              <button class="btn btn-warm" type="submit">
                Créer mon estimation <Icon name="arrow" class="btn-arrow" />
              </button>
              <p class="quote-summary-note">
                {launch.commercial
                  ? `Fourchettes garanties ${QUOTE_VALIDITY_DAYS} jours. Le prix ferme est fixé avec vous par un développeur. Aucune donnée personnelle demandée pour l'estimation.`
                  : 'Simulation non contractuelle. Aucune donnée personnelle demandée.'}
              </p>
            </aside>
          </form>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Estimation en direct et activation des options d'un service une fois sa formule choisie.
  // Purement indicatif : l'estimation enregistrée est recalculée par le serveur à partir des seuls choix.
  import { computeTotals, formatRange, type Range } from '../../lib/pricing';

  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  if (form) {
    const rate = Number(form.dataset.vatRate) || 0;
    const list = form.querySelector<HTMLUListElement>('[data-summary-lines]')!;
    const once = form.querySelector<HTMLElement>('[data-total-once]')!;
    const monthly = form.querySelector<HTMLElement>('[data-total-monthly]')!;
    const monthlyRow = form.querySelector<HTMLElement>('[data-monthly-row]')!;
    const empty = list.firstElementChild!;
    const ttc = ([min, max]: Range): Range => [computeTotals(min, rate).ttc, computeTotals(max, rate).ttc];

    const update = () => {
      const oneOff: Range = [0, 0];
      const perMonth: Range = [0, 0];
      const picked: { label: string; amount: Range; monthly: boolean }[] = [];

      form.querySelectorAll<HTMLFieldSetElement>('[data-group]').forEach((group) => {
        const needsBase = group.dataset.needsBase === 'true';
        const enabled = !needsBase || Boolean(group.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.value);
        const extras = group.querySelector<HTMLElement>('[data-extras]');
        extras?.classList.toggle('is-disabled', !enabled);
        extras?.querySelectorAll('input').forEach((input) => (input.disabled = !enabled));

        group.querySelectorAll<HTMLInputElement>('input[data-min]').forEach((input) => {
          if (input.disabled) return;
          const max = Number(input.max) || 99;
          const qty =
            input.type === 'number'
              ? Math.min(Math.max(Math.floor(Number(input.value)) || 0, 0), max)
              : input.checked
                ? 1
                : 0;
          if (!qty) return;
          const amount: Range = [Number(input.dataset.min) * qty, Number(input.dataset.max) * qty];
          const isMonthly = input.dataset.monthly === 'true';
          const target = isMonthly ? perMonth : oneOff;
          target[0] += amount[0];
          target[1] += amount[1];
          const [one, many] = (input.dataset.unit ?? '').split('|');
          const label = input.type === 'number' ? `${input.dataset.label} (${qty} ${qty > 1 ? many : one})` : input.dataset.label!;
          picked.push({ label, amount, monthly: isMonthly });
        });
      });

      list.replaceChildren(
        ...(picked.length
          ? picked.map(({ label, amount, monthly: isMonthly }) => {
              const li = document.createElement('li');
              const name = document.createElement('span');
              const price = document.createElement('span');
              name.textContent = label;
              price.textContent = `${formatRange(ttc(amount))}${isMonthly ? ' / mois' : ''}`;
              li.append(name, price);
              return li;
            })
          : [empty]),
      );
      once.textContent = formatRange(ttc(oneOff));
      monthly.textContent = `${formatRange(ttc(perMonth))} / mois`;
      monthlyRow.hidden = perMonth[1] === 0;
    };

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    update();
  }
</script>
