---
// Simulateur de devis, en quatre étapes : famille, type (formule), options, budget envisagé. Aucun prix n'est
// affiché ni envoyé au navigateur pendant les choix : l'estimation (total en fourchette, comparé au budget, avec une
// version ajustée si besoin) est calculée ici, côté serveur, à partir de src/data/quote-catalog.ts, puis enregistrée.
// Sans JavaScript, les étapes s'affichent l'une sous l'autre.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { UNIT_LABELS, type CatalogItem } from '../../data/quote-catalog';
import { services } from '../../data/content';
import { launch } from '../../data/site';
import { addonGroup, families, isMonthlyFamily, readInput, runSmartQuote } from '../../lib/pricing';
import { CRITERIA, PRIORITIES, PRIORITY_LABELS, weightsFor, type Criterion, type SmartInput } from '../../lib/smartquote';
import { parisNow } from '../../lib/hours';
import { clientKey, createQuote, toDraft } from '../../lib/quotes';

const familyList = families();
const addon = addonGroup();
let selection: SmartInput = { family: '', base: '', options: [], quantities: {}, complexity: {}, priorities: {}, budget: null };
let budgetText = '';
let error = '';

if (Astro.request.method === 'POST' && familyList.length > 0) {
  const data = await Astro.request.formData();
  // Champ piège rempli : un robot, on fait comme si de rien n'était
  if (data.get('site_web')) return Astro.redirect('/devis', 303);
  selection = readInput(data);
  budgetText = String(data.get('budget') ?? '').slice(0, 20);
  const family = familyList.find((group) => group.id === selection.family);
  const base = family?.items.find((item) => item.kind === 'base' && item.id === selection.base);

  if (!family) error = 'Choisissez d’abord ce que vous souhaitez réaliser.';
  else if (!base) error = `Choisissez un type de ${family.title.toLowerCase()}.`;
  else if (budgetText.trim() && selection.budget === null) error = 'Budget invalide : indiquez un montant en euros, par exemple 3000.';
  const result = error ? null : runSmartQuote(selection, parisNow().date);
  if (!result) {
    error ||= 'Ce projet ne peut pas être calculé.';
    Astro.response.status = 422;
  } else {
    try {
      const quote = await createQuote(
        toDraft(selection, result),
        await clientKey(Astro.request, () => Astro.clientAddress),
        // Client connecté : le devis apparaîtra dans son espace
        Astro.locals.user?.role === 'client' ? Astro.locals.user.id : undefined,
      );
      if (quote !== 'limite') return Astro.redirect(`/devis/${quote.id}`, 303);
      error = 'Vous avez créé beaucoup d’estimations en peu de temps : réessayez dans une heure.';
      Astro.response.status = 429;
    } catch (e) {
      console.error(e);
      error = "L'estimation n'a pas pu être enregistrée. Réessayez dans un instant.";
      Astro.response.status = 500;
    }
  }
}

const iconOf = (id: string) => services.find((s) => s.slug === id)?.icon ?? 'star';
const extrasOf = (items: CatalogItem[]) => items.filter((item) => item.kind !== 'base');
const STEPS = ['Votre projet', 'Le type', 'Les options', 'La complexité', 'Votre budget'];
// Critères de complexité utiles à chaque famille (pondération non nulle dans son profil)
const criteriaOf = (group: (typeof familyList)[number]) => CRITERIA.filter((c) => weightsFor(group)[c] > 0).join(' ');
// Questions sans jargon, une par critère : niveaux 0 (très simple) à 4 (très complexe)
const QUESTIONS: Record<Criterion, { question: string; answers: string[] }> = {
  design: {
    question: 'Quel rendu visuel souhaitez-vous ?',
    answers: ['Simple et efficace', 'Soigné, sur une base existante', 'Personnalisé à votre image', 'Très créatif, avec animations', 'Entièrement sur mesure'],
  },
  fonctionnel: {
    question: 'Votre projet a-t-il des fonctions ou des règles particulières ?',
    answers: ['Aucune', 'Quelques-unes, simples', 'Plusieurs, classiques', 'Nombreuses ou propres à votre métier', 'Très spécifiques, à concevoir ensemble'],
  },
  integrations: {
    question: 'Doit-il échanger avec d’autres outils ?',
    answers: ['Aucun', 'Un outil courant (agenda, réseaux sociaux)', 'Deux ou trois outils', 'Votre logiciel métier ou de caisse', 'Plusieurs logiciels synchronisés'],
  },
  contenus: {
    question: 'Quels contenus faut-il préparer ?',
    answers: ['Tout est prêt', 'Quelques textes à adapter', 'Une partie à créer', 'Beaucoup de contenus à organiser', 'Un grand volume ou un import de données'],
  },
  technique: {
    question: 'Avez-vous des contraintes particulières ?',
    answers: ['Aucune', 'Quelques préférences', 'Rapidité ou accessibilité importantes', 'Sécurité ou données sensibles', 'Fortes contraintes (affluence, réglementation)'],
  },
  delais: {
    question: 'Quel délai envisagez-vous ?',
    answers: ['Pas de date précise', 'Quelques mois', 'Un à deux mois', 'Quelques semaines', 'Très urgent'],
  },
};
const defaultPriority = (item: CatalogItem) => item.priority ?? (item.kind === 'quantity' ? 'importante' : 'facultative');
---

<BaseLayout
  title="Simulateur de devis"
  description="Décrivez votre projet en quelques clics (site vitrine, boutique en ligne, identité visuelle, application, maintenance) et recevez une estimation adaptée à votre budget."
>
  <PageHero
    eyebrow="Simulateur de devis"
    lead={
      launch.commercial
        ? 'Quatre questions, deux minutes : vous recevez une estimation adaptée à votre budget, puis un conseiller vous rappelle pour établir votre devis.'
        : 'Quatre questions, deux minutes : vous recevez une estimation adaptée à votre budget. Le studio est en préparation : cette estimation est une simulation, non contractuelle.'
    }
  >
    <Fragment slot="title">Décrivez votre projet, <em>on s'adapte.</em></Fragment>
  </PageHero>

  <section class="section section--tight surface-light-2" aria-label="Simulateur">
    <div class="container">
      {
        familyList.length === 0 ? (
          <div class="quote-empty card">
            <h2 class="quote-empty-title">Le simulateur arrive bientôt.</h2>
            <p>Nos tarifs sont en cours de finalisation : le simulateur ouvrira dès qu’ils seront prêts.</p>
            <a class="btn btn-primary" href="/contact">
              Nous contacter <Icon name="arrow" class="btn-arrow" />
            </a>
          </div>
        ) : (
          <form class="wizard card" method="post" novalidate data-wizard>
            <div class="hp" aria-hidden="true">
              <label>
                Ne pas remplir <input type="text" name="site_web" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <ol class="wizard-progress" aria-label="Étapes">
              {STEPS.map((label, i) => (
                <li data-progress={i + 1} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="wizard-progress-num">{i + 1}</span> {label}
                </li>
              ))}
            </ol>

            {error && (
              <p class="admin-alert" role="alert">
                {error}
              </p>
            )}

            <fieldset class="wizard-step" data-step="1">
              <legend class="wizard-title">Que souhaitez-vous réaliser ?</legend>
              <div class="family-cards">
                {familyList.map((group) => (
                  <label class="family-card">
                    <input
                      type="radio"
                      name="family"
                      value={group.id}
                      checked={selection.family === group.id}
                      required
                      data-monthly={isMonthlyFamily(group) ? 'true' : undefined}
                      data-title={group.title}
                      data-criteria={criteriaOf(group)}
                    />
                    <span class="service-icon">
                      <Icon name={iconOf(group.id)} />
                    </span>
                    <span class="family-card-title">{group.title}</span>
                    <span class="family-card-text">{group.intro}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="wizard-step" data-step="2">
              <legend class="wizard-title">Quel type de projet ?</legend>
              {familyList.map((group) => (
                <div class="quote-items" data-family-panel={group.id}>
                  <p class="wizard-panel-title">{group.title}</p>
                  {group.items
                    .filter((item) => item.kind === 'base')
                    .map((item) => (
                      <label class="quote-item quote-item--plain">
                        <input
                          type="radio"
                          name={`base:${group.id}`}
                          value={item.id}
                          checked={selection.family === group.id && selection.base === item.id}
                          data-label={item.label}
                        />
                        <span class="quote-item-text">
                          <span class="quote-item-label">{item.label}</span>
                          {item.detail && <span class="quote-item-detail">{item.detail}</span>}
                        </span>
                      </label>
                    ))}
                </div>
              ))}
            </fieldset>

            <fieldset class="wizard-step" data-step="3">
              <legend class="wizard-title">Des options ?</legend>
              <p class="wizard-hint">
                Facultatif : cochez ce qui vous intéresse et dites-nous ce qui compte le plus. Si le budget est serré, nous
                garderons l'indispensable et proposerons de reporter le reste.
              </p>
              {[...familyList, ...(addon ? [addon] : [])].map((group) => {
                const extras = extrasOf(group.items);
                return (
                  extras.length > 0 && (
                    <div class="quote-items" data-family-panel={group === addon ? undefined : group.id}>
                      <p class="wizard-panel-title">{group.title}</p>
                      {extras.map((item) => (
                        <div class="quote-option" data-included-in={item.includedIn?.join(' ')}>
                          {item.kind === 'quantity' ? (
                            <div class="quote-item quote-item--qty">
                              <span class="quote-item-text">
                                <label class="quote-item-label" for={`qty-${item.id}`}>
                                  {item.label}
                                </label>
                                <span class="quote-item-detail">
                                  {item.detail ?? `Nombre de ${UNIT_LABELS[item.unit][1]}`}
                                </span>
                              </span>
                              <input
                                class="input quote-qty"
                                id={`qty-${item.id}`}
                                name={`qty:${item.id}`}
                                type="number"
                                min="0"
                                max={item.max ?? 99}
                                step="1"
                                inputmode="numeric"
                                value={selection.quantities[item.id] || 0}
                                data-label={item.label}
                              />
                            </div>
                          ) : (
                            <label class="quote-item quote-item--plain">
                              <input
                                type="checkbox"
                                name="option"
                                value={item.id}
                                checked={selection.options.includes(item.id)}
                                data-label={item.label}
                              />
                              <span class="quote-item-text">
                                <span class="quote-item-label">{item.label}</span>
                                {item.detail && <span class="quote-item-detail">{item.detail}</span>}
                                <span class="quote-option-included">Incluse dans la formule choisie : rien à ajouter.</span>
                              </span>
                            </label>
                          )}
                          <label class="quote-option-priority">
                            <span>Pour vous, c'est</span>
                            <select class="input" name={`prio:${item.id}`}>
                              {PRIORITIES.map((p) => (
                                <option value={p} selected={(selection.priorities[item.id] ?? defaultPriority(item)) === p}>
                                  {PRIORITY_LABELS[p].toLowerCase()}
                                </option>
                              ))}
                            </select>
                          </label>
                        </div>
                      ))}
                    </div>
                  )
                );
              })}
            </fieldset>

            <fieldset class="wizard-step" data-step="4">
              <legend class="wizard-title">Pour affiner l'estimation</legend>
              <p class="wizard-hint">Quelques questions simples : sans réponse, nous comptons une complexité moyenne.</p>
              {CRITERIA.map((criterion) => (
                <fieldset class="wizard-question" data-criterion={criterion}>
                  <legend class="wizard-panel-title">{QUESTIONS[criterion].question}</legend>
                  <div class="choices">
                    {QUESTIONS[criterion].answers.map((answer, level) => (
                      <label class="choice">
                        <input type="radio" name={`cx:${criterion}`} value={level} checked={selection.complexity[criterion] === level} />
                        <span>{answer}</span>
                      </label>
                    ))}
                    <label class="choice">
                      <input type="radio" name={`cx:${criterion}`} value="" checked={selection.complexity[criterion] === undefined} />
                      <span>Je ne sais pas</span>
                    </label>
                  </div>
                </fieldset>
              ))}
            </fieldset>

            <fieldset class="wizard-step" data-step="5">
              <legend class="wizard-title">Avez-vous un budget maximal ?</legend>
              <p class="wizard-hint">
                Facultatif. Il ne change pas nos prix : il nous sert à vous proposer ce qui est réalisable, quitte à
                reporter une partie du projet.
              </p>
              <p class="wizard-recap" data-recap hidden></p>
              <div class="field wizard-budget">
                <label for="budget" data-budget-label>Budget maximal TTC, en euros</label>
                <input class="input" id="budget" name="budget" inputmode="decimal" maxlength="12" value={budgetText} placeholder="Par exemple 3000" />
              </div>
            </fieldset>

            <div class="wizard-nav">
              <button class="btn btn-ghost" type="button" data-prev hidden>
                Retour
              </button>
              <p class="field-error" role="alert" data-step-error></p>
              <button class="btn btn-primary" type="button" data-next hidden>
                Suivant <Icon name="arrow" class="btn-arrow" />
              </button>
              <button class="btn btn-warm" type="submit" data-submit>
                Voir mon estimation <Icon name="arrow" class="btn-arrow" />
              </button>
            </div>
            <p class="form-note">
              {launch.commercial
                ? 'Aucune donnée personnelle demandée pour l’estimation.'
                : 'Simulation non contractuelle. Aucune donnée personnelle demandée.'}
            </p>
          </form>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Parcours pas à pas : une étape à la fois, seules les formules et options de la famille choisie sont montrées
  const form = document.querySelector<HTMLFormElement>('[data-wizard]');
  if (form) {
    form.classList.add('is-wizard');
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const progress = [...form.querySelectorAll<HTMLElement>('[data-progress]')];
    const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const stepError = form.querySelector<HTMLElement>('[data-step-error]')!;
    const recap = form.querySelector<HTMLElement>('[data-recap]')!;
    let current = 0;

    const family = () => form.querySelector<HTMLInputElement>('input[name="family"]:checked');
    const base = () => {
      const f = family();
      return f ? form.querySelector<HTMLInputElement>(`input[name="base:${f.value}"]:checked`) : null;
    };

    const filter = () => {
      const f = family();
      form.querySelectorAll<HTMLElement>('[data-family-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.familyPanel !== f?.value;
      });
      // Questions de complexité utiles à la famille choisie
      const criteria = (f?.dataset.criteria ?? '').split(' ');
      form.querySelectorAll<HTMLElement>('[data-criterion]').forEach((question) => {
        question.hidden = Boolean(f) && !criteria.includes(question.dataset.criterion!);
      });
      // Options déjà comprises dans la formule choisie : affichées comme incluses, pas à cocher
      const chosen = base()?.value ?? '';
      form.querySelectorAll<HTMLElement>('.quote-option').forEach((row) => {
        const included = Boolean(chosen) && (row.dataset.includedIn ?? '').split(' ').includes(chosen);
        row.classList.toggle('is-included', included);
        row.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => (field.disabled = included));
      });
      const label = form.querySelector<HTMLElement>('[data-budget-label]');
      if (label) label.textContent = f?.dataset.monthly === 'true' ? 'Budget mensuel maximal TTC, en euros' : 'Budget maximal TTC, en euros';
    };

    const updateRecap = () => {
      const picked = [...form.querySelectorAll<HTMLInputElement>('input[name="option"]:checked, .quote-qty')]
        .filter((input) => !input.disabled && !input.closest<HTMLElement>('[hidden]') && (input.type !== 'number' || Number(input.value) > 0))
        .map((input) => (input.type === 'number' ? `${input.dataset.label} (${input.value})` : input.dataset.label));
      const parts = [family()?.dataset.title, base()?.dataset.label, ...picked].filter(Boolean);
      recap.textContent = parts.length ? `Votre projet : ${parts.join(' · ')}` : '';
      recap.hidden = !parts.length;
    };

    const show = (index: number, scroll = true) => {
      current = index;
      steps.forEach((step, i) => (step.hidden = i !== index));
      progress.forEach((item, i) => {
        item.toggleAttribute('aria-current', i === index);
        if (i === index) item.setAttribute('aria-current', 'step');
        item.classList.toggle('is-done', i < index);
      });
      prev.hidden = index === 0;
      next.hidden = index === steps.length - 1;
      submit.hidden = index !== steps.length - 1;
      stepError.textContent = '';
      filter();
      updateRecap();
      if (scroll) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const check = () => {
      if (current === 0 && !family()) return 'Choisissez ce que vous souhaitez réaliser.';
      if (current === 1 && !base()) return 'Choisissez un type de projet.';
      return '';
    };

    next.addEventListener('click', () => {
      const message = check();
      if (message) stepError.textContent = message;
      else show(current + 1);
    });
    prev.addEventListener('click', () => show(current - 1));
    form.addEventListener('change', () => {
      stepError.textContent = '';
      filter();
      updateRecap();
    });
    // Entrée dans un champ : passe à l'étape suivante plutôt que d'envoyer le formulaire trop tôt
    form.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && current < steps.length - 1 && (event.target as HTMLElement).tagName === 'INPUT') {
        event.preventDefault();
        next.click();
      }
    });

    show(0, false);
  }
</script>
