---
// Politique de confidentialité (RGPD, art. 13) : décrit le fonctionnement réel du site, vérifié dans le code
// (src/pages/api/*.ts, src/lib/forms.ts, src/lib/access.ts, src/lib/quotes.ts, src/scripts/live.ts,
// src/components/OfficeMap.astro).
// Toute évolution technique (nouveau service, mesure d'audience…) doit être reportée ici. Suivi : AUDIT-LEGAL.md
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { legal, host, launch, storage } from '../data/site';
import { getSite } from '../lib/store';
import { mailEnabled } from '../lib/forms';
import { RETENTION_DAYS } from '../lib/quotes';

const site = getSite(Astro.locals);

// Responsable du traitement : la société si elle existe, sinon la personne physique porteuse du projet
const controller = legal.legalName ?? legal.publisher ?? site.founder.name;
// État réel des formulaires (mêmes conditions que src/pages/contact.astro et src/pages/api/*.ts)
const contactOpen = launch.mailbox && mailEnabled();
const applyOpen = contactOpen && launch.recruitment;
const phoneHref = site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : null;
const updated = new Date('2026-10-30').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Politique de confidentialité"
  description={`Comment ${site.name} utilise les données transmises via ses formulaires, combien de temps et comment exercer vos droits.`}
>
  <PageHero eyebrow="Informations" compact>
    <Fragment slot="title">Politique de <em>confidentialité.</em></Fragment>
  </PageHero>

  <section class="section surface-light" aria-label="Politique de confidentialité">
    <div class="container prose">
      <h2>Responsable du traitement</h2>
      <p>
        {controller
          ? `${controller}, porteur du projet ${site.name}${legal.legalName ? '' : ' (projet en préparation, non immatriculé)'}`
          : `L'éditeur de ${site.name} (identité à compléter, voir les mentions légales)`},
        {' '}{site.address.join(', ')}. Pour toute question sur vos données :
        {' '}
        {
          launch.mailbox ? (
            <a href={`mailto:${site.email}`}>{site.email}</a>
          ) : phoneHref ? (
            <Fragment>
              par téléphone au <a href={phoneHref}>{site.phone}</a> (une adresse e-mail dédiée sera indiquée ici dès la
              mise en service de notre messagerie)
            </Fragment>
          ) : (
            'coordonnées à compléter'
          )
        }.
      </p>

      <h2>Ce que fait le site aujourd'hui</h2>
      <p>
        Le site ne crée pas de compte visiteur et n'utilise ni mesure d'audience ni publicité.
        {
          contactOpen
            ? " Les messages envoyés via ses formulaires ne sont pas enregistrés sur le site : ils sont transmis par e-mail, puis traités depuis notre messagerie."
            : " Ses formulaires sont actuellement fermés : aucune donnée n'est collectée par leur biais. Les sections « Formulaire de contact » et « Candidatures » décrivent les traitements qui s'appliqueront à leur ouverture."
        }
      </p>
      <p>
        Même sans formulaire, la consultation du site entraîne des traitements techniques : votre navigateur transmet
        votre adresse IP à l'hébergeur pour afficher les pages (voir « Destinataires et prestataires ») et, sur les pages
        qui affichent une carte, à OpenStreetMap (voir « Services tiers affichés »). Ces traitements reposent sur notre
        intérêt légitime à faire fonctionner et à sécuriser le site (RGPD, art. 6.1.f).
      </p>

      <h2>Formulaire de contact{!contactOpen && ' (fermé pour le moment)'}</h2>
      <ul class="legal-points">
        <li>
          <strong>Données</strong> : nom, e-mail et message (obligatoires, sans eux nous ne pouvons pas vous répondre) ;
          entreprise, téléphone, type de projet et budget (facultatifs).
        </li>
        <li>
          <strong>Finalité</strong> : répondre à votre demande et, si vous le souhaitez, préparer un devis.
        </li>
        <li>
          <strong>Base légale</strong> : les mesures précontractuelles prises à votre demande (RGPD, art. 6.1.b) ou, pour
          une simple question, notre intérêt légitime à vous répondre (art. 6.1.f).
        </li>
        <li>
          <strong>Durée</strong> : le temps de traiter votre demande, puis 3 ans au plus après notre dernier échange. Si
          un contrat est conclu, les documents utiles sont conservés pendant la durée légale applicable.
        </li>
      </ul>

      <h2>Simulateur de devis</h2>
      <ul class="legal-points">
        <li>
          <strong>Estimation</strong> : les prestations choisies, la tranche de budget envisagée et l'estimation
          calculée. Aucune donnée personnelle n'est demandée pour créer une estimation. Pour limiter les abus, une empreinte de votre adresse IP
          (qui ne permet pas de la retrouver directement) est gardée une heure.
        </li>
        {launch.commercial && (
          <li>
            <strong>Demande de rappel</strong> : si vous demandez à être rappelé par un conseiller, vos prénom, nom et
            téléphone (obligatoires), e-mail et précisions sur votre projet (facultatifs), pour vous rappeler et établir
            votre devis (mesures précontractuelles prises à votre demande, RGPD, art. 6.1.b).
          </li>
        )}
        {launch.commercial && (
          <li>
            <strong>Signature</strong> : vos prénom, nom et e-mail, et la date de signature, pour établir le contrat
            (RGPD, art. 6.1.b).
          </li>
        )}
        <li>
          <strong>Durée</strong> : un devis non signé, avec les coordonnées éventuellement laissées, est supprimé
          automatiquement 30 jours après la fin de sa validité (soit {RETENTION_DAYS} jours après sa création pour une
          estimation).{launch.commercial && " Un devis signé est conservé pendant la durée du contrat, puis 5 ans (délai de prescription, code civil, art. 2224), ou plus longtemps si une obligation légale l'impose."}
        </li>
      </ul>

      <h2>Candidatures{!applyOpen && ' (aucun recrutement ouvert pour le moment)'}</h2>
      <ul class="legal-points">
        <li>
          <strong>Données</strong> : prénom, nom, e-mail, type de contrat souhaité, lien vers un portfolio ou GitHub, CV
          et message (obligatoires pour étudier votre candidature) ; téléphone, LinkedIn, disponibilité et source
          (facultatifs). Ne transmettez que des informations utiles à l'évaluation de vos compétences.
        </li>
        <li>
          <strong>Finalité</strong> : étudier votre candidature et organiser le recrutement.
        </li>
        <li>
          <strong>Base légale</strong> : les mesures précontractuelles prises à votre demande (RGPD, art. 6.1.b).
        </li>
        <li>
          <strong>Durée</strong> : jusqu'à la fin du processus de recrutement. Si vous n'êtes pas retenu, votre
          candidature est supprimée, sauf si vous avez coché la case pour qu'elle soit conservée en vue d'autres postes :
          elle l'est alors 2 ans au plus après notre dernier échange, et vous pouvez retirer cet accord à tout moment.
        </li>
      </ul>

      <h2>Destinataires et prestataires</h2>
      <p>
        Vos messages et candidatures ne sont lus que par les personnes chargées d'y répondre chez {site.name}. Ils ne
        sont ni vendus ni cédés. Pour fonctionner, le site s'appuie sur ces prestataires :
      </p>
      <ul class="legal-points">
        <li>
          <strong>{host.name}</strong> (États-Unis), hébergeur : il reçoit les requêtes envoyées au site, dont le
          contenu des formulaires au moment de l'envoi, et conserve des journaux techniques (adresse IP, pages
          demandées) selon sa propre politique.
        </li>
        <li>
          <strong>{storage.name}</strong>, base de données : elle conserve les devis du simulateur et les réglages du
          site.
        </li>
        <li>
          <strong>Resend</strong> (États-Unis), service d'envoi d'e-mails : il acheminera le message des formulaires vers
          notre boîte de réception{contactOpen ? '' : ' (pas encore utilisé : formulaires fermés)'}.
        </li>
        <li>
          <strong>Notre fournisseur de messagerie</strong>, qui hébergera notre boîte de réception
          {contactOpen ? '' : ' (pas encore en service)'}.
        </li>
      </ul>
      <p>
        Vercel et Resend sont des sociétés américaines : des données peuvent donc être transférées hors de l'Union
        européenne. Toutes deux déclarent adhérer au cadre de protection des données UE–États-Unis (Data Privacy
        Framework), reconnu par la Commission européenne.
      </p>

      <h2>Cookies et stockage dans votre navigateur</h2>
      <ul class="legal-points">
        <li>
          <strong>Aucun cookie</strong> n'est déposé chez les visiteurs du site. Seul l'espace d'administration, réservé
          à l'équipe, utilise deux cookies nécessaires : l'un maintient la connexion (30 jours), l'autre retient le
          choix de prévisualiser le site lorsqu'il est fermé (jusqu'à la fermeture du navigateur).
        </li>
        <li>
          <strong>Stockage de session</strong> : pour recharger les pages ouvertes quand le site est mis à jour, sans
          boucle de rechargements, le navigateur garde un simple numéro de version du site. Il ne vous identifie pas
          et s'efface à la fermeture de l'onglet.
        </li>
      </ul>
      <p>Ces éléments, strictement nécessaires au fonctionnement du site, ne demandent pas votre consentement.</p>

      <h2>Services tiers affichés</h2>
      <ul class="legal-points">
        <li>
          <strong>Carte</strong> : le fond de carte des pages Contact et L'agence provient des serveurs d'OpenStreetMap (Royaume-Uni),
          qui reçoivent votre adresse IP lorsque la carte s'affiche.
        </li>
        <li>
          <strong>Itinéraire</strong> : Google Maps, Plans (Apple) ou Waze ne sont contactés que si vous choisissez de
          les ouvrir ; leur propre politique de confidentialité s'applique alors.
        </li>
        <li><strong>Polices de caractères</strong> : hébergées sur ce site, sans appel à un service externe.</li>
      </ul>

      <h2>Vos droits</h2>
      <p>
        Vous pouvez accéder à vos données, les rectifier, les effacer, en limiter l'utilisation, vous opposer à un
        traitement fondé sur notre intérêt légitime, retirer à tout moment l'accord donné pour conserver votre
        candidature, et demander la portabilité des données fournies dans le cadre de mesures précontractuelles.
        {
          launch.mailbox ? (
            <Fragment> Écrivez à <a href={`mailto:${site.email}`}>{site.email}</a></Fragment>
          ) : phoneHref ? (
            <Fragment> Contactez-nous par téléphone au <a href={phoneHref}>{site.phone}</a></Fragment>
          ) : (
            ' Contactez l\'éditeur (coordonnées dans les mentions légales)'
          )
        }
        {' '}: nous répondons dans un délai d'un mois. Si vous estimez,
        après nous avoir contactés, que vos droits ne sont pas respectés, vous pouvez adresser une réclamation à la
        CNIL (<a href="https://www.cnil.fr/fr/plaintes" rel="noopener">cnil.fr/fr/plaintes</a>).
      </p>

      <p class="form-note">Dernière mise à jour : {updated}.</p>
      <p><a href="/">← Retour à l'accueil</a></p>
    </div>
  </section>
</BaseLayout>
