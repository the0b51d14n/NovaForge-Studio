---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HiringBanner from '../components/HiringBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, method, projects } from '../data/content';
import { site } from '../data/site';

// Réalisations et témoignages : sections affichées dès qu'il y a de vrais projets clients
const featured = projects.slice(0, 3);
const testimonials = projects.filter((p) => p.testimonial);
const methodNum = featured.length ? '04' : '03';
const reviewsNum = featured.length ? '05' : '04';
const marquee = ['Sites vitrines', 'Boutiques en ligne', 'Identité visuelle', 'Applications sur mesure', 'Maintenance'];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero surface-dark" aria-labelledby="hero-title" data-stardust-host>
    <canvas class="stardust" data-stardust aria-hidden="true"></canvas>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Agence digitale · {site.area}{site.founded && ` · Depuis ${site.founded}`}</p>
        <h1 class="hero-title" id="hero-title">
          <span class="line"><span>Forger votre</span></span>
          <span class="line"><span>présence</span></span>
          <span class="line"><span><em>numérique.</em></span></span>
        </h1>
        <p class="hero-lead">
          Le studio web et design fondé par <strong>un développeur freelance du Nord</strong>, pour les TPE, PME et
          jeunes entreprises. Chaque projet est suivi de A à Z, du premier rendez-vous jusqu'à la mise en ligne.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact">Démarrer un projet <Icon name="arrow" class="btn-arrow" /></a>
          {
            featured.length ? (
              <a class="btn btn-ghost" href="/realisations">Voir nos réalisations</a>
            ) : (
              <a class="btn btn-ghost" href="/services">Découvrir nos services</a>
            )
          }
        </div>
      </div>

      <div class="hero-art" data-parallax>
        <div class="hero-art-glow" aria-hidden="true"></div>
        <div class="hero-orbit" aria-hidden="true"></div>
        <div class="hero-orbit hero-orbit--inner" aria-hidden="true"></div>
        <Logo variant="mark" tone="dark" large class="hero-logo" />

        <a class="hiring-badge" href="/carrieres/developpeur-web-junior" aria-label="On recrute : voir l'offre de développeur web junior">
          <svg viewBox="0 0 160 160" aria-hidden="true" focusable="false">
            <defs>
              <path id="badge-circle" d="M80,80 m-62,0 a62,62 0 1,1 124,0 a62,62 0 1,1 -124,0"></path>
            </defs>
            <text>
              <textPath href="#badge-circle" textLength="386" lengthAdjust="spacing">ON RECRUTE ✦ DÉVELOPPEUR WEB JUNIOR ✦</textPath>
            </text>
          </svg>
          <span class="hiring-badge-core" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>

    <div class="container">
      <ul class="hero-meta">
        {site.founded && <li><Icon name="star" />Est. {site.founded}</li>}
        <li><Icon name="star" />{site.city} · Nord</li>
        <li><Icon name="star" />Web · Design · Sur mesure</li>
        <li><Icon name="star" />Premier rendez-vous et devis gratuits</li>
      </ul>
    </div>
  </section>

  <!-- ============ BANDEAU ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marquee, ...marquee].map((item) => (
          <span>
            {item} <Icon name="star" />
          </span>
        ))
      }
    </div>
  </div>

  <!-- ============ L'AGENCE ============ -->
  <section class="section surface-light" aria-labelledby="intro-title">
    <div class="container">
      <SectionHead num="01" label="Notre histoire" titleId="intro-title">
        Un freelance<br /><em>qui monte sa boîte.</em>
      </SectionHead>

      <div class="intro-grid">
        <div data-reveal>
          <p class="lead-text">
            NovaForge Studio, c'est d'abord un développeur freelance du Nord, qui accompagne ses clients du premier
            rendez-vous jusqu'à la mise en ligne.
          </p>
          <div class="prose-muted">
            <p>
              Pour aller plus loin, il structure son activité et crée NovaForge Studio. Il pilote toujours chaque projet
              lui-même, avec la même proximité qu'en freelance.
            </p>
            <p>
              Prochaine étape : le studio recrute son premier collaborateur pour passer d'une activité solo à une vraie
              équipe.
            </p>
          </div>
          <a class="link-arrow" href="/agence">Découvrir l'agence <Icon name="arrow" /></a>
        </div>

        <ul class="pillars">
          <li class="pillar" data-reveal>
            <span class="pillar-mark" aria-hidden="true">A→Z</span>
            <h3>Suivi de bout en bout</h3>
            <p>Chaque projet est accompagné du premier rendez-vous jusqu'à la mise en ligne, et au-delà.</p>
          </li>
          <li class="pillar" data-reveal style="--d:.08s">
            <span class="pillar-mark" aria-hidden="true">1:1</span>
            <h3>Un interlocuteur unique</h3>
            <p>Une structure légère et flexible, qui s'adapte à votre rythme et à vos priorités.</p>
          </li>
          <li class="pillar" data-reveal style="--d:.16s">
            <span class="pillar-mark" aria-hidden="true">59</span>
            <h3>Ancrés dans le Nord</h3>
            <p>Nous prenons le temps de comprendre votre métier, vos clients et votre territoire.</p>
          </li>
        </ul>
      </div>

      <ol class="journey" aria-label="De freelance à agence">
        <li class="journey-step" data-reveal>
          <span class="journey-when">Au départ</span>
          <strong>Un freelance</strong>
          <span>Un développeur web indépendant, au service de ses clients.</span>
        </li>
        <li class="journey-step" data-reveal style="--d:.08s">
          <span class="journey-when">{site.founded ?? "Aujourd'hui"}</span>
          <strong>Un studio</strong>
          <span>L'activité se structure : création de NovaForge Studio.</span>
        </li>
        <li class="journey-step journey-step--now" data-reveal style="--d:.16s">
          <span class="journey-when">Prochaine étape</span>
          <strong>Une équipe</strong>
          <span>Premier recrutement : un développeur web junior pour grandir avec le studio.</span>
          <a class="journey-link" href="/carrieres/developpeur-web-junior">Et si c'était vous ? <Icon name="arrow" /></a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section surface-light-2" aria-labelledby="services-title">
    <div class="container">
      <SectionHead num="02" label="Services" titleId="services-title">
        Ce que nous <em>forgeons</em> pour vous.
      </SectionHead>

      <div class="service-grid">
        {
          services.map((service, i) => (
            <a
              class:list={['service-card', { 'service-card--featured': i === 0 }]}
              href={`/services#${service.slug}`}
              data-reveal
              style={`--d:${i * 0.06}s`}
            >
              {i === 0 && <Icon name="star" class="service-deco" />}
              <span class="service-icon">
                <Icon name={service.icon} />
              </span>
              <h3>{service.title}</h3>
              <p>{service.short}</p>
              <ul class="chips">
                {service.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <span class="service-more">
                En savoir plus <Icon name="arrow" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CHIFFRES ============ -->
  <section class="section section--tight surface-dark" aria-label="NovaForge Studio en quelques chiffres">
    <div class="container">
      <ul class="stats" data-reveal>
        <li class="stat"><span class="stat-value">A→Z</span><span class="stat-label">Chaque projet suivi du premier rendez-vous à la mise en ligne</span></li>
        <li class="stat"><span class="stat-value">1</span><span class="stat-label">Interlocuteur unique pour chaque client</span></li>
        <li class="stat"><span class="stat-value">48 h</span><span class="stat-label">Pour répondre à votre demande, jours ouvrés</span></li>
        <li class="stat"><span class="stat-value">0 €</span><span class="stat-label">Premier rendez-vous et devis, sans engagement</span></li>
      </ul>
    </div>
  </section>

  <!-- ============ RÉALISATIONS ============ -->
  {
    featured.length > 0 && (
      <section class="section surface-light" aria-labelledby="work-title">
        <div class="container">
          <SectionHead num="03" label="Réalisations" titleId="work-title">
            Des projets <em>forgés</em> avec nos clients.
          </SectionHead>

          <div class="projects-grid projects-grid--3">
            {featured.map((project) => <ProjectCard project={project} />)}
          </div>

          <div class="section-foot">
            <a class="link-arrow" href="/realisations">
              Toutes nos réalisations <Icon name="arrow" />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ MÉTHODE ============ -->
  <section class="section surface-light-2" aria-labelledby="method-title">
    <div class="container">
      <SectionHead num={methodNum} label="Méthode" titleId="method-title">
        De la première idée<br /><em>à la mise en ligne.</em>
      </SectionHead>
      <Steps steps={method} />
    </div>
  </section>

  <!-- ============ TÉMOIGNAGES ============ -->
  {
    testimonials.length > 0 && (
      <section class="section surface-light" aria-labelledby="reviews-title">
        <div class="container">
          <SectionHead num={reviewsNum} label="Ils nous font confiance" titleId="reviews-title">
            La proximité, <em>ça se ressent.</em>
          </SectionHead>

          <div class="testimonials">
            {testimonials.map((p, i) => (
              <figure class="testimonial card" data-reveal style={`--d:${i * 0.08}s`}>
                <Icon name="star" />
                <blockquote>
                  <p>« {p.testimonial!.quote} »</p>
                </blockquote>
                <figcaption>
                  <span class="avatar" aria-hidden="true">
                    {p.testimonial!.author.charAt(0)}
                  </span>
                  <span>
                    {p.testimonial!.author}
                    <small>{p.name}</small>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <HiringBanner />
  <CtaBand />
</BaseLayout>
