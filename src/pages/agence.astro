---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import HiringBanner from '../components/HiringBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import OfficeMap from '../components/OfficeMap.astro';
import { site } from '../data/site';

const founderName = site.founder.name ?? 'Le fondateur';
const founderInitial = (site.founder.name ?? 'Fondateur').charAt(0);

// Du freelance à l'agence : les étapes de la création du studio
const timeline = [
  {
    year: 'Au départ',
    title: 'Les débuts en freelance',
    text: 'Développeur web indépendant, le fondateur conçoit des sites et accompagne ses clients de A à Z.',
  },
  {
    year: site.founded ? String(site.founded) : "Aujourd'hui",
    title: 'Création de NovaForge Studio',
    text: 'Il structure son activité et crée le studio, sans perdre la proximité du freelance.',
  },
  {
    year: 'Prochaine étape',
    title: 'Premier recrutement',
    text: 'Le studio recrute son premier développeur web junior.',
  },
  {
    year: 'Demain',
    title: 'Une vraie équipe',
    text: "Le premier recrutement n'est qu'un début : l'agence grandira avec ses collaborateurs.",
  },
];

const values = [
  { title: 'Proximité', text: 'Un lien direct avec chaque client, sans intermédiaire ni jargon.' },
  { title: 'Flexibilité', text: "Une structure légère qui s'adapte à vos délais, à votre budget et à vos priorités." },
  { title: 'De A à Z', text: "Du premier rendez-vous à la mise en ligne, puis dans la durée avec la maintenance." },
  { title: 'Transparence', text: 'Des devis clairs, des points réguliers, et toujours la même personne au bout du fil.' },
];
---

<BaseLayout
  title="L'agence"
  description="NovaForge Studio, agence digitale de la métropole lilloise créée par un développeur freelance : notre histoire, nos valeurs et notre équipe."
>
  <PageHero
    eyebrow="L'agence"
    lead="NovaForge Studio est née de l'activité d'un développeur freelance du Nord. Il la transforme aujourd'hui en une vraie agence, et recrute son premier collaborateur."
  >
    <Fragment slot="title">D'un freelance <em>à une agence.</em></Fragment>
  </PageHero>

  <!-- ============ HISTOIRE ============ -->
  <section class="section surface-light" aria-labelledby="story-title">
    <div class="container">
      <SectionHead num="01" label="Le mot du fondateur" titleId="story-title">
        Un freelance<br /><em>qui monte sa boîte.</em>
      </SectionHead>

      <div class="story-grid">
        <figure class="founder-quote" data-reveal>
          <blockquote>
            <p class="statement">
              « J'ai commencé seul, en freelance. Avec NovaForge Studio, je donne une vraie structure à mon activité,
              <em>sans perdre ce qui fait la différence.</em> »
            </p>
            <p>
              Un seul interlocuteur, de la proximité, des projets suivis de A à Z : c'est la force du freelance, et
              c'est ce que le studio garde au cœur de son fonctionnement.
            </p>
            <p>
              Je cherche maintenant la première personne avec qui faire grandir le studio : quelqu'un qui ne sera pas
              un simple exécutant, mais qui participera vraiment aux décisions.
            </p>
          </blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{founderInitial}</span>
            <span>{founderName}<small>{site.founder.role} de {site.name}</small></span>
          </figcaption>
        </figure>

        <ol class="timeline">
          {
            timeline.map((item, i) => (
              <li class="tl-item" data-reveal style={`--d:${i * 0.08}s`}>
                <p class="tl-year">{item.year}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ VALEURS ============ -->
  <section class="section surface-light-2" aria-labelledby="values-title">
    <div class="container">
      <SectionHead num="02" label="Nos valeurs" titleId="values-title">
        Ce qui nous <em>guide.</em>
      </SectionHead>

      <ul class="values">
        {
          values.map((value, i) => (
            <li class="value card" data-reveal style={`--d:${i * 0.06}s`}>
              <Icon name="star" />
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ ÉQUIPE ============ -->
  <section class="section surface-light" aria-labelledby="team-title">
    <div class="container">
      <SectionHead num="03" label="L'équipe" titleId="team-title">
        Petite équipe,<br /><em>grande implication.</em>
      </SectionHead>

      <ul class="team">
        <li class="member card" data-reveal>
          <span class="avatar" aria-hidden="true">{founderInitial}</span>
          <p class="member-role">{site.founder.role}{site.founder.name && ` · ${site.founder.name}`}</p>
          <h3>Ancien freelance, développeur &amp; designer</h3>
          <p>
            Il a lancé l'activité seul et pilote chaque projet, du premier rendez-vous à la mise en ligne. Il reste
            l'interlocuteur direct de nos clients.
          </p>
        </li>
        <li class="member member--open card" data-reveal style="--d:.08s">
          <span class="avatar" aria-hidden="true">?</span>
          <p class="member-role">Poste ouvert · 1er recrutement</p>
          <h3>Vous ?</h3>
          <p>Le premier salarié du studio : un développeur web junior, en alternance ou en CDI.</p>
          <a class="link-arrow" href="/carrieres/developpeur-web-junior">Voir l'offre <Icon name="arrow" /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ LIEU ============ -->
  <section class="section surface-light-2" id="nous-trouver" aria-labelledby="place-title">
    <div class="container">
      <SectionHead num="04" label="Nous trouver" titleId="place-title">
        Bienvenue<br /><em>chez nous.</em>
        <Fragment slot="intro">
          Le studio est installé à {site.city}, dans la métropole lilloise, aux portes de Tourcoing.
        </Fragment>
      </SectionHead>

      <div class="place-grid">
        <OfficeMap />
      </div>
    </div>
  </section>

  <HiringBanner />
  <CtaBand />
</BaseLayout>
