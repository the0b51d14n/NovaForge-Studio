---
// Page « site fermé » : quand le site est verrouillé (depuis /administration), tout visiteur y est
// redirigé par src/lib/middleware.ts, administrateur compris. La connexion se fait sur /administration ;
// une fois connecté, l'administrateur trouve ici de quoi consulter le site en aperçu.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { ADMIN_PATH, LOCK_PATH, isPreviewing, startPreview, stopPreview } from '../lib/access';
import { LOCK_REASONS } from '../data/lock-reasons';

const { isAdmin, settings } = Astro.locals;
if (!settings.locked) return Astro.redirect('/');

if (isAdmin && Astro.request.method === 'POST') {
  const action = (await Astro.request.formData()).get('action');
  if (action === 'preview-on') {
    startPreview(Astro.cookies);
    return Astro.redirect('/', 303);
  }
  if (action === 'preview-off') {
    stopPreview(Astro.cookies);
    return Astro.redirect(LOCK_PATH, 303);
  }
}
const previewing = isAdmin && isPreviewing(Astro.cookies);

const reason = LOCK_REASONS[settings.lockReason] ?? LOCK_REASONS.fermeture;
// Interruption courte : « 503 » indique aux moteurs de recherche de repasser plus tard sans oublier le site
if (reason.temporary) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '3600');
}
---

<BaseLayout
  title={reason.pageTitle}
  description={reason.lead}
  bare
  noindex
>
  <section class="hero lock surface-dark" aria-labelledby="lock-title" data-stardust-host>
    <canvas class="stardust" data-stardust aria-hidden="true"></canvas>

    <div class="lock-panel">
      <Logo variant="stacked" tone="dark" />

      <p class="lock-badge"><Icon name={reason.icon} class="lock-badge-icon" /> {reason.badge}</p>
      <h1 id="lock-title">{reason.title}</h1>
      <p class="lock-lead" role="status">{reason.lead}</p>

      <p class="lock-note">Agence digitale · Métropole lilloise{reason.temporary ? '' : ' · ouverture prochaine'}</p>

      {
        isAdmin && (
          <div class="lock-admin">
            <p>Session d'administration ouverte : le public voit cette page (motif : {reason.label.toLowerCase()}).</p>
            <div class="lock-admin-actions">
              <form method="post">
                <input type="hidden" name="action" value={previewing ? 'preview-off' : 'preview-on'} />
                <button class="btn btn-ghost btn-sm" type="submit">
                  {previewing ? "Quitter l'aperçu" : 'Voir le site en aperçu'}
                </button>
              </form>
              <a class="btn btn-ghost btn-sm" href={ADMIN_PATH}>Administration</a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
