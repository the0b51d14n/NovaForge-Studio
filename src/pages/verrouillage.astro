---
// Page « site fermé » : quand le site est verrouillé (depuis /administration), tout visiteur y est
// redirigé par src/lib/middleware.ts. Aucun formulaire ici : la connexion se fait sur /administration.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';

if (!Astro.locals.settings.locked || Astro.locals.isAdmin) return Astro.redirect('/');
---

<BaseLayout
  title="Bientôt en ligne"
  description="Le site de NovaForge Studio est momentanément fermé. Revenez un peu plus tard."
  bare
  noindex
>
  <section class="hero lock surface-dark" aria-labelledby="lock-title" data-stardust-host>
    <canvas class="stardust" data-stardust aria-hidden="true"></canvas>

    <div class="lock-panel">
      <Logo variant="stacked" tone="dark" />

      <p class="lock-badge"><Icon name="lock" class="lock-badge-icon" /> Accès privé</p>
      <h1 id="lock-title">Le studio vous ouvre ses portes sur invitation.</h1>
      <p class="lock-lead" role="status">Le site est momentanément fermé. Revenez un peu plus tard.</p>

      <p class="lock-note">Agence digitale · Métropole lilloise · ouverture prochaine</p>
    </div>
  </section>
</BaseLayout>
