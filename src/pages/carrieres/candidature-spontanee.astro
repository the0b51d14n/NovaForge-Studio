---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import PrelaunchNotice from '../../components/PrelaunchNotice.astro';
import Icon from '../../components/Icon.astro';
import { launch } from '../../data/site';

// Recrutement pas encore ouvert : aucune candidature (ni CV) n'est collectée ; l'administration peut prévisualiser
if (!launch.recruitment && !Astro.locals.isAdmin) return Astro.redirect('/carrieres#recrutement', 302);

const { openings } = Astro.locals;
---

<BaseLayout
  title="Candidature spontanée"
  description="Envoyez une candidature spontanée à NovaForge Studio, agence digitale de la métropole lilloise."
>
  <PageHero
    eyebrow="Carrières · Candidature spontanée"
    compact
    lead="Aucune offre ne correspond exactement à votre profil ? Présentez-vous quand même : le studio se construit et d'autres postes suivront."
  >
    <Fragment slot="title">Présentez-<em>vous.</em></Fragment>
  </PageHero>

  <PrelaunchNotice />

  <section class="section surface-light" aria-label="Formulaire de candidature spontanée">
    <div class="container form-layout">
      <div>
        <p class="lead-text">Nous lisons chaque candidature avec attention et répondons à tous, en général sous une semaine.</p>
        <ul class="apply-checklist">
          <li><Icon name="check" />Votre CV</li>
          <li><Icon name="check" />Un portfolio ou votre GitHub</li>
          <li><Icon name="check" />Ce que vous aimeriez faire chez nous</li>
        </ul>
        {
          openings.length === 1 && (
            <div class="side-card card">
              <h3>Une offre est ouverte</h3>
              <p>{openings[0].title} · {openings[0].contracts.join(' ou ')}</p>
              <a class="link-arrow" href={`/carrieres/${openings[0].slug}`}>Voir l'offre <Icon name="arrow" /></a>
            </div>
          )
        }
        {
          openings.length > 1 && (
            <div class="side-card card">
              <h3>{openings.length} offres sont ouvertes</h3>
              <a class="link-arrow" href="/carrieres#offres">Voir les offres <Icon name="arrow" /></a>
            </div>
          )
        }
      </div>
      <ApplyForm position="Candidature spontanée" contracts={['Alternance', 'CDI', 'Stage']} idPrefix="spontanee" />
    </div>
  </section>
</BaseLayout>
