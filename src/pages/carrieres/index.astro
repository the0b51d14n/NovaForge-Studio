---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { job, benefits, culture, officeLife, workSchedules, remoteWeek, remoteRules, dayInLife } from '../../data/content';
import { getSite } from '../../lib/store';

const site = getSite(Astro.locals);
const { openings } = Astro.locals;
const contracts = [...new Set(openings.flatMap((o) => o.contracts))];
const lastUpdate = openings.map((o) => o.published).sort().at(-1);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Carrières"
  description="Rejoignez NovaForge Studio, agence digitale de la métropole lilloise qui recrute son premier collaborateur : offres d'emploi, culture de travail, horaires sur 35 heures, télétravail jusqu'à 3 jours par semaine et processus de recrutement."
>
  <PageHero
    eyebrow="Carrières"
    lead="NovaForge Studio, c'est un développeur freelance qui monte sa boîte. Rejoignez-le dès le début, comme premier collaborateur : votre travail se verra directement, et votre place grandira avec l'agence."
  >
    <Fragment slot="title">Grandissez <em>avec nous.</em></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-primary" href="#offres">Voir les offres <Icon name="arrow" class="btn-arrow" /></a>
      <a class="btn btn-ghost" href="/carrieres/candidature-spontanee">Candidature spontanée</a>
    </Fragment>
    <Fragment slot="aside">
      <dl class="info-list">
        <div><dt>Postes ouverts</dt><dd>{openings.length}</dd></div>
        {contracts.length > 0 && <div><dt>Contrats</dt><dd>{contracts.join(' · ')}</dd></div>}
        <div><dt>Temps de travail</dt><dd><a href="#horaires">35 h / semaine</a></dd></div>
        <div><dt>Télétravail</dt><dd><a href="#horaires">Jusqu'à 3 j / semaine</a></dd></div>
        <div><dt>Réponse</dt><dd>Sous 1 semaine</dd></div>
      </dl>
    </Fragment>
  </PageHero>

  <!-- ============ OFFRES ============ -->
  <section class="section surface-light" id="offres" aria-labelledby="offers-title">
    <div class="container">
      <SectionHead num="01" label="Offres" titleId="offers-title">
        Nos postes <em>ouverts.</em>
        <Fragment slot="intro">
          {lastUpdate
            ? `${openings.length} offre${openings.length > 1 ? 's' : ''} en ce moment · mise à jour le ${formatDate(lastUpdate)}`
            : 'Aucune offre en ce moment : la candidature spontanée reste ouverte.'}
        </Fragment>
      </SectionHead>

      <ul class="jobs">
        {
          openings.map((o) => (
            <li data-reveal>
              <a class="job-card" href={`/carrieres/${o.slug}`}>
                <span class="job-badge">Nouveau</span>
                <span class="job-main">
                  <span class="job-team">{o.team}</span>
                  <span class="job-title">{o.title}</span>
                  <span class="job-summary">{o.summary}</span>
                </span>
                <span class="job-tags">
                  <span><Icon name="briefcase" />{o.contracts.join(' ou ')}</span>
                  <span><Icon name="pin" />{o.location}</span>
                  <span><Icon name="home" />Télétravail partiel</span>
                </span>
                <span class="job-arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </li>
          ))
        }
        <li data-reveal>
          <a class="job-card job-card--open" href="/carrieres/candidature-spontanee">
            <span class="job-main">
              <span class="job-team">Toujours ouvert</span>
              <span class="job-title">Candidature spontanée</span>
              <span class="job-summary">Aucune offre ne vous correspond ? Présentez-vous : le studio se construit, d'autres postes suivront.</span>
            </span>
            <span class="job-arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ POURQUOI NOUS REJOINDRE ============ -->
  <section class="section surface-dark hiring" aria-labelledby="why-title">
    <div class="container">
      <SectionHead num="02" label="Pourquoi nous rejoindre" titleId="why-title">
        Pas un simple exécutant.<br /><em>Un vrai rôle.</em>
      </SectionHead>

      <ul class="tiles tiles--2">
        {
          job.reasons.map((r, i) => (
            <li class="tile reason card" data-reveal style={`--d:${(i % 2) * 0.08}s`}>
              <span class="tile-num">/0{i + 1}</span>
              <h3>{r.title}</h3>
              <blockquote>
                <p>« {r.quote} »</p>
              </blockquote>
            </li>
          ))
        }
      </ul>

      <ul class="facts">
        {
          job.facts.map((f, i) => (
            <li class="fact" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="fact-value">{f.value}</span>
              <span class="fact-label">{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ AVANTAGES ============ -->
  <section class="section surface-light" aria-labelledby="perks-title">
    <div class="container">
      <SectionHead num="03" label="Avantages" titleId="perks-title">
        Ce que le studio<br /><em>vous apporte.</em>
      </SectionHead>

      <ul class="benefits">
        {
          benefits.map((b, i) => (
            <li class="benefit card" data-reveal style={`--d:${(i % 4) * 0.06}s`}>
              <span class="service-icon">
                <Icon name={b.icon} />
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ VIE AU STUDIO : CULTURE DE TRAVAIL ============ -->
  <section class="section surface-light-2" id="vie-au-studio" aria-labelledby="life-title">
    <div class="container">
      <SectionHead num="04" label="La vie au studio" titleId="life-title">
        Bien travailler, <em>sans oublier de bien vivre.</em>
        <Fragment slot="intro">
          Nous voulons une agence où l'ambition ne se paie pas en bien-être. Un endroit où chacun progresse, propose
          ses idées, apprend de ses erreurs et travaille sur des projets dont il est fier. Les désaccords et les jours
          difficiles existeront : ils se traitent avec respect et professionnalisme.
        </Fragment>
      </SectionHead>

      <ul class="values">
        {
          culture.map((principle, i) => (
            <li class="value card" data-reveal style={`--d:${(i % 4) * 0.06}s`}>
              <Icon name="star" />
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="office" data-reveal>
        <h3 class="office-title">Au studio, concrètement</h3>
        <ul class="office-list">
          {
            officeLife.map((item) => (
              <li>
                <Icon name="check" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ HORAIRES, TÉLÉTRAVAIL ET JOURNÉE TYPE ============ -->
  <section class="section surface-light" id="horaires" aria-labelledby="hours-title">
    <div class="container">
      <SectionHead num="05" label="Horaires & télétravail" titleId="hours-title">
        35 heures,<br /><em>une semaine prévisible.</em>
        <Fragment slot="intro">
          Notre modèle : 35 heures de travail effectif sur cinq jours, soit 7 heures par jour, avec une pause déjeuner
          d'1 h 30. La formule standard sert de référence ; les deux autres s'adaptent à vos préférences, dans une
          organisation convenue avec le studio.
        </Fragment>
      </SectionHead>

      <ul class="schedules">
        {
          workSchedules.map((s, i) => (
            <li class:list={['pay-card', 'card', { 'pay-card--featured': s.featured }]} data-reveal style={`--d:${i * 0.06}s`}>
              <span class="pay-label">
                {s.label}
                {s.featured && ' · référence'}
              </span>
              <span class="schedule-hours">{s.hours}</span>
              <span class="pay-detail">
                {s.detail}
                <br />7&nbsp;h de travail effectif
              </span>
            </li>
          ))
        }
      </ul>
      <p class="schedule-note">
        Réunions, échanges et préparation pendant la plage de travail sont du temps de travail, comptés comme tel.
      </p>

      <div class="remote" data-reveal>
        <div class="remote-intro">
          <h3 class="office-title">Le télétravail, prévu à l'avance</h3>
          <p>Jusqu'à trois jours par semaine. Le lundi, toute l'équipe se retrouve au studio.</p>
        </div>
        <ol class="remote-week" aria-label="Semaine type">
          {
            remoteWeek.map((d) => (
              <li class:list={['remote-day', { 'remote-day--office': d.mode === 'Au studio' }]}>
                <span class="remote-day-name">{d.day}</span>
                <span class="remote-day-mode">{d.mode}</span>
                <span class="remote-day-note">{d.note}</span>
              </li>
            ))
          }
        </ol>
        <ul class="remote-rules">
          {
            remoteRules.map((rule) => (
              <li>
                <strong>{rule.title}.</strong> {rule.text}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="day-block">
        <h3 class="office-title">Une journée type</h3>
        <p class="day-block-intro">
          Sur la formule standard. En formule matinale ou décalée, les créneaux suivent vos horaires et votre pause,
          pour la même durée de travail.
        </p>
        <ol class="day">
          {
            dayInLife.map((moment, i) => (
              <li class="day-item card" data-reveal style={`--d:${i * 0.06}s`}>
                <span class="day-time">
                  <Icon name="clock" />
                  {moment.time}
                </span>
                <h4>{moment.title}</h4>
                <p>{moment.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="policy-note">
        Ces principes sont notre cadre de référence. Les modalités précises (formule horaire, jours de télétravail,
        changements de planning) seront fixées dans le contrat de travail et une charte de télétravail, dans le
        respect des règles applicables.
      </p>

      <p class="life-outro" data-reveal>
        Notre ambition : créer des projets de qualité, progresser ensemble et construire une agence où chacun a envie
        de revenir le lendemain.
      </p>
    </div>
  </section>

  <!-- ============ PROCESSUS ============ -->
  <section class="section surface-light-2" id="processus" aria-labelledby="process-title">
    <div class="container">
      <SectionHead num="06" label="Processus de recrutement" titleId="process-title">
        Cinq étapes,<br /><em>zéro surprise.</em>
      </SectionHead>
      <Steps steps={job.steps} />
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section surface-light" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <SectionHead num="07" label="Questions fréquentes" titleId="faq-title">
        Vos questions,<br /><em>nos réponses.</em>
      </SectionHead>
      <Faq items={job.faq} />
    </div>
  </section>

  <CtaBand
    title="Envie de nous rejoindre ?"
    text="Postulez à notre offre ou envoyez une candidature spontanée : nous répondons à tous les candidats."
    href={openings[0] ? `/carrieres/${openings[0].slug}#postuler` : '/carrieres/candidature-spontanee'}
    label="Postuler"
    email={site.jobsEmail}
  />
</BaseLayout>
