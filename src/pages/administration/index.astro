                  <input class="input" id="me-email" name="email" type="email" autocomplete="email" required placeholder={user!.email} />
                </div>
                <div class="field">
                  <label for="me-email-current">Mot de passe actuel</label>
                  <input class="input" id="me-email-current" name="current" type="password" autocomplete="current-password" required />
                </div>
                <div class="form-footer">
                  <p class="form-note">Elle servira à vous connecter.</p>
                  <button class="btn btn-ghost" type="submit">Changer mon e-mail</button>
                </div>
              </form>
              <form class="form admin-form" method="post">
                <input type="hidden" name="action" value="password-change" />
                <div class="field field--full">
                  <label for="me-current">Mot de passe actuel</label>
                  <input class="input" id="me-current" name="current" type="password" autocomplete="current-password" required />
                </div>
                <div class="field">
                  <label for="me-password">Nouveau mot de passe</label>
                  <input class="input" id="me-password" name="password" type="password" autocomplete="new-password" required minlength={MIN_PASSWORD} />
                </div>
                <div class="field">
                  <label for="me-confirm">Confirmation</label>
                  <input class="input" id="me-confirm" name="confirm" type="password" autocomplete="new-password" required />
                </div>
                <div class="form-footer">
                  <p class="form-note">{MIN_PASSWORD} caractères au moins.</p>
                  <button class="btn btn-primary" type="submit">Changer mon mot de passe</button>
                </div>
              </form>
            </section>
          </div>
        </div>
      </>
    )
  }
</BaseLayout>

<script>
  // Onglets des fermetures (sans JavaScript, les deux listes restent affichées l'une sous l'autre)
  const tabs = document.querySelectorAll<HTMLButtonElement>('.admin-tab');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('.admin-tab-panel').forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.panel === tab.dataset.tab);
      });
    });
  });

  // Confirmation avant une suppression
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm)) event.preventDefault();
    });
  });
</script>
