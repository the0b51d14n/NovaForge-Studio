<BaseLayout title="Portail de l'équipe" description="Portail de l'équipe NovaForge Studio." bare noindex>
  {
    !isAdmin ? (
      <section class="hero lock surface-dark" aria-labelledby="admin-title" data-stardust-host>
        <canvas class="stardust" data-stardust aria-hidden="true" />
        <div class="lock-panel">
          <Logo variant="stacked" tone="dark" />
          <p class="lock-badge">
            <Icon name="lock" class="lock-badge-icon" /> Portail de l'équipe
          </p>
          {bootstrap ? (
            <Fragment>
              <h1 id="admin-title">Premier compte dirigeant.</h1>
              {isConfigured() ? (
                <form class="lock-form" method="post">
                  <input type="hidden" name="action" value="bootstrap" />
                  <p class="lock-lead">
                    Aucun compte de l'équipe n'existe encore. Créez le vôtre avec le mot de passe du site
                    (SITE_PASSWORD) : il ne servira plus ensuite.
                  </p>
                  <div class="field">
                    <label for="site-password">Mot de passe du site</label>
                    <input class="input" id="site-password" name="site-password" type="password" autocomplete="off" required />
                  </div>
                  <div class="field">
                    <label for="b-name">Prénom et nom</label>
                    <input class="input" id="b-name" name="name" value={bootDraft.name} autocomplete="name" required maxlength="120" />
                  </div>
                  <div class="field">
                    <label for="b-email">E-mail</label>
                    <input class="input" id="b-email" name="email" type="email" value={bootDraft.email} autocomplete="username" required />
                  </div>
                  <div class="field">
                    <label for="b-password">Mot de passe ({MIN_PASSWORD} caractères au moins)</label>
                    <input class="input" id="b-password" name="password" type="password" autocomplete="new-password" required minlength={MIN_PASSWORD} />
                  </div>
                  <div class="field">
                    <label for="b-confirm">Confirmation</label>
                    <input class="input" id="b-confirm" name="confirm" type="password" autocomplete="new-password" required />
                    {error && (
                      <p class="field-error" role="alert">
                        {error}
                      </p>
                    )}
                  </div>
                  <button class="btn btn-primary" type="submit">
                    Créer mon compte <Icon name="arrow" class="btn-arrow" />
                  </button>
                </form>
              ) : (
                <p class="lock-lead" role="status">
                  Aucun mot de passe du site n'est configuré : ajoutez SITE_PASSWORD aux variables d'environnement pour
                  créer le premier compte dirigeant.
                </p>
              )}
            </Fragment>
          ) : (
            <Fragment>
              <h1 id="admin-title">Accès réservé.</h1>
              <p class="lock-lead">Le portail est réservé à l'équipe du studio : votre compte n'y a pas accès.</p>
              <form method="post">
                <input type="hidden" name="action" value="logout" />
                <button class="btn btn-ghost" type="submit">Changer de compte</button>
              </form>
            </Fragment>
          )}
        </div>
      </section>
    ) : (
      <>
        <AdminBar />
        <div class="admin surface-light-2">
