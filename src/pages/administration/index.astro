---
// Administration : connexion (SITE_PASSWORD), puis verrou du site, adresse du siège, fermetures et offres d'emploi.
// Chaque action est un formulaire POST traité ici, suivi d'une redirection (pas de double envoi en rechargeant).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/Icon.astro';
import AdminBar from '../../components/AdminBar.astro';
import { ADMIN_PATH, checkPassword, isConfigured, logIn, logOut, stopPreview } from '../../lib/access';
import { geocode, isPersistent, saveOpenings, saveSettings } from '../../lib/store';
import { deleteQuote, listQuotes, quoteStatus, type Quote, type QuoteStatus } from '../../lib/quotes';
import { formatEuros, formatRange } from '../../lib/pricing';
import { site } from '../../data/site';
import { LOCK_REASONS, isLockReason } from '../../data/lock-reasons';
import {
  ISO_DATE,
  TIME,
  addDays,
  buildCalendar,
  dayOn,
  formatDay,
  formatTime,
  frenchHolidays,
  parisNow,
  toMinutes,
  weekday,
  type Closure,
} from '../../lib/hours';

const { isAdmin, settings, openings } = Astro.locals;
let error = '';

const text = (data: FormData, name: string, max = 120) => String(data.get(name) ?? '').trim().slice(0, max);
// Après une action sur les fermetures : retour sur le bon onglet, la page défile jusqu'à la carte
const done = (ok: string, tab?: 'temporaires' | 'feries') =>
  Astro.redirect(`${ADMIN_PATH}?ok=${ok}${tab ? `&onglet=${tab}#fermetures` : ''}`, 303);
// Identifiant d'une fermeture (dates et heures) pour la supprimer
const closureKey = (c: Closure) => [c.start, c.end, c.from ?? '', c.to ?? ''].join('|');
// Saisie conservée si l'ajout d'une fermeture échoue
let draft: { start: string; end: string; from: string; to: string; reason: string } | null = null;
const today = parisNow().date;
// Une fermeture passée reste jusqu'à la fin de sa semaine, puis le middleware la supprime de la base
const { closures } = settings;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');

  if (!isAdmin) {
    if (action === 'login') {
      if (await checkPassword(String(data.get('password') ?? ''))) {
        await logIn(Astro.cookies);
        return Astro.redirect(ADMIN_PATH, 303);
      }
      // Petite pause après un échec : ralentit les essais de mots de passe à la chaîne
      await new Promise((resolve) => setTimeout(resolve, 800));
      error = 'Mot de passe incorrect. Vérifiez-le et réessayez.';
      Astro.response.status = 401;
    }
  } else {
    try {
      if (action === 'logout') {
        logOut(Astro.cookies);
        return Astro.redirect(ADMIN_PATH, 303);
      }
      if (action === 'lock-reason') {
        const reason = data.get('reason');
        if (isLockReason(reason)) await saveSettings({ ...settings, lockReason: reason });
        return done('motif');
      }
      if (action === 'lock' || action === 'unlock') {
        const reason = data.get('reason');
        await saveSettings({
          ...settings,
          locked: action === 'lock',
          lockReason: action === 'lock' && isLockReason(reason) ? reason : settings.lockReason,
        });
        // Verrouiller ferme aussi le site pour l'administrateur : l'aperçu se réactive depuis /verrouillage
        stopPreview(Astro.cookies);
        return done(action);
      }
      if (action === 'address') {
        const street = text(data, 'street');
        const postalCode = text(data, 'postalCode', 5);
        const city = text(data, 'city');
        if (!street || !city || !/^\d{5}$/.test(postalCode)) {
          error = 'Adresse incomplète : rue, code postal à 5 chiffres et ville sont obligatoires.';
        } else {
          const geo = await geocode(street, postalCode, city);
          await saveSettings({ ...settings, street, postalCode, city, geo: geo ?? settings.geo });
          return done(geo ? 'adresse' : 'adresse-sans-carte');
        }
      }
      if (action === 'holidays-on' || action === 'holidays-off') {
        await saveSettings({ ...settings, closures, holidays: action === 'holidays-on' });
        return done(action, 'feries');
      }
      if (action === 'closure-add') {
        const start = text(data, 'start', 10);
        const end = text(data, 'end', 10) || start;
        const from = text(data, 'from', 5);
        const to = text(data, 'to', 5);
        const reason = text(data, 'reason', 60);
        draft = { start, end: text(data, 'end', 10), from, to, reason };
        if (!ISO_DATE.test(start) || !ISO_DATE.test(end) || end < start) {
          error = 'Dates invalides : la date de fin ne peut pas précéder la date de début.';
        } else if (end < today) {
          error = 'Cette période est déjà passée.';
        } else if (end > addDays(start, 366)) {
          error = 'Une fermeture ne peut pas dépasser un an.';
        } else if ((from || to) && !(TIME.test(from) && TIME.test(to) && from < to)) {
          error = 'Plage horaire invalide : indiquez une heure de début et une heure de fin (après le début), ou laissez les deux vides pour la journée entière.';
        } else {
          const closure: Closure = { start, end, reason, ...(from && to ? { from, to } : {}) };
          const next = [...closures, closure].sort((a, b) => a.start.localeCompare(b.start));
          await saveSettings({ ...settings, closures: next });
          return done('fermeture', text(data, 'onglet', 12) === 'feries' ? 'feries' : 'temporaires');
        }
      }
      if (action === 'closure-delete') {
        const key = text(data, 'key', 40);
        await saveSettings({ ...settings, closures: closures.filter((c) => closureKey(c) !== key) });
        return done('fermeture-supprimee', 'temporaires');
      }
      if (action === 'delete') {
        const slug = text(data, 'slug');
        await saveOpenings(openings.filter((o) => o.slug !== slug));
        return done('supprimee');
      }
      if (action === 'quote-delete') {
        await deleteQuote(text(data, 'id', 32));
        return Astro.redirect(`${ADMIN_PATH}?ok=devis-supprime#devis`, 303);
      }
    } catch (e) {
      console.error(e);
      error = "L'enregistrement a échoué (base de données injoignable). Réessayez dans un instant.";
      Astro.response.status = 500;
    }
  }
}

const lockReason = LOCK_REASONS[settings.lockReason] ?? LOCK_REASONS.fermeture;
// Titre cité entre guillemets dans les messages, sans son point final
const lockTitle = lockReason.title.replace(/\.$/, '');
const flashes: Record<string, string> = {
  lock: `Site verrouillé (${lockReason.label.toLowerCase()}) : les visiteurs voient maintenant « ${lockTitle} ».`,
  motif: `Motif changé : les visiteurs voient maintenant « ${lockTitle} ».`,
  unlock: 'Site ouvert : tout le monde peut maintenant le consulter.',
  adresse: 'Adresse du siège enregistrée, carte mise à jour.',
  'adresse-sans-carte': "Adresse enregistrée, mais introuvable sur la carte : l'ancien emplacement de la carte est conservé.",
  supprimee: 'Offre supprimée.',
  creee: 'Offre publiée.',
  fermeture: 'Fermeture ajoutée : elle apparaît sur la page Contact.',
  'fermeture-supprimee': 'Fermeture supprimée.',
  'holidays-on': 'Les jours fériés sont maintenant indiqués comme fermés.',
  'holidays-off': 'Les jours fériés ne sont plus indiqués comme fermés.',
  modifiee: 'Offre mise à jour.',
  'devis-supprime': 'Devis supprimé.',
};
const flash = flashes[Astro.url.searchParams.get('ok') ?? ''];

// Derniers devis du simulateur (les devis non signés sont supprimés automatiquement après quelques semaines)
let quotes: Quote[] = [];
let quotesError = false;
if (isAdmin) {
  try {
    quotes = await listQuotes();
  } catch (e) {
    console.error(e);
    quotesError = true;
  }
}
const QUOTE_STATES: Record<QuoteStatus, [label: string, tone: 'open' | 'locked']> = {
  estimation: ['Estimation', 'locked'],
  rappel: ['À rappeler', 'locked'],
  ferme: ['Devis ferme, à signer', 'open'],
  expire: ['Expiré', 'locked'],
  signe: ['Signé', 'open'],
};
// Montant affiché dans la liste : devis ferme s'il existe, sinon fourchette de l'estimation
const quoteAmount = (q: Quote) =>
  q.final
    ? `${formatEuros(q.final.totals.oneOff.ttc)}${q.final.totals.monthly.ttc > 0 ? ` + ${formatEuros(q.final.totals.monthly.ttc)} / mois` : ''}`
    : `${formatRange([q.totals.oneOff.min.ttc, q.totals.oneOff.max.ttc])}${q.totals.monthly.max.ttc > 0 ? ` + ${formatRange([q.totals.monthly.min.ttc, q.totals.monthly.max.ttc])} / mois` : ''}`;

// Dates de l'administration : jour et mois seulement (« 11 nov. »)
const cal = buildCalendar(site.schedule, { ...settings, closures });
const short = { day: 'numeric', month: 'short' } as const;
const range = (c: Closure) =>
  (c.start === c.end ? formatDay(c.start, short) : `Du ${formatDay(c.start, short)} au ${formatDay(c.end, short)}`) +
  (c.from && c.to ? ` · de ${formatTime(toMinutes(c.from))} à ${formatTime(toMinutes(c.to))}` : ' · journée entière');

// Onglet affiché : fermetures temporaires par défaut, jours fériés après une action qui les concerne
const activeTab = Astro.url.searchParams.get('onglet') === 'feries' ? 'feries' : 'temporaires';

// Tous les jours fériés des 12 prochains mois. Un férié qui tombe un jour où le studio est de toute façon
// fermé (week-end) reste affiché normalement ; sinon il ferme le studio, avec le pont éventuel :
// férié un mardi → lundi, férié un jeudi → vendredi (s'il est ouvert et pas déjà fermé)
const bridgeOffset: Record<number, number> = { 1: -1, 3: 1 };
const until = addDays(today, 365);
const thisYear = Number(today.slice(0, 4));
const holidays = [thisYear, thisYear + 1]
  .flatMap((year) => [...frenchHolidays(year)])
  .filter(([iso]) => iso >= today && iso < until)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([iso, name]) => {
    const usuallyOpen = Boolean(cal.slots[weekday(iso)]);
    const offset = usuallyOpen ? bridgeOffset[weekday(iso)] : undefined;
    const bridge = offset ? addDays(iso, offset) : null;
    return {
      date: iso,
      name,
      usuallyOpen,
      bridge: bridge && cal.slots[weekday(bridge)] && !dayOn(bridge, cal).reason ? bridge : null,
    };
  });

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Administration" description="Administration du site NovaForge Studio." bare noindex>
  {
    !isAdmin ? (
      <section class="hero lock surface-dark" aria-labelledby="admin-title" data-stardust-host>
        <canvas class="stardust" data-stardust aria-hidden="true" />
        <div class="lock-panel">
          <Logo variant="stacked" tone="dark" />
          <p class="lock-badge">
            <Icon name="lock" class="lock-badge-icon" /> Administration
          </p>
          <h1 id="admin-title">Espace réservé.</h1>
          {isConfigured() ? (
            <form class="lock-form" method="post">
              <input type="hidden" name="action" value="login" />
              <div class="field">
                <label for="password">Mot de passe</label>
                <input
                  class="input"
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  autofocus
                  aria-invalid={error ? 'true' : undefined}
                  aria-describedby={error ? 'password-error' : undefined}
                />
                {error && (
                  <p class="field-error" id="password-error" role="alert">
                    {error}
                  </p>
                )}
              </div>
              <button class="btn btn-primary" type="submit">
                Se connecter <Icon name="arrow" class="btn-arrow" />
              </button>
            </form>
          ) : (
            <p class="lock-lead" role="status">
              Aucun mot de passe n'est configuré : ajoutez SITE_PASSWORD aux variables d'environnement.
            </p>
          )}
        </div>
      </section>
    ) : (
      <>
        <AdminBar />
        <div class="admin surface-light-2">
          <div class="container admin-inner">
            <h1 class="admin-title">Tableau de bord</h1>

            {!isPersistent() && (
              <p class="admin-alert">
                Base de données non configurée : les modifications sont perdues au redémarrage du serveur. Branchez
                Upstash Redis au projet (Vercel → Storage).
              </p>
            )}
            {flash && (
              <p class="admin-flash" role="status">
                <Icon name="check" /> {flash}
              </p>
            )}
            {error && (
              <p class="admin-alert" role="alert">
                {error}
              </p>
            )}

            <section class="admin-card card" aria-labelledby="a-lock">
              <div class="admin-card-head">
                <h2 class="admin-h2" id="a-lock">État du site</h2>
                <p class:list={['admin-state', settings.locked ? 'admin-state--locked' : 'admin-state--open']}>
                  {settings.locked ? `Verrouillé · ${lockReason.label}` : 'En ligne'}
                </p>
              </div>
              <p class="admin-text">
                {settings.locked
                  ? `Tout le monde, vous compris, voit la page « ${lockTitle} ». Depuis cette page, le bouton « Voir le site en aperçu » vous permet de le consulter.`
                  : 'Tout le monde peut consulter le site. Choisissez le motif affiché aux visiteurs, puis verrouillez.'}
              </p>
              <form class="admin-lock-form" method="post">
                <fieldset class="field">
                  <legend>Motif du verrouillage</legend>
                  <div class="choices">
                    {Object.entries(LOCK_REASONS).map(([value, reason]) => (
                      <label class="choice">
                        <input type="radio" name="reason" value={value} checked={value === settings.lockReason} />
                        <span>{reason.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                {settings.locked ? (
                  <button class="btn btn-ghost btn-sm" type="submit" name="action" value="lock-reason">
                    Changer le motif
                  </button>
                ) : (
                  <button class="btn btn-ghost" type="submit" name="action" value="lock">
                    <Icon name="lock" /> Verrouiller le site
                  </button>
                )}
              </form>
              {settings.locked && (
                <form method="post">
                  <input type="hidden" name="action" value="unlock" />
                  <button class="btn btn-primary" type="submit">
                    Ouvrir le site au public <Icon name="arrow" class="btn-arrow" />
                  </button>
                </form>
              )}
            </section>

            <section class="admin-card card" aria-labelledby="a-address">
              <h2 class="admin-h2" id="a-address">Adresse du siège</h2>
              <p class="admin-text">
                Affichée dans le pied de page, la page Contact, la carte, les offres d'emploi et les mentions légales.
              </p>
              <form class="form admin-form" method="post">
                <input type="hidden" name="action" value="address" />
                <div class="field field--full">
                  <label for="street">Rue</label>
                  <input class="input" id="street" name="street" value={settings.street} required maxlength="120" autocomplete="street-address" />
                </div>
                <div class="field">
                  <label for="postalCode">Code postal</label>
                  <input class="input" id="postalCode" name="postalCode" value={settings.postalCode} required inputmode="numeric" pattern="\d{5}" maxlength="5" autocomplete="postal-code" />
                </div>
                <div class="field">
                  <label for="city">Ville</label>
                  <input class="input" id="city" name="city" value={settings.city} required maxlength="120" autocomplete="address-level2" />
                </div>
                <div class="form-footer">
                  <p class="form-note">La carte est recalculée automatiquement à partir de l'adresse.</p>
                  <button class="btn btn-primary" type="submit">Enregistrer l'adresse</button>
                </div>
              </form>
            </section>

            <section class="admin-card card" id="fermetures" aria-labelledby="a-closures">
              <h2 class="admin-h2" id="a-closures">Fermetures</h2>
              <p class="admin-text">
                Ces jours-là, la page Contact affiche « Fermé » (ou les seules heures d'ouverture restantes) dans le
                calendrier de la semaine, et l'état du studio en tient compte.
              </p>

              <div class="admin-tabs" role="tablist" aria-label="Type de fermeture">
                <button
                  class="admin-tab"
                  type="button"
                  role="tab"
                  id="tab-temporaires"
                  aria-controls="panel-temporaires"
                  aria-selected={activeTab === 'temporaires' ? 'true' : 'false'}
                  data-tab="temporaires"
                >
                  Fermetures temporaires <span class="admin-tab-count">{closures.length}</span>
                </button>
                <button
                  class="admin-tab"
                  type="button"
                  role="tab"
                  id="tab-feries"
                  aria-controls="panel-feries"
                  aria-selected={activeTab === 'feries' ? 'true' : 'false'}
                  data-tab="feries"
                >
                  Jours fériés
                </button>
              </div>

              <div
                class:list={['admin-tab-panel', { 'is-active': activeTab === 'temporaires' }]}
                role="tabpanel"
                id="panel-temporaires"
                aria-labelledby="tab-temporaires"
                data-panel="temporaires"
              >
                <details class="admin-add" open={draft !== null}>
                  <summary class="btn btn-primary btn-sm">
                    <span class="admin-add-open">Ajouter une fermeture</span>
                    <span class="admin-add-close">Annuler</span>
                  </summary>
                  <form class="form admin-form" method="post">
                    <input type="hidden" name="action" value="closure-add" />
                    <div class="field">
                      <label for="closure-start">Du</label>
                      <input class="input" id="closure-start" name="start" type="date" min={today} value={draft?.start} required />
                    </div>
                    <div class="field">
                      <label for="closure-end">Au (inclus)</label>
                      <input class="input" id="closure-end" name="end" type="date" min={today} value={draft?.end} />
                    </div>
                    <div class="field">
                      <label for="closure-from">Fermé de (facultatif)</label>
                      <input class="input" id="closure-from" name="from" type="time" value={draft?.from} />
                    </div>
                    <div class="field">
                      <label for="closure-to">Jusqu'à</label>
                      <input class="input" id="closure-to" name="to" type="time" value={draft?.to} />
                    </div>
                    <div class="field field--full">
                      <label for="closure-reason">Motif (facultatif, affiché sur la page Contact)</label>
                      <input
                        class="input"
                        id="closure-reason"
                        name="reason"
                        maxlength="60"
                        value={draft?.reason}
                        placeholder="Vacances d'été, pont de l'Ascension…"
                      />
                    </div>
                    <div class="form-footer">
                      <p class="form-note">
                        « Au » vide : une seule journée. Heures vides : journée entière. Sans motif, la page Contact affiche
                        « Fermeture exceptionnelle ».
                      </p>
                      <button class="btn btn-primary" type="submit">Enregistrer la fermeture</button>
                    </div>
                  </form>
                </details>

                {closures.length === 0 ? (
                  <p class="admin-text">Aucune fermeture temporaire prévue.</p>
                ) : (
                  <ul class="admin-jobs">
                    {closures.map((c) => (
                      <li class:list={['admin-job', { 'is-past': c.end < today }]}>
                        <div class="admin-job-main">
                          <p class="admin-job-title">{c.reason || 'Fermeture exceptionnelle'}</p>
                          <p class="admin-job-meta">
                            {range(c)}
                            {c.end < today && ' · terminée, supprimée automatiquement à la fin de la semaine'}
                          </p>
                        </div>
                        <div class="admin-job-actions">
                          <form method="post" data-confirm={`Supprimer la fermeture « ${c.reason || range(c)} » ?`}>
                            <input type="hidden" name="action" value="closure-delete" />
                            <input type="hidden" name="key" value={closureKey(c)} />
                            <button class="admin-link admin-link--danger" type="submit">
                              Supprimer
                            </button>
                          </form>
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <div
                class:list={['admin-tab-panel', { 'is-active': activeTab === 'feries' }]}
                role="tabpanel"
                id="panel-feries"
                aria-labelledby="tab-feries"
                data-panel="feries"
              >
                <div class="admin-card-head">
                  <p class="admin-text">
                    Les 11 jours fériés nationaux, calculés automatiquement chaque année (lundi de Pâques, Ascension et
                    lundi de Pentecôte compris).
                  </p>
                  <p class:list={['admin-state', settings.holidays ? 'admin-state--open' : 'admin-state--locked']}>
                    {settings.holidays ? 'Fermé automatiquement' : 'Jours normaux'}
                  </p>
                </div>
                <form method="post">
                  <input type="hidden" name="action" value={settings.holidays ? 'holidays-off' : 'holidays-on'} />
                  <button class="btn btn-ghost btn-sm" type="submit">
                    {settings.holidays ? 'Ouvrir les jours fériés' : 'Fermer les jours fériés'}
                  </button>
                </form>
                {settings.holidays && holidays.length > 0 && (
                  <ul class="admin-holidays">
                    {holidays.map((h) => (
                      <li class:list={{ 'is-weekend': !h.usuallyOpen }}>
                        <span>
                          <strong>{formatDay(h.date, short)}</strong> · {h.name}
                        </span>
                        <span class="admin-holiday-actions">
                          {h.bridge && (
                            <form method="post">
                              <input type="hidden" name="action" value="closure-add" />
                              <input type="hidden" name="onglet" value="feries" />
                              <input type="hidden" name="start" value={h.bridge} />
                              <input type="hidden" name="reason" value={`Pont (${h.name})`} />
                              <button class="admin-link" type="submit">
                                Faire le pont le {formatDay(h.bridge, short)}
                              </button>
                            </form>
                          )}
                          <span class="admin-holiday-tag">Fermé</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </section>

            <section class="admin-card card" id="devis" aria-labelledby="a-quotes">
              <h2 class="admin-h2" id="a-quotes">Simulateur de devis</h2>
              <p class="admin-text">
                Les visiteurs composent leur projet sur <a href="/devis" target="_blank" rel="noopener">/devis</a> et
                obtiennent une estimation en fourchette, puis demandent à être recontactés. Ouvrez une estimation pour
                fixer les prix fermes : le client signe ensuite son devis en ligne (une fois le studio ouvert
                commercialement). Les prestations et leurs fourchettes se règlent dans src/data/quote-catalog.ts.
              </p>
              {quotesError ? (
                <p class="admin-text">Liste des devis momentanément indisponible (base de données injoignable).</p>
              ) : quotes.length === 0 ? (
                <p class="admin-text">Aucun devis créé pour le moment.</p>
              ) : (
                <ul class="admin-jobs">
                  {quotes.map((q) => {
                    const [label, tone] = QUOTE_STATES[quoteStatus(q)];
                    return (
                      <li class="admin-job">
                        <div class="admin-job-main">
                          <p class="admin-job-title">
                            {q.number} · {quoteAmount(q)}
                          </p>
                          <p class="admin-job-meta">
                            Créé le {formatDate(q.createdAt)} · {q.lines.length} ligne{q.lines.length > 1 ? 's' : ''}
                            {q.contact && ` · ${q.contact.name}`}
                          </p>
                        </div>
                        <div class="admin-job-actions">
                          <span class:list={['admin-state', `admin-state--${tone}`]}>{label}</span>
                          <a class="admin-link" href={`${ADMIN_PATH}/devis/${q.id}`}>
                            {q.signature ? 'Ouvrir' : 'Finaliser'}
                          </a>
                          <a class="admin-link" href={`/devis/${q.id}`} target="_blank" rel="noopener">
                            Page client
                          </a>
                          <form method="post" data-confirm={`Supprimer le devis ${q.number} ?`}>
                            <input type="hidden" name="action" value="quote-delete" />
                            <input type="hidden" name="id" value={q.id} />
                            <button class="admin-link admin-link--danger" type="submit">
                              Supprimer
                            </button>
                          </form>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>

            <section class="admin-card card" aria-labelledby="a-jobs">
              <div class="admin-card-head">
                <h2 class="admin-h2" id="a-jobs">Offres d'emploi</h2>
                <a class="btn btn-primary btn-sm" href={`${ADMIN_PATH}/offres/nouvelle`}>
                  Nouvelle offre <Icon name="arrow" class="btn-arrow" />
                </a>
              </div>
              {openings.length === 0 ? (
                <p class="admin-text">
                  Aucune offre publiée : l'onglet Carrières ne propose que la candidature spontanée, et la mention « On
                  recrute » est masquée.
                </p>
              ) : (
                <ul class="admin-jobs">
                  {openings.map((o) => (
                    <li class="admin-job">
                      <div class="admin-job-main">
                        <p class="admin-job-title">{o.title}</p>
                        <p class="admin-job-meta">
                          {o.contracts.join(' ou ')} · publiée le {formatDate(o.published)}
                        </p>
                      </div>
                      <div class="admin-job-actions">
                        <a class="admin-link" href={`/carrieres/${o.slug}`} target="_blank" rel="noopener">
                          Voir
                        </a>
                        <a class="admin-link" href={`${ADMIN_PATH}/offres/${o.slug}`}>
                          Modifier
                        </a>
                        <form method="post" data-confirm={`Supprimer l'offre « ${o.title} » ?`}>
                          <input type="hidden" name="action" value="delete" />
                          <input type="hidden" name="slug" value={o.slug} />
                          <button class="admin-link admin-link--danger" type="submit">
                            Supprimer
                          </button>
                        </form>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </div>
        </div>
      </>
    )
  }
</BaseLayout>

<script>
  // Onglets des fermetures (sans JavaScript, les deux listes restent affichées l'une sous l'autre)
  const tabs = document.querySelectorAll<HTMLButtonElement>('.admin-tab');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('.admin-tab-panel').forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.panel === tab.dataset.tab);
      });
    });
  });

  // Confirmation avant une suppression
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm)) event.preventDefault();
    });
  });
</script>
