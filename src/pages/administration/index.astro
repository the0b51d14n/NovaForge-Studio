---
// Administration : connexion (SITE_PASSWORD), puis verrou du site, adresse du siège, fermetures et offres d'emploi.
// Chaque action est un formulaire POST traité ici, suivi d'une redirection (pas de double envoi en rechargeant).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/Icon.astro';
import AdminBar from '../../components/AdminBar.astro';
import { ADMIN_PATH, checkPassword, isConfigured, logIn, logOut, stopPreview } from '../../lib/access';
import { geocode, isPersistent, saveOpenings, saveSettings } from '../../lib/store';
import { site } from '../../data/site';
import { LOCK_REASONS, isLockReason } from '../../data/lock-reasons';
import { ISO_DATE, addDays, buildCalendar, closureOn, formatDay, parisNow, upcomingClosures, weekday, type Closure } from '../../lib/hours';

const { isAdmin, settings, openings } = Astro.locals;
let error = '';

const text = (data: FormData, name: string, max = 120) => String(data.get(name) ?? '').trim().slice(0, max);
const done = (ok: string) => Astro.redirect(`${ADMIN_PATH}?ok=${ok}`, 303);
const today = parisNow().date;
// Les fermetures passées disparaissent d'elles-mêmes au prochain enregistrement
const closures = settings.closures.filter((c) => c.end >= today);

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');

  if (!isAdmin) {
    if (action === 'login') {
      if (await checkPassword(String(data.get('password') ?? ''))) {
        await logIn(Astro.cookies);
        return Astro.redirect(ADMIN_PATH, 303);
      }
      // Petite pause après un échec : ralentit les essais de mots de passe à la chaîne
      await new Promise((resolve) => setTimeout(resolve, 800));
      error = 'Mot de passe incorrect. Vérifiez-le et réessayez.';
      Astro.response.status = 401;
    }
  } else {
    try {
      if (action === 'logout') {
        logOut(Astro.cookies);
        return Astro.redirect(ADMIN_PATH, 303);
      }
      if (action === 'lock-reason') {
        const reason = data.get('reason');
        if (isLockReason(reason)) await saveSettings({ ...settings, lockReason: reason });
        return done('motif');
      }
      if (action === 'lock' || action === 'unlock') {
        const reason = data.get('reason');
        await saveSettings({
          ...settings,
          locked: action === 'lock',
          lockReason: action === 'lock' && isLockReason(reason) ? reason : settings.lockReason,
        });
        // Verrouiller ferme aussi le site pour l'administrateur : l'aperçu se réactive depuis /verrouillage
        stopPreview(Astro.cookies);
        return done(action);
      }
      if (action === 'address') {
        const street = text(data, 'street');
        const postalCode = text(data, 'postalCode', 5);
        const city = text(data, 'city');
        if (!street || !city || !/^\d{5}$/.test(postalCode)) {
          error = 'Adresse incomplète : rue, code postal à 5 chiffres et ville sont obligatoires.';
        } else {
          const geo = await geocode(street, postalCode, city);
          await saveSettings({ ...settings, street, postalCode, city, geo: geo ?? settings.geo });
          return done(geo ? 'adresse' : 'adresse-sans-carte');
        }
      }
      if (action === 'holidays-on' || action === 'holidays-off') {
        await saveSettings({ ...settings, closures, holidays: action === 'holidays-on' });
        return done(action);
      }
      if (action === 'closure-add') {
        const start = text(data, 'start', 10);
        const end = text(data, 'end', 10) || start;
        const reason = text(data, 'reason', 60);
        if (!ISO_DATE.test(start) || !ISO_DATE.test(end) || end < start) {
          error = 'Dates invalides : la date de fin ne peut pas précéder la date de début.';
        } else if (end < today) {
          error = 'Cette période est déjà passée.';
        } else if (end > addDays(start, 366)) {
          error = 'Une fermeture ne peut pas dépasser un an.';
        } else {
          const next: Closure[] = [...closures, { start, end, reason }].sort((a, b) => a.start.localeCompare(b.start));
          await saveSettings({ ...settings, closures: next });
          return done('fermeture');
        }
      }
      if (action === 'closure-delete') {
        const start = text(data, 'start', 10);
        const end = text(data, 'end', 10);
        await saveSettings({ ...settings, closures: closures.filter((c) => c.start !== start || c.end !== end) });
        return done('fermeture-supprimee');
      }
      if (action === 'delete') {
        const slug = text(data, 'slug');
        await saveOpenings(openings.filter((o) => o.slug !== slug));
        return done('supprimee');
      }
    } catch (e) {
      console.error(e);
      error = "L'enregistrement a échoué (base de données injoignable). Réessayez dans un instant.";
      Astro.response.status = 500;
    }
  }
}

const lockReason = LOCK_REASONS[settings.lockReason] ?? LOCK_REASONS.fermeture;
// Titre cité entre guillemets dans les messages, sans son point final
const lockTitle = lockReason.title.replace(/\.$/, '');
const flashes: Record<string, string> = {
  lock: `Site verrouillé (${lockReason.label.toLowerCase()}) : les visiteurs voient maintenant « ${lockTitle} ».`,
  motif: `Motif changé : les visiteurs voient maintenant « ${lockTitle} ».`,
  unlock: 'Site ouvert : tout le monde peut maintenant le consulter.',
  adresse: 'Adresse du siège enregistrée, carte mise à jour.',
  'adresse-sans-carte': "Adresse enregistrée, mais introuvable sur la carte : l'ancien emplacement de la carte est conservé.",
  supprimee: 'Offre supprimée.',
  creee: 'Offre publiée.',
  fermeture: 'Fermeture ajoutée : elle apparaît sur la page Contact.',
  'fermeture-supprimee': 'Fermeture supprimée.',
  'holidays-on': 'Les jours fériés sont maintenant indiqués comme fermés.',
  'holidays-off': 'Les jours fériés ne sont plus indiqués comme fermés.',
  modifiee: 'Offre mise à jour.',
};
const flash = flashes[Astro.url.searchParams.get('ok') ?? ''];

// Jours fériés des 12 prochains mois tombant un jour normalement ouvert, avec le pont éventuel :
// férié un mardi → lundi, férié un jeudi → vendredi (s'il est ouvert et pas déjà fermé)
const cal = buildCalendar(site.schedule, { ...settings, closures });
const short = { weekday: 'short', day: 'numeric', month: 'short' } as const;
const range = (c: Closure) =>
  c.start === c.end ? formatDay(c.start, short) : `Du ${formatDay(c.start, short)} au ${formatDay(c.end, short)}`;
const bridgeOffset: Record<number, number> = { 1: -1, 3: 1 };
const holidays = upcomingClosures({ ...cal, closures: [], holidays: true }, today, 365).map((h) => {
  const offset = bridgeOffset[weekday(h.start)];
  const bridge = offset ? addDays(h.start, offset) : null;
  return { ...h, bridge: bridge && cal.slots[weekday(bridge)] && !closureOn(bridge, cal) ? bridge : null };
});

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Administration" description="Administration du site NovaForge Studio." bare noindex>
  {
    !isAdmin ? (
      <section class="hero lock surface-dark" aria-labelledby="admin-title" data-stardust-host>
        <canvas class="stardust" data-stardust aria-hidden="true" />
        <div class="lock-panel">
          <Logo variant="stacked" tone="dark" />
          <p class="lock-badge">
            <Icon name="lock" class="lock-badge-icon" /> Administration
          </p>
          <h1 id="admin-title">Espace réservé.</h1>
          {isConfigured() ? (
            <form class="lock-form" method="post">
              <input type="hidden" name="action" value="login" />
              <div class="field">
                <label for="password">Mot de passe</label>
                <input
                  class="input"
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  autofocus
                  aria-invalid={error ? 'true' : undefined}
                  aria-describedby={error ? 'password-error' : undefined}
                />
                {error && (
                  <p class="field-error" id="password-error" role="alert">
                    {error}
                  </p>
                )}
              </div>
              <button class="btn btn-primary" type="submit">
                Se connecter <Icon name="arrow" class="btn-arrow" />
              </button>
            </form>
          ) : (
            <p class="lock-lead" role="status">
              Aucun mot de passe n'est configuré : ajoutez SITE_PASSWORD aux variables d'environnement.
            </p>
          )}
        </div>
      </section>
    ) : (
      <>
        <AdminBar />
        <div class="admin surface-light-2">
          <div class="container admin-inner">
            <h1 class="admin-title">Tableau de bord</h1>

            {!isPersistent() && (
              <p class="admin-alert">
                Base de données non configurée : les modifications sont perdues au redémarrage du serveur. Branchez
                Upstash Redis au projet (Vercel → Storage).
              </p>
            )}
            {flash && (
              <p class="admin-flash" role="status">
                <Icon name="check" /> {flash}
              </p>
            )}
            {error && (
              <p class="admin-alert" role="alert">
                {error}
              </p>
            )}

            <section class="admin-card card" aria-labelledby="a-lock">
              <div class="admin-card-head">
                <h2 class="admin-h2" id="a-lock">État du site</h2>
                <p class:list={['admin-state', settings.locked ? 'admin-state--locked' : 'admin-state--open']}>
                  {settings.locked ? `Verrouillé · ${lockReason.label}` : 'En ligne'}
                </p>
              </div>
              <p class="admin-text">
                {settings.locked
                  ? `Tout le monde, vous compris, voit la page « ${lockTitle} ». Depuis cette page, le bouton « Voir le site en aperçu » vous permet de le consulter.`
                  : 'Tout le monde peut consulter le site. Choisissez le motif affiché aux visiteurs, puis verrouillez.'}
              </p>
              <form class="admin-lock-form" method="post">
                <fieldset class="field">
                  <legend>Motif du verrouillage</legend>
                  <div class="choices">
                    {Object.entries(LOCK_REASONS).map(([value, reason]) => (
                      <label class="choice">
                        <input type="radio" name="reason" value={value} checked={value === settings.lockReason} />
                        <span>{reason.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                {settings.locked ? (
                  <button class="btn btn-ghost btn-sm" type="submit" name="action" value="lock-reason">
                    Changer le motif
                  </button>
                ) : (
                  <button class="btn btn-ghost" type="submit" name="action" value="lock">
                    <Icon name="lock" /> Verrouiller le site
                  </button>
                )}
              </form>
              {settings.locked && (
                <form method="post">
                  <input type="hidden" name="action" value="unlock" />
                  <button class="btn btn-primary" type="submit">
                    Ouvrir le site au public <Icon name="arrow" class="btn-arrow" />
                  </button>
                </form>
              )}
            </section>

            <section class="admin-card card" aria-labelledby="a-address">
              <h2 class="admin-h2" id="a-address">Adresse du siège</h2>
              <p class="admin-text">
                Affichée dans le pied de page, la page Contact, la carte, les offres d'emploi et les mentions légales.
              </p>
              <form class="form admin-form" method="post">
                <input type="hidden" name="action" value="address" />
                <div class="field field--full">
                  <label for="street">Rue</label>
                  <input class="input" id="street" name="street" value={settings.street} required maxlength="120" autocomplete="street-address" />
                </div>
                <div class="field">
                  <label for="postalCode">Code postal</label>
                  <input class="input" id="postalCode" name="postalCode" value={settings.postalCode} required inputmode="numeric" pattern="\d{5}" maxlength="5" autocomplete="postal-code" />
                </div>
                <div class="field">
                  <label for="city">Ville</label>
                  <input class="input" id="city" name="city" value={settings.city} required maxlength="120" autocomplete="address-level2" />
                </div>
                <div class="form-footer">
                  <p class="form-note">La carte est recalculée automatiquement à partir de l'adresse.</p>
                  <button class="btn btn-primary" type="submit">Enregistrer l'adresse</button>
                </div>
              </form>
            </section>

            <section class="admin-card card" aria-labelledby="a-closures">
              <h2 class="admin-h2" id="a-closures">Fermetures exceptionnelles</h2>
              <p class="admin-text">
                Ponts, vacances, inventaire… Ces jours-là, la page Contact affiche « Fermé » avec le motif, annonce les
                prochaines fermetures et indique quand le studio rouvre.
              </p>
              {closures.length > 0 && (
                <ul class="admin-jobs">
                  {closures.map((c) => (
                    <li class="admin-job">
                      <div class="admin-job-main">
                        <p class="admin-job-title">{c.reason || 'Fermeture exceptionnelle'}</p>
                        <p class="admin-job-meta">{range(c)}</p>
                      </div>
                      <div class="admin-job-actions">
                        <form method="post" data-confirm={`Supprimer la fermeture « ${c.reason || range(c)} » ?`}>
                          <input type="hidden" name="action" value="closure-delete" />
                          <input type="hidden" name="start" value={c.start} />
                          <input type="hidden" name="end" value={c.end} />
                          <button class="admin-link admin-link--danger" type="submit">
                            Supprimer
                          </button>
                        </form>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
              <form class="form admin-form" method="post">
                <input type="hidden" name="action" value="closure-add" />
                <div class="field">
                  <label for="closure-start">Du</label>
                  <input class="input" id="closure-start" name="start" type="date" min={today} required />
                </div>
                <div class="field">
                  <label for="closure-end">Au (inclus)</label>
                  <input class="input" id="closure-end" name="end" type="date" min={today} />
                </div>
                <div class="field field--full">
                  <label for="closure-reason">Motif</label>
                  <input class="input" id="closure-reason" name="reason" maxlength="60" placeholder="Vacances d'été, pont de l'Ascension…" />
                </div>
                <div class="form-footer">
                  <p class="form-note">Laissez « Au » vide pour une seule journée.</p>
                  <button class="btn btn-primary" type="submit">Ajouter la fermeture</button>
                </div>
              </form>

              <div class="admin-sub">
                <div class="admin-card-head">
                  <h3 class="admin-h3">Jours fériés</h3>
                  <p class:list={['admin-state', settings.holidays ? 'admin-state--open' : 'admin-state--locked']}>
                    {settings.holidays ? 'Fermé automatiquement' : 'Traités comme des jours normaux'}
                  </p>
                </div>
                <p class="admin-text">
                  Les 11 jours fériés nationaux sont calculés automatiquement chaque année (lundi de Pâques, Ascension et
                  lundi de Pentecôte compris).
                </p>
                <form method="post">
                  <input type="hidden" name="action" value={settings.holidays ? 'holidays-off' : 'holidays-on'} />
                  <button class="btn btn-ghost btn-sm" type="submit">
                    {settings.holidays ? 'Ouvrir les jours fériés' : 'Fermer les jours fériés'}
                  </button>
                </form>
                {settings.holidays && holidays.length > 0 && (
                  <ul class="admin-holidays">
                    {holidays.map((h) => (
                      <li>
                        <span>
                          <strong>{formatDay(h.start, short)}</strong> · {h.reason}
                        </span>
                        {h.bridge && (
                          <form method="post">
                            <input type="hidden" name="action" value="closure-add" />
                            <input type="hidden" name="start" value={h.bridge} />
                            <input type="hidden" name="reason" value={`Pont (${h.reason})`} />
                            <button class="admin-link" type="submit">
                              Faire le pont le {formatDay(h.bridge, { weekday: 'long', day: 'numeric', month: 'short' })}
                            </button>
                          </form>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </section>

            <section class="admin-card card" aria-labelledby="a-jobs">
              <div class="admin-card-head">
                <h2 class="admin-h2" id="a-jobs">Offres d'emploi</h2>
                <a class="btn btn-primary btn-sm" href={`${ADMIN_PATH}/offres/nouvelle`}>
                  Nouvelle offre <Icon name="arrow" class="btn-arrow" />
                </a>
              </div>
              {openings.length === 0 ? (
                <p class="admin-text">
                  Aucune offre publiée : l'onglet Carrières ne propose que la candidature spontanée, et la mention « On
                  recrute » est masquée.
                </p>
              ) : (
                <ul class="admin-jobs">
                  {openings.map((o) => (
                    <li class="admin-job">
                      <div class="admin-job-main">
                        <p class="admin-job-title">{o.title}</p>
                        <p class="admin-job-meta">
                          {o.contracts.join(' ou ')} · publiée le {formatDate(o.published)}
                        </p>
                      </div>
                      <div class="admin-job-actions">
                        <a class="admin-link" href={`/carrieres/${o.slug}`} target="_blank" rel="noopener">
                          Voir
                        </a>
                        <a class="admin-link" href={`${ADMIN_PATH}/offres/${o.slug}`}>
                          Modifier
                        </a>
                        <form method="post" data-confirm={`Supprimer l'offre « ${o.title} » ?`}>
                          <input type="hidden" name="action" value="delete" />
                          <input type="hidden" name="slug" value={o.slug} />
                          <button class="admin-link admin-link--danger" type="submit">
                            Supprimer
                          </button>
                        </form>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </div>
        </div>
      </>
    )
  }
</BaseLayout>

<script>
  // Confirmation avant une suppression
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm)) event.preventDefault();
    });
  });
</script>
