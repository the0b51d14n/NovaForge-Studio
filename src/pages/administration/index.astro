---
// Portail de l'équipe : admins, admins+ et dirigeants (comptes de src/lib/accounts.ts). Chaque section n'est
// affichée, et chaque action acceptée, que pour les rôles autorisés (voir `can` dans src/lib/accounts.ts) :
// - dirigeants : état du site, adresse du siège, fermetures, offres d'emploi, comptes de l'équipe ;
// - tous : liste des devis et personne qui s'en occupe (les dirigeants n'en voient que le résumé et le prix final) ;
// - admins+ : attribution des devis à un admin+ et suppression ; seul l'admin+ attribué fixe les prix
//   (/administration/devis/<id>).
// Sans compte de l'équipe : page de connexion, ou création du premier dirigeant avec SITE_PASSWORD.
// Chaque action est un formulaire POST traité ici, suivi d'une redirection (pas de double envoi en rechargeant).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/Icon.astro';
import AdminBar from '../../components/AdminBar.astro';
import { ADMIN_PATH, LOGIN_PATH, checkSitePassword, isConfigured, logIn, logOut, stopPreview } from '../../lib/access';
import {
  MIN_PASSWORD,
  ROLE_LABELS,
  STAFF_ROLES,
  can,
  changeEmail,
  checkUserPassword,
  createTestAccounts,
  createUser,
  deleteTestAccounts,
  hasStaff,
  isRole,
  listUsers,
  updateUser,
  type PublicUser,
} from '../../lib/accounts';
import { isEmail } from '../../lib/forms';
import { geocode, isPersistent, saveOpenings, saveSettings } from '../../lib/store';
import { assignQuote, deleteQuote, listQuotes, loadQuote, quoteStatus, type Quote, type QuoteStatus } from '../../lib/quotes';
import { formatEuros, formatRange } from '../../lib/pricing';
import { site } from '../../data/site';
import { LOCK_REASONS, isLockReason } from '../../data/lock-reasons';
import {
  ISO_DATE,
  TIME,
  addDays,
  buildCalendar,
  dayOn,
  formatDay,
  formatTime,
  frenchHolidays,
  parisNow,
  toMinutes,
  weekday,
  type Closure,
} from '../../lib/hours';

const { isAdmin, user, settings, openings } = Astro.locals;
let error = '';

// Premier lancement : aucun compte de l'équipe, le premier dirigeant se crée avec SITE_PASSWORD
let bootstrap = false;
if (!isAdmin) {
  try {
    bootstrap = !(await hasStaff());
  } catch (e) {
    console.error(e);
  }
  // Ni compte de l'équipe ni premier lancement : connexion (un client connecté voit un message d'accès réservé)
  if (!bootstrap && !user) return Astro.redirect(`${LOGIN_PATH}?suite=${ADMIN_PATH}`);
}

const text = (data: FormData, name: string, max = 120) => String(data.get(name) ?? '').trim().slice(0, max);
// Après une action sur les fermetures : retour sur le bon onglet, la page défile jusqu'à la carte
const done = (ok: string, tab?: 'temporaires' | 'feries') =>
  Astro.redirect(`${ADMIN_PATH}?ok=${ok}${tab ? `&onglet=${tab}#fermetures` : ''}`, 303);
const doneAt = (ok: string, anchor: string) => Astro.redirect(`${ADMIN_PATH}?ok=${ok}#${anchor}`, 303);
// Identifiant d'une fermeture (dates et heures) pour la supprimer
const closureKey = (c: Closure) => [c.start, c.end, c.from ?? '', c.to ?? ''].join('|');
// Saisie conservée si l'ajout d'une fermeture échoue
let draft: { start: string; end: string; from: string; to: string; reason: string } | null = null;
// Saisies conservées si la création d'un compte échoue
const bootDraft = { name: '', email: '' };
const accountDraft = { name: '', email: '', role: 'admin' };
const today = parisNow().date;
// Une fermeture passée reste jusqu'à la fin de sa semaine, puis le middleware la supprime de la base
const { closures } = settings;

// Actions réservées : refusées côté serveur même si le formulaire est envoyé à la main
const DIRIGEANT_ACTIONS = new Set([
  'lock-reason', 'lock', 'unlock', 'address', 'holidays-on', 'holidays-off', 'closure-add', 'closure-delete',
  'delete', 'account-create', 'account-update', 'test-create', 'test-delete',
]);
// Identifiants des comptes de test, affichés une seule fois juste après leur création (jamais dans l'adresse)
let testCredentials: { role: PublicUser['role']; email: string; password: string }[] = [];
const ADMIN_PLUS_ACTIONS = new Set(['quote-delete', 'quote-assign']);

const validPassword = (password: string, confirm: string) =>
  password.length < MIN_PASSWORD
    ? `Le mot de passe doit faire au moins ${MIN_PASSWORD} caractères.`
    : password !== confirm
      ? 'Les deux mots de passe ne correspondent pas.'
      : '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = String(data.get('action') ?? '');

  if (!isAdmin) {
    if (action === 'logout') {
      await logOut(Astro.cookies);
      return Astro.redirect(LOGIN_PATH, 303);
    }
    if (bootstrap && action === 'bootstrap') {
      bootDraft.name = text(data, 'name');
      bootDraft.email = text(data, 'email', 200);
      const password = String(data.get('password') ?? '').slice(0, 200);
      if (!(await checkSitePassword(String(data.get('site-password') ?? '')))) {
        // Petite pause après un échec : ralentit les essais de mots de passe à la chaîne
        await new Promise((resolve) => setTimeout(resolve, 800));
        error = 'Mot de passe du site incorrect.';
      } else if (bootDraft.name.length < 2 || !isEmail(bootDraft.email)) {
        error = 'Indiquez votre nom et une adresse e-mail valide.';
      } else {
        error = validPassword(password, String(data.get('confirm') ?? ''));
      }
      if (!error) {
        try {
          const created = await createUser({ ...bootDraft, role: 'dirigeant', password });
          if (created === 'pris') {
            error = 'Un compte existe déjà avec cette adresse e-mail.';
          } else {
            await logIn(Astro.cookies, created);
            return Astro.redirect(`${ADMIN_PATH}?ok=bienvenue`, 303);
          }
        } catch (e) {
          console.error(e);
          error = "La création du compte a échoué (base de données injoignable). Réessayez dans un instant.";
        }
      }
      Astro.response.status = 422;
    }
  } else {
    try {
      if (action === 'logout') {
        await logOut(Astro.cookies);
        return Astro.redirect(LOGIN_PATH, 303);
      }
      if ((DIRIGEANT_ACTIONS.has(action) && !can.manageSite(user)) || (ADMIN_PLUS_ACTIONS.has(action) && !can.assignQuotes(user))) {
        error = 'Votre rôle ne permet pas cette action.';
        Astro.response.status = 403;
      } else {
        if (action === 'lock-reason') {
          const reason = data.get('reason');
          if (isLockReason(reason)) await saveSettings({ ...settings, lockReason: reason });
          return done('motif');
        }
        if (action === 'lock' || action === 'unlock') {
          const reason = data.get('reason');
          await saveSettings({
            ...settings,
            locked: action === 'lock',
            lockReason: action === 'lock' && isLockReason(reason) ? reason : settings.lockReason,
          });
          // Verrouiller ferme aussi le site pour l'équipe : l'aperçu se réactive depuis /verrouillage
          stopPreview(Astro.cookies);
          return done(action);
        }
        if (action === 'address') {
          const street = text(data, 'street');
          const postalCode = text(data, 'postalCode', 5);
          const city = text(data, 'city');
          if (!street || !city || !/^\d{5}$/.test(postalCode)) {
            error = 'Adresse incomplète : rue, code postal à 5 chiffres et ville sont obligatoires.';
          } else {
            const geo = await geocode(street, postalCode, city);
            await saveSettings({ ...settings, street, postalCode, city, geo: geo ?? settings.geo });
            return done(geo ? 'adresse' : 'adresse-sans-carte');
          }
        }
        if (action === 'holidays-on' || action === 'holidays-off') {
          await saveSettings({ ...settings, closures, holidays: action === 'holidays-on' });
          return done(action, 'feries');
        }
        if (action === 'closure-add') {
          const start = text(data, 'start', 10);
          const end = text(data, 'end', 10) || start;
          const from = text(data, 'from', 5);
          const to = text(data, 'to', 5);
          const reason = text(data, 'reason', 60);
          draft = { start, end: text(data, 'end', 10), from, to, reason };
          if (!ISO_DATE.test(start) || !ISO_DATE.test(end) || end < start) {
            error = 'Dates invalides : la date de fin ne peut pas précéder la date de début.';
          } else if (end < today) {
            error = 'Cette période est déjà passée.';
          } else if (end > addDays(start, 366)) {
            error = 'Une fermeture ne peut pas dépasser un an.';
          } else if ((from || to) && !(TIME.test(from) && TIME.test(to) && from < to)) {
            error = 'Plage horaire invalide : indiquez une heure de début et une heure de fin (après le début), ou laissez les deux vides pour la journée entière.';
          } else {
            const closure: Closure = { start, end, reason, ...(from && to ? { from, to } : {}) };
            const next = [...closures, closure].sort((a, b) => a.start.localeCompare(b.start));
            await saveSettings({ ...settings, closures: next });
            return done('fermeture', text(data, 'onglet', 12) === 'feries' ? 'feries' : 'temporaires');
          }
        }
        if (action === 'closure-delete') {
          const key = text(data, 'key', 40);
          await saveSettings({ ...settings, closures: closures.filter((c) => closureKey(c) !== key) });
          return done('fermeture-supprimee', 'temporaires');
        }
        if (action === 'delete') {
          const slug = text(data, 'slug');
          await saveOpenings(openings.filter((o) => o.slug !== slug));
          return done('supprimee');
        }
        if (action === 'quote-delete') {
          await deleteQuote(text(data, 'id', 32));
          return doneAt('devis-supprime', 'devis');
        }
        if (action === 'quote-assign') {
          const quote = await loadQuote(text(data, 'id', 32));
          const assigneeId = text(data, 'assignee', 32);
          const assignee = assigneeId
            ? (await listUsers()).find((u) => u.id === assigneeId && u.role === 'admin_plus' && !u.disabled)
            : null;
          if (!quote) error = 'Ce devis n’existe plus.';
          else if (quote.signature) error = 'Ce devis est déjà signé : son attribution ne change plus.';
          else if (assigneeId && !assignee) error = 'Un devis ne peut être attribué qu’à un admin+ actif.';
          else {
            await assignQuote(quote, assignee ? { id: assignee.id, name: assignee.name } : null, user!.name);
            return doneAt(assignee ? 'attribue' : 'desattribue', 'devis');
          }
        }
        if (action === 'account-create') {
          accountDraft.name = text(data, 'name');
          accountDraft.email = text(data, 'email', 200);
          accountDraft.role = text(data, 'role', 20);
          const password = String(data.get('password') ?? '').slice(0, 200);
          if (accountDraft.name.length < 2 || !isEmail(accountDraft.email)) error = 'Indiquez un nom et une adresse e-mail valide.';
          else if (!isRole(accountDraft.role) || !STAFF_ROLES.includes(accountDraft.role)) error = 'Choisissez un rôle.';
          else error = validPassword(password, password);
          if (!error) {
            const created = await createUser({
              name: accountDraft.name,
              email: accountDraft.email,
              role: accountDraft.role as PublicUser['role'],
              password,
            });
            if (created === 'pris') error = 'Un compte existe déjà avec cette adresse e-mail.';
            else return doneAt('compte-cree', 'comptes');
          }
        }
        if (action === 'account-update') {
          const users = await listUsers();
          const target = users.find((u) => u.id === text(data, 'id', 32));
          const op = text(data, 'op', 20);
          const role = text(data, 'role', 20);
          // Il reste toujours au moins un dirigeant actif, et l'on ne retire pas ses propres droits
          const otherDirigeants = users.filter((u) => u.role === 'dirigeant' && !u.disabled && u.id !== target?.id);
          const losesDirigeant = target?.role === 'dirigeant' && (op === 'disable' || (op === 'role' && role !== 'dirigeant'));
          if (!target) error = 'Ce compte n’existe plus.';
          else if (target.id === user!.id && (op === 'disable' || op === 'role')) error = 'Vous ne pouvez pas modifier votre propre rôle ni désactiver votre compte.';
          else if (losesDirigeant && otherDirigeants.length === 0) error = 'Il doit rester au moins un dirigeant actif.';
          else if (op === 'role') {
            if (!isRole(role)) error = 'Rôle inconnu.';
            else {
              await updateUser(target.id, { role });
              return doneAt('role-modifie', 'comptes');
            }
          } else if (op === 'disable' || op === 'enable') {
            await updateUser(target.id, { disabled: op === 'disable' });
            return doneAt(op === 'disable' ? 'compte-desactive' : 'compte-active', 'comptes');
          } else if (op === 'password') {
            const password = String(data.get('password') ?? '').slice(0, 200);
            error = validPassword(password, password);
            if (!error) {
              await updateUser(target.id, { password });
              return doneAt('mot-de-passe-reinitialise', 'comptes');
            }
          } else if (op === 'email') {
            const email = text(data, 'email', 200);
            if (!isEmail(email)) error = 'Adresse e-mail invalide.';
            else if ((await changeEmail(target.id, email)) === 'pris') error = 'Un autre compte utilise déjà cette adresse e-mail.';
            else return doneAt('e-mail-modifie', 'comptes');
          }
        }
        if (action === 'test-create') {
          testCredentials = await createTestAccounts();
        }
        if (action === 'test-delete') {
          await deleteTestAccounts();
          return doneAt('tests-supprimes', 'comptes');
        }
        if (action === 'email-change') {
          const email = text(data, 'email', 200);
          if (!(await checkUserPassword(user!.id, String(data.get('current') ?? '').slice(0, 200)))) {
            error = 'Mot de passe actuel incorrect.';
          } else if (!isEmail(email)) {
            error = 'Adresse e-mail invalide.';
          } else if ((await changeEmail(user!.id, email)) === 'pris') {
            error = 'Un autre compte utilise déjà cette adresse e-mail.';
          } else {
            return doneAt('mon-e-mail', 'mon-compte');
          }
        }
        if (action === 'password-change') {
          const current = String(data.get('current') ?? '').slice(0, 200);
          const password = String(data.get('password') ?? '').slice(0, 200);
          if (!(await checkUserPassword(user!.id, current))) error = 'Mot de passe actuel incorrect.';
          else error = validPassword(password, String(data.get('confirm') ?? ''));
          if (!error) {
            await updateUser(user!.id, { password });
            return doneAt('mot-de-passe', 'mon-compte');
          }
        }
        if (error) Astro.response.status = 422;
      }
    } catch (e) {
      console.error(e);
      error = "L'enregistrement a échoué (base de données injoignable). Réessayez dans un instant.";
      Astro.response.status = 500;
    }
  }
}

const lockReason = LOCK_REASONS[settings.lockReason] ?? LOCK_REASONS.fermeture;
// Titre cité entre guillemets dans les messages, sans son point final
const lockTitle = lockReason.title.replace(/\.$/, '');
const flashes: Record<string, string> = {
  lock: `Site verrouillé (${lockReason.label.toLowerCase()}) : les visiteurs voient maintenant « ${lockTitle} ».`,
  motif: `Motif changé : les visiteurs voient maintenant « ${lockTitle} ».`,
  unlock: 'Site ouvert : tout le monde peut maintenant le consulter.',
  adresse: 'Adresse du siège enregistrée, carte mise à jour.',
  'adresse-sans-carte': "Adresse enregistrée, mais introuvable sur la carte : l'ancien emplacement de la carte est conservé.",
  supprimee: 'Offre supprimée.',
  creee: 'Offre publiée.',
  fermeture: 'Fermeture ajoutée : elle apparaît sur la page Contact.',
  'fermeture-supprimee': 'Fermeture supprimée.',
  'holidays-on': 'Les jours fériés sont maintenant indiqués comme fermés.',
  'holidays-off': 'Les jours fériés ne sont plus indiqués comme fermés.',
  modifiee: 'Offre mise à jour.',
  'devis-supprime': 'Devis supprimé.',
  attribue: 'Devis attribué.',
  desattribue: 'Attribution retirée.',
  bienvenue: 'Compte dirigeant créé : vous pouvez maintenant créer les comptes de l’équipe.',
  'compte-cree': 'Compte créé : transmettez son mot de passe provisoire à la personne concernée.',
  'role-modifie': 'Rôle modifié.',
  'compte-desactive': 'Compte désactivé : il ne peut plus se connecter.',
  'compte-active': 'Compte réactivé.',
  'mot-de-passe-reinitialise': 'Mot de passe réinitialisé : transmettez-le à la personne concernée.',
  'mot-de-passe': 'Votre mot de passe a été changé.',
  'e-mail-modifie': 'Adresse e-mail modifiée : elle sert maintenant à se connecter.',
  'mon-e-mail': 'Votre adresse e-mail a été changée : utilisez-la pour vous connecter.',
  'tests-supprimes': 'Comptes de test supprimés.',
};
const flash = flashes[Astro.url.searchParams.get('ok') ?? ''];

// Derniers devis du simulateur (les devis non signés sont supprimés automatiquement après quelques semaines),
// et comptes : liste complète pour les dirigeants, admins+ actifs pour l'attribution des devis
let quotes: Quote[] = [];
let team: PublicUser[] = [];
let quotesError = false;
if (isAdmin) {
  try {
    [quotes, team] = await Promise.all([listQuotes(), listUsers()]);
  } catch (e) {
    console.error(e);
    quotesError = true;
  }
}
// Comptes de test : hors des listes de l'équipe ; un admin+ de test se voit seulement lui-même dans l'attribution
const assignable = team.filter((u) => u.role === 'admin_plus' && !u.disabled && (!u.test || u.id === user?.id));
const staffAccounts = team.filter((u) => STAFF_ROLES.includes(u.role) && !u.test);
const testAccounts = team.filter((u) => u.test);
const isDirigeant = can.manageSite(user);
const isAdminPlus = can.assignQuotes(user);
const QUOTE_STATES: Record<QuoteStatus, [label: string, tone: 'open' | 'locked']> = {
  estimation: ['Estimation', 'locked'],
  rappel: ['À rappeler', 'locked'],
  ferme: ['Devis ferme, à signer', 'open'],
  expire: ['Expiré', 'locked'],
  signe: ['Signé', 'open'],
};
// Montant affiché dans la liste : devis ferme s'il existe, sinon fourchette de l'estimation
const quoteAmount = (q: Quote) =>
  q.final
    ? `${formatEuros(q.final.totals.oneOff.ttc)}${q.final.totals.monthly.ttc > 0 ? ` + ${formatEuros(q.final.totals.monthly.ttc)} / mois` : ''}`
    : `${formatRange([q.totals.oneOff.min.ttc, q.totals.oneOff.max.ttc])}${q.totals.monthly.max.ttc > 0 ? ` + ${formatRange([q.totals.monthly.min.ttc, q.totals.monthly.max.ttc])} / mois` : ''}`;

// Dates de l'administration : jour et mois seulement (« 11 nov. »)
const cal = buildCalendar(site.schedule, { ...settings, closures });
const short = { day: 'numeric', month: 'short' } as const;
const range = (c: Closure) =>
  (c.start === c.end ? formatDay(c.start, short) : `Du ${formatDay(c.start, short)} au ${formatDay(c.end, short)}`) +
  (c.from && c.to ? ` · de ${formatTime(toMinutes(c.from))} à ${formatTime(toMinutes(c.to))}` : ' · journée entière');

// Onglet affiché : fermetures temporaires par défaut, jours fériés après une action qui les concerne
const activeTab = Astro.url.searchParams.get('onglet') === 'feries' ? 'feries' : 'temporaires';

// Tous les jours fériés des 12 prochains mois. Un férié qui tombe un jour où le studio est de toute façon
// fermé (week-end) reste affiché normalement ; sinon il ferme le studio, avec le pont éventuel :
// férié un mardi → lundi, férié un jeudi → vendredi (s'il est ouvert et pas déjà fermé)
const bridgeOffset: Record<number, number> = { 1: -1, 3: 1 };
const until = addDays(today, 365);
const thisYear = Number(today.slice(0, 4));
const holidays = [thisYear, thisYear + 1]
  .flatMap((year) => [...frenchHolidays(year)])
  .filter(([iso]) => iso >= today && iso < until)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([iso, name]) => {
    const usuallyOpen = Boolean(cal.slots[weekday(iso)]);
    const offset = usuallyOpen ? bridgeOffset[weekday(iso)] : undefined;
    const bridge = offset ? addDays(iso, offset) : null;
    return {
      date: iso,
      name,
      usuallyOpen,
      bridge: bridge && cal.slots[weekday(bridge)] && !dayOn(bridge, cal).reason ? bridge : null,
    };
  });

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
