---
// Tarifs du simulateur de devis : régime de TVA et prix HT de chaque élément du catalogue (src/data/quote-catalog.ts).
// Un prix vide masque l'élément aux visiteurs. Les devis déjà créés gardent leurs prix.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import AdminBar from '../../components/AdminBar.astro';
import { UNIT_LABELS, catalog, type CatalogItem } from '../../data/quote-catalog';
import { ADMIN_PATH } from '../../lib/access';
import { defaultPricing, isVatRegime, parseEuros, type Pricing } from '../../lib/pricing';
import { isPersistent, loadPricing, savePricing } from '../../lib/store';

if (!Astro.locals.isAdmin) return Astro.redirect(ADMIN_PATH);

let pricing: Pricing = defaultPricing();
let loadError = '';
try {
  pricing = await loadPricing();
} catch (e) {
  console.error(e);
  loadError = 'Les tarifs enregistrés sont momentanément illisibles (base de données injoignable).';
}

// 123450 → « 1234,50 », 120000 → « 1200 »
const toInput = (cents: number | undefined) =>
  cents === undefined ? '' : (cents % 100 ? (cents / 100).toFixed(2) : String(cents / 100)).replace('.', ',');
const values: Record<string, string> = Object.fromEntries(
  catalog.flatMap((g) => g.items).map((item) => [item.id, toInput(pricing.prices[item.id])]),
);
let vat = pricing.vat;
const invalid: string[] = [];
let saveError = '';

if (Astro.request.method === 'POST' && !loadError) {
  const data = await Astro.request.formData();
  const regime = data.get('vat');
  if (isVatRegime(regime)) vat = regime;
  const prices: Record<string, number> = {};
  for (const item of catalog.flatMap((g) => g.items)) {
    const raw = String(data.get(`price:${item.id}`) ?? '').trim().slice(0, 20);
    values[item.id] = raw;
    if (!raw) continue;
    const cents = parseEuros(raw);
    if (cents === null) invalid.push(item.id);
    else prices[item.id] = cents;
  }
  if (invalid.length === 0) {
    try {
      await savePricing({ vat, prices });
      return Astro.redirect(`${ADMIN_PATH}/tarifs?ok=tarifs`, 303);
    } catch (e) {
      console.error(e);
      saveError = "L'enregistrement a échoué (base de données injoignable). Réessayez dans un instant.";
      Astro.response.status = 500;
    }
  } else {
    Astro.response.status = 422;
  }
}

const priced = Object.values(values).filter(Boolean).length;
const total = catalog.reduce((n, g) => n + g.items.length, 0);
const KINDS: Record<CatalogItem['kind'], string> = { base: 'Formule', option: 'Option', quantity: 'Quantité' };
const unitOf = (item: CatalogItem) =>
  `€ HT${item.kind === 'quantity' ? ` / ${UNIT_LABELS[item.unit][0]}` : ''}${item.monthly ? ' / mois' : ''}`;
---

<BaseLayout title="Tarifs du simulateur" description="Administration des tarifs du simulateur de devis." bare noindex>
  <AdminBar />
  <div class="admin surface-light-2">
    <div class="container admin-inner">
      <a class="admin-back" href={ADMIN_PATH}><Icon name="arrow" /> Tableau de bord</a>
      <h1 class="admin-title">Tarifs du simulateur</h1>
      <p class="admin-text">
        Prix hors taxes, en euros. Un élément sans prix n'apparaît pas dans le
        {' '}<a href="/devis" target="_blank" rel="noopener">simulateur</a>, et un service sans aucun prix est masqué. Les
        devis déjà créés gardent leurs prix : seuls les nouveaux devis utilisent ces tarifs. {priced} élément{priced > 1 ? 's' : ''}
        {' '}sur {total} {priced > 1 ? 'ont' : 'a'} un prix.
      </p>

      {!isPersistent() && (
        <p class="admin-alert">Base de données non configurée : les tarifs sont perdus au redémarrage du serveur.</p>
      )}
      {Astro.url.searchParams.get('ok') === 'tarifs' && (
        <p class="admin-flash" role="status">
          <Icon name="check" /> Tarifs enregistrés : le simulateur est à jour.
        </p>
      )}
      {loadError && <p class="admin-alert" role="alert">{loadError}</p>}
      {saveError && <p class="admin-alert" role="alert">{saveError}</p>}
      {invalid.length > 0 && (
        <p class="admin-alert" role="alert">
          Certains prix sont invalides (en rouge) : indiquez un montant en euros, par exemple 1200 ou 49,90. Rien n'a été
          enregistré.
        </p>
      )}

      <form class="admin-pricing" method="post" novalidate>
        <section class="admin-card card" aria-labelledby="p-vat">
          <h2 class="admin-h2" id="p-vat">TVA</h2>
          <p class="admin-text">
            En franchise en base, aucune TVA n'est facturée et les devis portent la mention « TVA non applicable, art.
            293 B du CGI ». Sinon, la TVA à 20 % s'ajoute aux prix HT.
          </p>
          <div class="choices">
            <label class="choice">
              <input type="radio" name="vat" value="franchise" checked={vat === 'franchise'} />
              <span>Franchise en base (pas de TVA)</span>
            </label>
            <label class="choice">
              <input type="radio" name="vat" value="normal" checked={vat === 'normal'} />
              <span>TVA à 20 %</span>
            </label>
          </div>
        </section>

        {catalog.map((group) => (
          <section class="admin-card card" aria-labelledby={`p-${group.id}`}>
            <h2 class="admin-h2" id={`p-${group.id}`}>{group.title}</h2>
            <ul class="admin-prices">
              {group.items.map((item) => (
                <li class="admin-price">
                  <label class="admin-price-text" for={`price-${item.id}`}>
                    <span class="admin-job-title">{item.label}</span>
                    <span class="admin-job-meta">
                      {KINDS[item.kind]}
                      {item.detail && ` · ${item.detail}`}
                    </span>
                  </label>
                  <span class="admin-price-input">
                    <input
                      class="input"
                      id={`price-${item.id}`}
                      name={`price:${item.id}`}
                      value={values[item.id]}
                      inputmode="decimal"
                      maxlength="20"
                      placeholder="—"
                      aria-invalid={invalid.includes(item.id) ? 'true' : undefined}
                    />
                    <span class="admin-price-unit">{unitOf(item)}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <div class="admin-pricing-save">
          <a class="admin-link" href={ADMIN_PATH}>Annuler</a>
          <button class="btn btn-primary" type="submit" disabled={Boolean(loadError)}>
            Enregistrer les tarifs <Icon name="arrow" class="btn-arrow" />
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>
