---
// Page Contact en écran partagé (ordinateur) : à gauche le contenu défile, à droite le formulaire reste fixe.
// Sur tablette et mobile, tout s'empile : en-tête, formulaire, puis coordonnées et carte.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import OfficeMap from '../components/OfficeMap.astro';
import OpeningHours from '../components/OpeningHours.astro';
import { services } from '../data/content';
import { getSite } from '../lib/store';

const site = getSite(Astro.locals);
const { openings } = Astro.locals;
---

<BaseLayout
  title="Contact"
  description="Un projet de site, de boutique en ligne ou d'identité visuelle ? Contactez NovaForge Studio, dans la métropole lilloise : premier rendez-vous et devis gratuits."
>
  <div class="contact-split">
    <div class="contact-hero">
      <PageHero
        eyebrow="Contact"
        compact
        lead="Parlez-nous de votre activité et de vos envies : nous revenons vers vous pour fixer un premier rendez-vous. Le devis est gratuit et sans engagement."
      >
        <Fragment slot="title">Un projet ? <em>Parlons-en.</em></Fragment>
      </PageHero>
    </div>

    <section class="contact-panel surface-dark" aria-labelledby="contact-form-title">
      <div class="contact-panel-inner">
        <p class="eyebrow">Écrivez-nous</p>
        <h2 class="contact-panel-title" id="contact-form-title">Parlez-nous de <em>votre projet.</em></h2>

        <form
          class="form"
          action="/api/contact"
          method="post"
          data-form
          data-email={site.email}
          novalidate
          data-success="Merci ! Votre message a bien été envoyé : nous revenons vers vous rapidement, en général sous 48 h ouvrées."
        >
          <div class="hp" aria-hidden="true">
            <label>Ne pas remplir <input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="field" data-field>
            <label for="c-name">Nom <span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="c-name" name="nom" type="text" autocomplete="name" required aria-describedby="c-name-err" />
            <span class="field-error" id="c-name-err"></span>
          </div>
          <div class="field" data-field>
            <label for="c-email">E-mail <span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="c-email" name="email" type="email" autocomplete="email" required aria-describedby="c-email-err" />
            <span class="field-error" id="c-email-err"></span>
          </div>
          <div class="field" data-field>
            <label for="c-company">Entreprise</label>
            <input class="input" id="c-company" name="entreprise" type="text" autocomplete="organization" />
          </div>
          <div class="field" data-field>
            <label for="c-phone">Téléphone</label>
            <input class="input" id="c-phone" name="telephone" type="tel" autocomplete="tel" />
          </div>
          <div class="field" data-field>
            <label for="c-type">Type de projet</label>
            <select class="input" id="c-type" name="type">
              {services.map((s) => <option>{s.title}</option>)}
              <option>Autre</option>
            </select>
          </div>
          <div class="field" data-field>
            <label for="c-budget">Budget estimé</label>
            <select class="input" id="c-budget" name="budget">
              <option>Je ne sais pas encore</option>
              <option>Moins de 2 000 €</option>
              <option>2 000 € – 5 000 €</option>
              <option>5 000 € – 10 000 €</option>
              <option>Plus de 10 000 €</option>
            </select>
          </div>
          <div class="field field--full" data-field>
            <label for="c-message">Votre projet <span class="req" aria-hidden="true">*</span></label>
            <textarea
              class="input"
              id="c-message"
              name="message"
              rows="4"
              required
              aria-describedby="c-message-err"
              placeholder="Votre activité, vos objectifs, vos délais…"></textarea>
            <span class="field-error" id="c-message-err"></span>
          </div>
          <p class="form-privacy field--full">
            Vos informations servent uniquement à répondre à votre demande et, si vous le souhaitez, à préparer un
            devis. Elles nous sont transmises par e-mail et ne sont pas enregistrées sur le site. Durée de conservation
            et exercice de vos droits : <a href="/confidentialite">politique de confidentialité</a>.
          </p>
          <div class="form-footer">
            <p class="form-note"><span aria-hidden="true">*</span> Champs obligatoires</p>
            <button class="btn btn-primary" type="submit">Envoyer le message <Icon name="arrow" class="btn-arrow" /></button>
          </div>
          <p class="form-status" role="status" data-form-status></p>
        </form>
      </div>
    </section>

    <section class="contact-details surface-light" aria-label="Coordonnées et plan d'accès">
      <div class="contact-details-inner">
        <div>
          <dl class="info-list">
            <div><dt>Adresse</dt><dd><a href={site.directions} target="_blank" rel="noopener" data-directions-link>{site.address[0]}<br />{site.address[1]}</a></dd></div>
            <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            {site.phone && <div><dt>Téléphone</dt><dd><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></dd></div>}
            <div class="info-hours"><dt>Horaires</dt><dd><OpeningHours /></dd></div>
            <div><dt>Réponse</dt><dd>En général sous 48 h ouvrées</dd></div>
          </dl>

          {
            openings.length > 0 && (
              <div class="side-card card">
                <h3>Vous souhaitez nous rejoindre ?</h3>
                <p>
                  {openings.length === 1
                    ? `Nous recrutons : ${openings[0].title}, en ${openings[0].contracts.join(' ou ')}.`
                    : `${openings.length} postes sont ouverts au studio.`}
                </p>
                <a class="link-arrow" href={openings.length === 1 ? `/carrieres/${openings[0].slug}` : '/carrieres#offres'}>
                  {openings.length === 1 ? "Voir l'offre" : 'Voir les offres'} <Icon name="arrow" />
                </a>
              </div>
            )
          }
        </div>

        <OfficeMap compact />
      </div>
    </section>
  </div>
</BaseLayout>
